{
  "name": "@churchwebsite",
  "private": "true",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "blueprint:configure:churchmain": "node --env-file-if-exists=.env.development scripts/run-with-development-env.mjs bash scripts/configure-churchmain-development-hook.sh",
    "blueprint:configure:churchmain:windows": "node --env-file-if-exists=.env.development scripts/run-with-development-env.mjs powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-churchmain-development-hook.ps1",
    "blueprint:configure:womanexcel": "node --env-file-if-exists=.env.development scripts/run-with-development-env.mjs bash scripts/configure-womanexcel-development-hook.sh",
    "blueprint:configure:womanexcel:windows": "node --env-file-if-exists=.env.development scripts/run-with-development-env.mjs powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-womanexcel-development-hook.ps1",
    "blueprint:logs:development": "node --env-file-if-exists=.env.development scripts/run-with-development-env.mjs bash scripts/watch-development-deploys.sh",
    "blueprint:logs:development:windows": "node --env-file-if-exists=.env.development scripts/run-with-development-env.mjs powershell -NoProfile -ExecutionPolicy Bypass -File scripts/watch-development-deploys.ps1",
    "blueprint:watch:development:windows": "node --env-file-if-exists=.env.development scripts/run-with-development-env.mjs powershell -NoProfile -ExecutionPolicy Bypass -File scripts/watch-development-deploys.ps1",
    "blueprint:plan": "node --env-file-if-exists=.env.development ./node_modules/sanity/bin/sanity blueprints plan",
    "dev:studio": "pnpm --filter @churchwebsite/studio dev",
    "d/s": "pnpm --filter @churchwebsite/studio dev",
    "build:studio": "pnpm --filter @churchwebsite/studio build",
    "b/s": "pnpm --filter @churchwebsite/studio build",
    "deploy:studio": "pnpm --filter @churchwebsite/studio run deploy",
    "dp/s": "pnpm --filter @churchwebsite/studio run deploy",
    "schema:extract": "pnpm --filter @churchwebsite/studio schema:extract",
    "s/e": "pnpm --filter @churchwebsite/studio schema:extract",
    "typegen": "pnpm --filter @churchwebsite/studio typegen",
    "t/g": "pnpm --filter @churchwebsite/studio typegen",
    "typegen:check": "pnpm typegen && git diff --exit-code -- apps/churchmain/src/sanity.types.ts apps/womanexcel/src/sanity.types.ts",
    "t/c": "pnpm typegen && git diff --exit-code -- apps/churchmain/src/sanity.types.ts apps/womanexcel/src/sanity.types.ts",
    "dev:churchmain": "pnpm --filter @churchwebsite/churchmain dev",
    "d/c": "pnpm --filter @churchwebsite/churchmain dev",
    "dev:womanexcel": "pnpm --filter @churchwebsite/womanexcel dev",
    "d/w": "pnpm --filter @churchwebsite/womanexcel dev",
    "build:churchmain": "pnpm --filter @churchwebsite/churchmain build",
    "b/c": "pnpm --filter @churchwebsite/churchmain build",
    "build:womanexcel": "pnpm --filter @churchwebsite/womanexcel build",
    "b/w": "pnpm --filter @churchwebsite/womanexcel build",
    "verify:routes": "node scripts/verify-static-routes.mjs",
    "test": "pnpm --filter @churchwebsite/newsletters test",
    "build": "pnpm -r build",
    "b": "pnpm -r build"
  },
  "devDependencies": {
    "@sanity/blueprints": "0.23.6",
    "sanity": "^6.9.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}

PUBLIC_SANITY_PROJECT_ID=your-project-id
# Use development locally; reserve production for deployed production builds.
PUBLIC_SANITY_DATASET=your-dataset-name
# When true, Sanity is authoritative and missing/failed reads stop the build.
# Set false only for the documented Markdown rollback procedure.
PUBLIC_SANITY_NEWSLETTERS_ENABLED=false
# Required for the private production dataset. Keep server-only; never rename with PUBLIC_.
SANITY_API_READ_TOKEN=

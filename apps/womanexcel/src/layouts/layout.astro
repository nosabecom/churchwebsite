---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { SiteNav, DesignMotion } from "@churchwebsite/ui";
import ConferenceMark from "../assets/logo.png";
interface Props {
  title: string;
  description?: string;
  variant?: "fellowship" | "conference";
  bodyClass?: string;
}
const {
  title,
  description = "A community of women growing in faith, finding purpose, and doing life together. Discover Cornerstone Excellent Women and the Woman Excel Conference.",
  variant = "fellowship",
  bodyClass,
} = Astro.props;
const links = [
  { label: "Our story", href: "/#about" },
  { label: "The conference", href: "/conference" },
  { label: "The journal", href: "/newsletters" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="generator" content={Astro.generator} />
    <title>
      {title} | {
        variant === "conference" ? "Woman Excel Conference" : "Cornerstone Excellent Women"
      }
    </title>
    <meta name="description" content={description} /><link
      rel="icon"
      href={ConferenceMark.src}
      type="image/png"
    />
  </head>
  <body
    class:list={[
      "women-site",
      { "interior-page": Astro.url.pathname !== "/", "conference-page": variant === "conference" },
      bodyClass,
    ]}
  >
    <a class="skip-link" href="#main-content">Skip to content</a><Analytics />
    <SiteNav
      name="excellent women"
      subtitle="Cornerstone · Faith & Sisterhood"
      links={links}
      action={{ label: "Find your people", href: "/contact" }}
    />
    <main id="main-content"><slot /></main>
    <footer class="w-footer">
      <div class="w-footer-top">
        <p class="eyebrow">There is room for you here.</p><a href="/contact"
          >Come as you are.<br /><em>Grow with us.</em><span aria-hidden="true"
            ><svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></span
          ></a>
      </div>
      <div class="w-footer-grid">
        <div>
          <a class="w-footer-brand" href="/">excellent women<span>Cornerstone</span></a><p>
            Inspire. Empower. Excel.<br />A ministry of RCCG Cornerstone Assembly.
          </p>
        </div><nav aria-label="Footer">
          <a href="/#about">Our story</a><a href="/conference">Woman Excel Conference</a><a
            href="/newsletters">The journal</a
          ><a href="/contact">Get in touch</a>
        </nav><div>
          <p>Saskatoon, Saskatchewan</p><a href="mailto:connect@rccgcornerstoneassembly.com"
            >Say hello <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a
          ><a href="https://www.instagram.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer"
            >Instagram <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a>
        </div>
      </div>
      <div class="w-footer-bottom">
        <span>© {new Date().getFullYear()} Cornerstone Excellent Women</span><span
          >Rooted in faith. Connected in love.</span
        ><a href="#main-content">Back to top ↑</a>
      </div>
    </footer><DesignMotion />
  </body>
</html>

---
import Layout from "../../layouts/layout.astro";
---

<Layout title="Conference">
    <section class="mx-auto flex max-w-4xl flex-col items-center gap-5 px-4 pt-6 pb-12 text-center md:pb-16">
        <h1 class="text-4xl text-balance text-navy md:text-6xl">The Woman Excel Conference</h1>

        <p class="text-lg text-pretty text-navy/85 md:text-2xl">
            Once a year Cornerstone Excellent Women opens its doors wider. Women from every walk of life
            gather to worship, to sit under powerful teaching, and to be reminded Whose they are — and every
            year has its own theme, its own speakers, and its own story.
        </p>

        <p class="text-lg text-pretty text-navy/70 md:text-xl">
            Explore the conference below to find out more.
        </p>
    </section>

    <section class="mx-auto w-full max-w-4xl px-4 pb-20 md:px-8" aria-label="Conferences">
        <article class="flex flex-col gap-4 rounded-2xl bg-berry p-6 text-white md:p-8">
            <h2 class="text-5xl leading-none md:text-6xl">2026</h2>
            <div class="h-px bg-white/25"></div>
            <p class="text-2xl md:text-3xl">The Word</p>
            <p class="text-pretty text-white/85">
                Anchored in John 1:1. A full programme of Spirit-led worship and teaching on building a life
                on something unshakeable.
            </p>
            <a
                class="inline-block self-start rounded-full bg-pink px-6 py-2.5 font-sans text-sm text-white transition-colors hover:bg-pink/80 md:text-base"
                href="/conference/2026"
            >View the 2026 Conference</a>
        </article>
    </section>
</Layout>

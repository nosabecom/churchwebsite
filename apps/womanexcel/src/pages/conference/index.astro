---
import Layout from "../../layouts/layout.astro";
---

<Layout title="Our gatherings" variant="conference">
  <section class="gathering-intro">
    <p class="eyebrow">THE WOMAN EXCEL CONFERENCE</p><h1>
      We gather.<br /><em>Something grows.</em>
    </h1><p>
      Every year, a new chapter. The same beautiful invitation to grow in faith, find your people,
      and step into all God has called you to be.
    </p>
  </section>
  <section class="gathering-archive" aria-label="Conference archive">
    <a class="gathering-card" href="/conference/2026" data-reveal
      ><div class="gathering-img">
        <img
          src="/images/conference/2026/day-one-08.jpg"
          alt="The Woman Excel 2026 panel sharing on stage"
          width="1600"
          height="1067"
        /><span>2026</span>
      </div><div class="gathering-info">
        <div>
          <p class="eyebrow">MAY 9–10, 2026 · JOHN 1:1</p><h2>The Word</h2><p>
            Rooted in the Word. Renewed in community.
          </p>
        </div><span aria-hidden="true"
          ><svg
            class="arrow-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></span>
      </div></a
    >
    <a class="gathering-card" href="/conference/2025" data-reveal
      ><div class="gathering-img">
        <img
          src="/images/conference/2025/gallery-24.jpg"
          alt="Women gathered on stage at Woman Excel 2025"
          width="1600"
          height="1067"
          loading="lazy"
        /><span>2025</span>
      </div><div class="gathering-info">
        <div>
          <p class="eyebrow">MAY 17–18, 2025 · 2 CORINTHIANS 8:7</p><h2>Excel</h2><p>
            An invitation to excel in every area of life.
          </p>
        </div><span aria-hidden="true"
          ><svg
            class="arrow-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
          ></span>
      </div></a
    >
  </section>
  <section class="gathering-next">
    <p class="eyebrow">THE NEXT CHAPTER / 2027</p><h2>
      Good things<br /><em>are taking root.</em>
    </h2><p>
      Our next gathering is in the making. Dates, theme, and speakers are still to be announced.
    </p><a class="w-button" href="/contact"
      >Ask us about the next gathering <span aria-hidden="true"
        ><svg
          class="arrow-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
        ></span
      ></a>
  </section>
</Layout>
<style>
  .gathering-intro {
    padding: 80px var(--gutter) 65px;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 25px 8vw;
    align-items: end;
  }
  .gathering-intro > .eyebrow {
    grid-column: 1/-1;
  }
  .gathering-intro h1 {
    margin: 0;
  }
  .gathering-intro h1 em,
  .gathering-next em {
    font-style: normal;
    color: var(--accent);
  }
  .gathering-intro > p:last-child {
    font-size: 14px;
    line-height: 1.9;
    max-width: 380px;
  }
  .gathering-archive {
    padding: 0 var(--gutter) 85px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
  }
  .gathering-card {
    text-decoration: none;
  }
  .gathering-card:nth-child(2) {
    margin-top: 100px;
  }
  .gathering-img {
    position: relative;
    overflow: hidden;
  }
  .gathering-img img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .gathering-card:hover img {
    transform: scale(1.03);
  }
  .gathering-img > span {
    position: absolute;
    left: 25px;
    bottom: 15px;
    font: 400 85px var(--display);
    color: white;
    text-shadow: 0 1px 12px #0008;
  }
  .gathering-info {
    padding-top: 25px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .gathering-info h2 {
    font-size: 53px;
    margin: 12px 0;
  }
  .gathering-info p:not(.eyebrow) {
    font-size: 12px;
  }
  .gathering-info > span {
    font-size: 35px;
  }
  .gathering-next {
    text-align: center;
    background: var(--butter);
    padding: 75px var(--gutter);
  }
  .gathering-next h2 {
    font-size: 70px;
    margin: 25px 0;
  }
  .gathering-next > p:not(.eyebrow) {
    font-size: 13px;
    max-width: 400px;
    margin: 0 auto;
    line-height: 1.8;
  }
  .gathering-next .w-button {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 700px) {
    .gathering-intro {
      grid-template-columns: 1fr;
      gap: 22px;
      padding-top: 50px;
    }
    .gathering-intro > p:last-child {
      font-size: 13px;
    }
    .gathering-archive {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .gathering-card:nth-child(2) {
      margin-top: 0;
    }
    .gathering-img img {
      height: 300px;
    }
    .gathering-next h2 {
      font-size: 52px;
    }
  }
</style>

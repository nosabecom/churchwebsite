---
import Layout from "../../layouts/layout.astro";
import { getWomanExcelNewsletters, isExternalNewsletterLink } from "../../lib/newsletters";

const newsletters = await getWomanExcelNewsletters();
const [latest, ...archive] = newsletters;
const formatMonth = (date: Date) => new Intl.DateTimeFormat("en-CA", { month: "long", year: "numeric", timeZone: "UTC" }).format(date);
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-CA", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(date);
---

<Layout title="Newsletters" bodyClass="cew-newsletter-shell">
    {latest ? (
        <div class="cew-newsletters">
            <header class="cew-newsletters__masthead">
                <p>Cornerstone Excellent Women presents</p>
                <span>The Excellent Edit</span>
                <p>Stories · Faith · Community</p>
            </header>

            <section class="cew-newsletters__latest" aria-labelledby="latest-newsletter-heading">
                <div class="cew-newsletters__cover">
                    <div class="cew-newsletters__cover-fallback"><span>{formatMonth(latest.publishedAt)}</span></div>
                    {latest.coverImage && (
                        <img src={latest.coverImage.url} alt={latest.coverImage.alt} width={latest.coverImage.width} height={latest.coverImage.height} fetchpriority="high" data-image-with-fallback />
                    )}
                    <span>{latest.issue ? `Issue ${String(latest.issue).padStart(2, "0")}` : "Latest edition"}</span>
                </div>

                <div class="cew-newsletters__latest-copy">
                    <p class="cew-kicker">Our latest newsletter</p>
                    <h1 id="latest-newsletter-heading">{latest.title}</h1>
                    <time datetime={latest.publishedAt.toISOString()}>{formatDate(latest.publishedAt)}</time>
                    <p>{latest.excerpt}</p>
                    <div>
                        <a class="cew-button" href={`/newsletters/${latest.slug}/`}>Read this edition</a>
                        {latest.relatedLink && (
                            <a class="cew-text-link" href={latest.relatedLink.href} target={isExternalNewsletterLink(latest.relatedLink.href) ? "_blank" : undefined} rel={isExternalNewsletterLink(latest.relatedLink.href) ? "noopener noreferrer" : undefined}>
                                {latest.relatedLink.label ?? "Related link"} <span aria-hidden="true">↗</span>
                                {isExternalNewsletterLink(latest.relatedLink.href) && <span class="sr-only"> (opens in a new tab)</span>}
                            </a>
                        )}
                    </div>
                    {archive.length > 0 && <a class="cew-newsletters__jump" href="#past-editions">Browse the archive <span aria-hidden="true">↓</span></a>}
                </div>
            </section>

            {archive.length > 0 && (
                <section id="past-editions" class="cew-newsletters__archive" aria-labelledby="past-editions-heading">
                    <header>
                        <div class="cew-section-label"><span class="cew-section-label__line"></span><span>Past editions</span></div>
                        <h2 id="past-editions-heading">The archive,<br /><em>worth returning to.</em></h2>
                        <p>Previous updates, reflections, and stories from Cornerstone Excellent Women.</p>
                    </header>

                    <ol>
                        {archive.map((entry, index) => (
                            <li>
                                <a href={`/newsletters/${entry.slug}/`}>
                                    <article>
                                        <div class="cew-newsletters__archive-cover">
                                            <div aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div>
                                            {entry.coverImage && <img src={entry.coverImage.url} alt={entry.coverImage.alt} width={entry.coverImage.width} height={entry.coverImage.height} loading="lazy" data-image-with-fallback />}
                                            <span>{entry.issue ? `Issue ${String(entry.issue).padStart(2, "0")}` : "Newsletter"}</span>
                                        </div>
                                        <div class="cew-newsletters__archive-copy">
                                            <time datetime={entry.publishedAt.toISOString()}>{formatMonth(entry.publishedAt)}</time>
                                            <h3>{entry.title}</h3>
                                            <p>{entry.excerpt}</p>
                                            <span>Read edition →</span>
                                        </div>
                                    </article>
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            )}
        </div>
    ) : (
        <section class="cew-newsletters-empty" aria-labelledby="newsletter-empty-heading">
            <p class="cew-kicker">The Excellent Edit</p>
            <h1 id="newsletter-empty-heading">The next edition<br /><em>is on its way.</em></h1>
            <p>Check back soon for a new newsletter from Cornerstone Excellent Women.</p>
        </section>
    )}
</Layout>

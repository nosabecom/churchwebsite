---
import Layout from "../../layouts/layout.astro";
import NewsletterBody from "../../components/newsletters/NewsletterBody.astro";
import {
    getWomanExcelNewsletters,
    isExternalNewsletterLink,
    type Newsletter,
} from "../../lib/newsletters";

export async function getStaticPaths() {
    const newsletters = await getWomanExcelNewsletters();

    return newsletters.map((newsletter) => ({
        params: { slug: newsletter.slug },
        props: { newsletter },
    }));
}

interface Props {
    newsletter: Newsletter;
}

const { newsletter } = Astro.props as Props;
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-CA", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
}).format(date);
const isExternal = newsletter.relatedLink
    ? isExternalNewsletterLink(newsletter.relatedLink.href)
    : false;
---

<Layout title={newsletter.seo?.title ?? newsletter.title} description={newsletter.seo?.description ?? newsletter.excerpt}>
    <article>
        <header class="bg-cream-soft border-b border-sand">
            <div class="mx-auto grid w-full max-w-6xl lg:grid-cols-[1fr_0.8fr] items-center gap-10 px-4 md:px-8 py-12 md:py-20">
                <div class="order-2 lg:order-1">
                    <a class="font-sans text-xs uppercase tracking-[0.16em] text-orchid-deep hover:text-orchid" href="/newsletters">← All newsletters</a>
                    <p class="mt-8 cew-eyebrow">
                        {newsletter.issue ? `Issue ${String(newsletter.issue).padStart(2, "0")}` : "Newsletter"}
                    </p>
                    <h1 class="mt-3 text-5xl md:text-7xl leading-none text-charcoal text-balance">{newsletter.title}</h1>
                    <time class="mt-5 block font-sans text-xs uppercase tracking-[0.16em] text-charcoal/80" datetime={newsletter.publishedAt.toISOString()}>
                        {formatDate(newsletter.publishedAt)}
                    </time>
                    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-charcoal/80">{newsletter.excerpt}</p>
                </div>

                <div class:list={[
                    "relative order-1 overflow-hidden rounded-2xl bg-orchid-deep lg:order-2",
                    newsletter.coverImage ? "self-center" : "aspect-[4/3] lg:aspect-[3/4]",
                ]}>
                    <div class:list={[
                        "grid place-items-center overflow-hidden p-8 text-center text-white",
                        newsletter.coverImage ? "absolute inset-0" : "relative h-full",
                    ]}>
                        <div class="absolute -right-20 top-12 h-64 w-64 rounded-full border-[2.5rem] border-white/15"></div>
                        <p class="relative text-5xl md:text-6xl leading-none">{newsletter.title}</p>
                    </div>
                    {newsletter.coverImage && (
                        <img src={newsletter.coverImage.url} alt={newsletter.coverImage.alt} width={newsletter.coverImage.width} height={newsletter.coverImage.height} data-image-with-fallback class="relative z-10 mx-auto block h-auto max-w-full" />
                    )}
                </div>
            </div>
        </header>

        <div class="mx-auto w-full max-w-3xl px-4 md:px-8 py-14 md:py-20">
            <div class="newsletter-prose">
                <NewsletterBody newsletter={newsletter} />
            </div>

            {newsletter.relatedLink && (
                <p class="mt-12 pt-8 border-t border-sand">
                    <a
                        class="cew-btn-outline"
                        href={newsletter.relatedLink.href}
                        target={isExternal ? "_blank" : undefined}
                        rel={isExternal ? "noopener noreferrer" : undefined}
                    >{newsletter.relatedLink.label ?? "Related link"}{isExternal && <span class="sr-only"> (opens in a new tab)</span>}</a>
                </p>
            )}
        </div>
    </article>
</Layout>

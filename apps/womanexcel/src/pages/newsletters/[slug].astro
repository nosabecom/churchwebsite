---
import Layout from "../../layouts/layout.astro";
import NewsletterBody from "../../components/newsletters/NewsletterBody.astro";
import { getWomanExcelNewsletters, isExternalNewsletterLink, type Newsletter } from "../../lib/newsletters";

export async function getStaticPaths() {
    const newsletters = await getWomanExcelNewsletters();
    return newsletters.map((newsletter) => ({ params: { slug: newsletter.slug }, props: { newsletter } }));
}

interface Props { newsletter: Newsletter; }
const { newsletter } = Astro.props as Props;
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-CA", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(date);
const isExternal = newsletter.relatedLink ? isExternalNewsletterLink(newsletter.relatedLink.href) : false;
---

<Layout title={newsletter.seo?.title ?? newsletter.title} description={newsletter.seo?.description ?? newsletter.excerpt} bodyClass="cew-newsletter-shell">
    <article class="cew-newsletter-article">
        <header class="cew-newsletter-article__hero">
            <div class="cew-newsletter-article__copy">
                <a href="/newsletters">← The Excellent Edit</a>
                <p class="cew-kicker">{newsletter.issue ? `Issue ${String(newsletter.issue).padStart(2, "0")}` : "Newsletter"}</p>
                <h1>{newsletter.title}</h1>
                <time datetime={newsletter.publishedAt.toISOString()}>{formatDate(newsletter.publishedAt)}</time>
                <p>{newsletter.excerpt}</p>
            </div>

            <div class="cew-newsletter-article__cover">
                <div><span>{newsletter.title}</span></div>
                {newsletter.coverImage && <img src={newsletter.coverImage.url} alt={newsletter.coverImage.alt} width={newsletter.coverImage.width} height={newsletter.coverImage.height} data-image-with-fallback />}
            </div>
        </header>

        <div class="cew-newsletter-article__body">
            <div class="newsletter-prose"><NewsletterBody newsletter={newsletter} /></div>
            {newsletter.relatedLink && (
                <aside class="cew-newsletter-article__related">
                    <p>Continue exploring</p>
                    <a href={newsletter.relatedLink.href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>
                        {newsletter.relatedLink.label ?? "Related link"} <span aria-hidden="true">↗</span>
                        {isExternal && <span class="sr-only"> (opens in a new tab)</span>}
                    </a>
                </aside>
            )}
            <a class="cew-newsletter-article__back" href="/newsletters">← Return to all editions</a>
        </div>
    </article>
</Layout>

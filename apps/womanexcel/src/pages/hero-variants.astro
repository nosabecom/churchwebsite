---
// Review-only route for comparing hero treatments side by side.
// Delete this page (and the unused variants) once a direction is picked.
import Layout from "../layouts/layout.astro";
import Centered from "../components/home/hero-variants/centered.astro";
import Split from "../components/home/hero-variants/split.astro";
import Overlay from "../components/home/hero-variants/overlay.astro";
import Editorial from "../components/home/hero-variants/editorial.astro";

const variants = [
    { id: "a", label: "Variant A — Centered Classic", note: "Symmetrical, mirrors the brand mark. This is what is on the homepage today." },
    { id: "b", label: "Variant B — Split Portrait", note: "Type flush left against a tall image, verse on an overlapping card." },
    { id: "c", label: "Variant C — Full-bleed Overlay", note: "Photography carries the section, type sits on a scrim. Boldest of the four." },
    { id: "d", label: "Variant D — Editorial Offset", note: "Oversized headline, vertical verse rail, images bleeding off the right edge." },
];
---

<Layout title="Hero variants">
    <div class="mx-auto w-full max-w-6xl px-4 md:px-8 pt-10">
        <p class="cew-eyebrow">Internal review</p>
        <h1 class="cew-heading mt-2">Homepage hero — four directions</h1>
        <p class="cew-prose mt-3 max-w-2xl text-pretty">
            Same content in all four, so the difference you are judging is layout and tone rather than copy.
            Everything below the hero is unchanged on the real homepage.
        </p>
        <ul class="flex flex-wrap gap-3 mt-5">
            {variants.map((v) => (
                <li><a class="cew-btn-outline" href={`#${v.id}`}>{v.label.split("—")[0].trim()}</a></li>
            ))}
        </ul>
    </div>

    {variants.map((v, i) => (
        <>
            <div id={v.id} class="scroll-mt-4 mx-auto w-full max-w-6xl px-4 md:px-8 mt-16 md:mt-24">
                <div class="border-t border-sand pt-6">
                    <p class="font-sans text-sm tracking-[0.25em] uppercase text-orchid-deep">{`0${i + 1}`}</p>
                    <h2 class="text-2xl md:text-3xl text-charcoal mt-1">{v.label}</h2>
                    <p class="text-charcoal/75 mt-1 text-pretty">{v.note}</p>
                </div>
            </div>

            {v.id === "a" && <Centered />}
            {v.id === "b" && <Split />}
            {v.id === "c" && <Overlay />}
            {v.id === "d" && <Editorial />}
        </>
    ))}
</Layout>

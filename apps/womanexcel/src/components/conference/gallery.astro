---
export interface GalleryItem {
    src: string;
    alt: string;
    caption?: string;
    href?: string;
}

interface Props {
    year: string | number;
    heading?: string;
    items: GalleryItem[];
    sectionId?: string;
}

const { year, heading = "Gallery & Media", items, sectionId = `conference-${year}-gallery` } = Astro.props as Props;
---

{items.length > 0 && (
    <section class="conference-gallery" aria-labelledby={sectionId}>
        <div class="conference-gallery__heading">
            <div class="conference-slate"><span></span><b>Gallery</b><p>{year}</p></div>
            <h2 id={sectionId}>{heading}</h2>
            <p>Faces, faith, and the moments we carried home.</p>
        </div>

        <ul class="conference-gallery__grid">
            {items.map((item, index) => (
                <li>
                    {item.href ? (
                        <a href={item.href}>
                            <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                            <span class="conference-gallery__index">{String(index + 1).padStart(2, "0")}</span>
                            {item.caption && <p>{item.caption}</p>}
                        </a>
                    ) : (
                        <figure>
                            <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                            <span class="conference-gallery__index">{String(index + 1).padStart(2, "0")}</span>
                            {item.caption && <figcaption>{item.caption}</figcaption>}
                        </figure>
                    )}
                </li>
            ))}
        </ul>
    </section>
)}

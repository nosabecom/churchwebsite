---
export interface ScheduleItem {
    day: string;
    time?: string;
    title: string;
    description?: string;
}

interface Props {
    year: string | number;
    items: ScheduleItem[];
}

const { year, items } = Astro.props as Props;
---

{items.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 py-16 md:px-8 md:py-24" aria-labelledby={`conference-${year}-schedule`}>
        <div class="mb-8 flex items-center justify-center gap-3">
            <div class="h-px flex-1 bg-navy/25"></div>
            <h2 id={`conference-${year}-schedule`} class="rounded-full bg-navy px-5 py-2 text-3xl text-white md:text-4xl">
                Schedule
            </h2>
            <div class="h-px flex-1 bg-navy/25"></div>
        </div>

        <ol class="grid gap-5 md:grid-cols-2">
            {items.map((item) => (
                <li class:list={["flex flex-col gap-2 rounded-2xl bg-berry p-6 text-white md:p-8", items.length === 1 && "md:col-span-2"]}>
                    <div class="flex flex-wrap items-baseline justify-between gap-2 font-sans">
                        <p class="text-sm font-semibold uppercase tracking-[0.2em]">{item.day}</p>
                        {item.time && <p class="text-sm text-white/80">{item.time}</p>}
                    </div>
                    <h3 class="text-2xl md:text-3xl">{item.title}</h3>
                    {item.description && <p class="text-white/85">{item.description}</p>}
                </li>
            ))}
        </ol>
    </section>
)}

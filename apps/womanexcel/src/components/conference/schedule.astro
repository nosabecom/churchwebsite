---
export interface ScheduleItem { day: string; time?: string; title: string; description?: string; }
interface Props { year: string | number; items: ScheduleItem[]; }
const { year, items } = Astro.props as Props;
---

{items.length > 0 && (
    <section class="conference-schedule" aria-labelledby={`conference-${year}-schedule`}>
        <div class="conference-section-heading conference-section-heading--compact">
            <div class="conference-slate"><span></span><b>Programme</b><p>{year}</p></div>
            <h2 id={`conference-${year}-schedule`}>The<br /><em>schedule.</em></h2>
        </div>

        <ol class="conference-schedule__list">
            {items.map((item, index) => (
                <li>
                    <span class="conference-schedule__number">{String(index + 1).padStart(2, "0")}</span>
                    <div class="conference-schedule__when"><p>{item.day}</p>{item.time && <time>{item.time}</time>}</div>
                    <div class="conference-schedule__what"><h3>{item.title}</h3>{item.description && <p>{item.description}</p>}</div>
                </li>
            ))}
        </ol>
    </section>
)}

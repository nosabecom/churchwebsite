---
interface LinkDetails { href: string; label: string; }
interface MediaItem { src: string; alt: string; caption?: string; href?: string; }
interface Props {
    year: string | number;
    heading?: string;
    paragraphs: string[];
    media?: MediaItem[];
    cta?: LinkDetails;
}
const { year, heading = `${year} Recap`, paragraphs, media = [], cta } = Astro.props as Props;
---

<section class="conference-recap" aria-labelledby={`conference-${year}-recap`}>
    <span class="conference-recap__year" aria-hidden="true">{year}</span>
    <div class="conference-recap__inner">
        <div class="conference-recap__copy">
            <p class="conference-kicker">Looking back · {year}</p>
            <h2 id={`conference-${year}-recap`}>{heading}</h2>
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {cta && <a class="conference-button conference-button--light" href={cta.href}>{cta.label}</a>}
        </div>

        {media.length > 0 && (
            <ul class="conference-recap__media">
                {media.map((item, index) => (
                    <li>
                        {item.href ? (
                            <a href={item.href}><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /></a>
                        ) : (
                            <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                        )}
                        <div><span>{String(index + 1).padStart(2, "0")}</span>{item.caption && <p>{item.caption}</p>}</div>
                    </li>
                ))}
            </ul>
        )}
    </div>
</section>

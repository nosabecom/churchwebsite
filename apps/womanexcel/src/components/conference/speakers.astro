---
export interface Speaker {
    name: string;
    role?: string;
    image: { src: string; alt: string; crop?: { position: string; size?: string; }; };
}
interface Props { speakers: Speaker[]; }
const { speakers } = Astro.props as Props;
---

{speakers.length > 0 && (
    <section class="conference-speakers" aria-labelledby="conference-speakers-heading">
        <div class="conference-speakers__heading">
            <div class="conference-slate"><span></span><b>Voices</b><p>Guests</p></div>
            <h2 id="conference-speakers-heading">Speakers &amp;<br /><em>guests.</em></h2>
            <p>Women and men bringing wisdom, worship, testimony, and Spirit-led teaching.</p>
        </div>

        <div class="conference-speakers__rail">
            <div class="conference-speakers__track" data-speaker-track>
                {[...speakers, ...speakers].map((speaker, index) => (
                    <article aria-hidden={index >= speakers.length ? "true" : undefined}>
                        {speaker.image.crop ? (
                            <div class="conference-speakers__image" style={`background-image:url("${speaker.image.src}");background-position:${speaker.image.crop.position};background-size:${speaker.image.crop.size ?? "cover"};`} role={index < speakers.length ? "img" : undefined} aria-label={index < speakers.length ? speaker.image.alt : undefined}></div>
                        ) : (
                            <img class="conference-speakers__image" src={speaker.image.src} alt={index < speakers.length ? speaker.image.alt : ""} loading="lazy" />
                        )}
                        <div class="conference-speakers__name"><span>{String((index % speakers.length) + 1).padStart(2, "0")}</span><h3>{speaker.name}</h3>{speaker.role && <p>{speaker.role}</p>}</div>
                    </article>
                ))}
            </div>
        </div>
        <p class="conference-speakers__hint">Hover to pause · tap to pause</p>
    </section>
)}

<script>
    document.querySelectorAll<HTMLElement>("[data-speaker-track]").forEach((track) => {
        track.addEventListener("pointerdown", (event) => {
            if (event.pointerType !== "mouse") track.toggleAttribute("data-paused");
        });
    });
</script>

---
export interface LinkDetails { href: string; label: string; }
interface Props {
    year: string | number;
    heading?: string;
    description?: string;
    registration?: LinkDetails;
    donation?: LinkDetails;
}
const { year, heading = "Join us for the conference", description, registration, donation } = Astro.props as Props;
---

{(registration || donation) && (
    <section class="conference-registration" aria-label={`${year} conference registration`}>
        <p class="conference-kicker">Woman Excel · {year}</p>
        <h2>{heading}</h2>
        {description && <p>{description}</p>}
        <div>
            {registration && <a class="conference-button conference-button--light" href={registration.href}>{registration.label}</a>}
            {donation && <a class="conference-line-link" href={donation.href}>{donation.label} <span aria-hidden="true">→</span></a>}
        </div>
    </section>
)}

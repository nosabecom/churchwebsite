<section class="conference-archive-hero" aria-labelledby="conference-archive-heading">
    <img src="/images/conference/2026/day-two-01.jpg" alt="Women leading worship at the Woman Excel International Conference" fetchpriority="high" />
    <div class="conference-archive-hero__scrim" aria-hidden="true"></div>
    <div class="conference-archive-hero__content">
        <p class="conference-kicker">Woman Excel International Conference · Saskatoon</p>
        <h1 id="conference-archive-heading">Every year,<br /><em>a new encounter.</em></h1>
        <p>
            Women from every walk of life gather to worship, sit under powerful teaching,
            and remember Whose they are. Every year carries its own theme and story.
        </p>
        <a class="conference-line-link" href="#conference-years">Explore the gatherings <span aria-hidden="true">↓</span></a>
        <HostLink />
    </div>
</section>

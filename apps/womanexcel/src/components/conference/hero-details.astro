---
export interface Props {
    quote?: { text: string; citation: string; };
    date: string;
    address: string;
}
const { quote, date, address } = Astro.props;
---

<div class="conference-hero-details">
    {quote && <blockquote><p>“{quote.text}”</p><cite>{quote.citation}</cite></blockquote>}
    <div class="conference-hero-details__meta"><p>{date}</p><span aria-hidden="true"></span><p>{address}</p></div>
</div>

---
const conferences = [
    {
        year: "2027", status: "Upcoming", theme: "To be revealed",
        blurb: "Dates, theme and speakers are still to be announced. Get in touch to be told first.",
        href: "/contact", cta: "Keep me informed", image: null,
    },
    {
        year: "2026", status: "Latest", theme: "The Word",
        blurb: "Anchored in John 1:1. Spirit-led worship and teaching on building a life on something unshakeable.",
        href: "/conference/2026", cta: "Relive 2026", image: "/images/conference/2026/day-two-08.jpg",
    },
    {
        year: "2025", status: "Archive", theme: "Excel",
        blurb: "A two-day gathering of worship, prayer, practical teaching, brunch and connection, grounded in 2 Corinthians 8:7.",
        href: "/conference/2025", cta: "Relive 2025", image: "/images/conference/2025/gallery-24.jpg",
    },
];
---

<section id="conference-years" class="conference-years" aria-labelledby="conference-years-heading">
    <div class="conference-section-heading">
        <div class="conference-slate"><span></span><b>01</b><p>Conference archive</p></div>
        <h2 id="conference-years-heading">Choose a<br /><em>chapter.</em></h2>
        <p>Step inside the themes, speakers, worship, and shared moments that shaped each gathering.</p>
    </div>

    <ol class="conference-year-list">
        {conferences.map((conference, index) => (
            <li class:list={["conference-year-card", !conference.image && "conference-year-card--upcoming"]}>
                {conference.image && <img src={conference.image} alt="" loading={index === 0 ? "eager" : "lazy"} />}
                <div class="conference-year-card__scrim" aria-hidden="true"></div>
                <div class="conference-year-card__top">
                    <span>{conference.status}</span>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                </div>
                <div class="conference-year-card__body">
                    <p>{conference.year}</p>
                    <h3>{conference.theme}</h3>
                    <p>{conference.blurb}</p>
                    <a href={conference.href}>{conference.cta} <span aria-hidden="true">→</span></a>
                </div>
            </li>
        ))}
    </ol>
</section>

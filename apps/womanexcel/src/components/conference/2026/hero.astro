---
import { Slideshow } from "@churchwebsite/ui";
import HeroDetails from "../hero-details.astro";
import HeroLabels from "../hero-labels.astro";

const imageRoot = "/images/conference/2026";
const slides = [
    { src: `${imageRoot}/day-two-01.jpg`, alt: "Three women leading worship on stage at Woman Excel 2026" },
    { src: `${imageRoot}/day-one-08.jpg`, alt: "A panel of women seated on stage at Woman Excel 2026" },
    { src: `${imageRoot}/day-two-08.jpg`, alt: "Two attendees embracing during a prayerful moment" },
    { src: `${imageRoot}/day-one-05.jpg`, alt: "Attendees gathered around decorated tables on day one" },
];
---

<Slideshow slides={slides} interval={6500} label="Woman Excel 2026 highlights" class="conference-cinema-hero woman-excel-slideshow">
    <div class="conference-cinema-hero__scrim" aria-hidden="true"></div>
    <div class="conference-cinema-hero__content">
        <HeroLabels year="2026" />
        <img class="conference-cinema-hero__art" src="/images/the-word.svg" alt="The Word" />
        <HeroDetails
            quote={{ text: "In the beginning was the Word, and the Word was with God, and the Word was God", citation: "John 1:1" }}
            date="May 9–10, 2026"
            address="RCCG Cornerstone Assembly · 70-3904 Millar Avenue"
        />
    </div>
    <a class="conference-cinema-hero__scroll" href="#conference-2026-story" aria-label="Read about the conference"><span></span></a>
</Slideshow>

<section class="conference-mailing" aria-labelledby="conference-mailing-heading">
    <img src="/images/banner.jpeg" alt="" loading="lazy" />
    <div class="conference-mailing__scrim" aria-hidden="true"></div>
    <div class="conference-mailing__content">
        <p class="conference-kicker">Stay in the story</p>
        <h2 id="conference-mailing-heading">Be first to know<br /><em>what comes next.</em></h2>
        <p>Conference news, registration announcements, and community updates—sent thoughtfully.</p>
        <form method="POST" class="conference-mailing__form">
            <label class="sr-only" for="mailinglist">Email address</label>
            <input autocomplete="email" type="email" placeholder="you@example.com" name="Mailing-List" id="mailinglist" required />
            <button type="submit">Keep me informed <span aria-hidden="true">→</span></button>
        </form>
    </div>
</section>

---
import type { MarkProps } from "astro-portabletext/types";
import { getSafeNewsletterHref, isExternalNewsletterHref } from "@churchwebsite/newsletters";

interface LinkMark { href?: string | null }

const { node } = Astro.props as MarkProps<LinkMark>;
const safeHref = getSafeNewsletterHref(node.markDef.href);
const external = safeHref ? isExternalNewsletterHref(safeHref) : false;
---

{
  safeHref ? (
    <a href={safeHref} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
      <slot />
      {external && <span class="sr-only"> (opens in a new tab)</span>}
    </a>
  ) : (
    <span><slot /></span>
  )
}

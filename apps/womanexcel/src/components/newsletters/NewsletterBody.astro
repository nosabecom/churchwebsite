---
import { PortableText } from "astro-portabletext";

import type { Newsletter } from "../../lib/newsletters";
import PortableImage from "./PortableImage.astro";
import PortableLink from "./PortableLink.astro";

interface Props {
  newsletter: Newsletter;
}

const { newsletter } = Astro.props;
const components = {
  type: { editorialImage: PortableImage },
  mark: { link: PortableLink },
};
---

<PortableText value={newsletter.body} components={components} />

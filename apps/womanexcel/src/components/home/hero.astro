---
import HostLink from "../host-link.astro";
import { Slideshow } from "@churchwebsite/ui";

const slides = [
    {
        src: "/images/conference/2025/gallery-24.jpg",
        alt: "The Woman Excel community smiling together in a conference group photo",
        objectPosition: "center 48%",
    },
    {
        src: "/images/conference/2025/gallery-21.jpg",
        alt: "Women posing together in purple Woman Excel sweatshirts",
        objectPosition: "center 45%",
    },
    {
        src: "/images/conference/2026/day-one-08.jpg",
        alt: "Five women sharing a panel discussion at the Woman Excel International Conference",
        objectPosition: "center 45%",
    },
];
---

<Slideshow
    slides={slides}
    interval={3000}
    pauseControl
    label="Meet the Woman Excel community"
    class="cew-cinematic-hero cew-community-carousel"
>
    <div class="cew-cinematic-hero__wash" aria-hidden="true"></div>

    <div class="cew-cinematic-hero__content">
        <h1 id="home-hero-title">Called to<br /><em>excel.</em></h1>
        <p class="cew-cinematic-hero__lede">
            A community of women growing in the Word, walking in purpose, and making room for one another.
        </p>
        <div class="cew-cinematic-hero__actions">
            <a class="cew-button cew-button--light" href="#about">Discover our community</a>
            <a class="cew-text-link cew-text-link--light" href="/conference">
                Woman Excel International Conference <span aria-hidden="true">→</span>
            </a>
        </div>
        <HostLink />
    </div>

    <a class="cew-scroll-cue" href="#about" aria-label="Scroll to learn more"><span></span></a>
</Slideshow>

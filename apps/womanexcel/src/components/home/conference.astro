---
import { Image } from "astro:assets";
import logo from "../../../public/images/logo-full.png";
import { latestConference } from "./latest-conference";
---

<section id="conference-recap" class="cew-conference-feature cew-conference-feature--recap" aria-labelledby="home-conference-recap-heading">
    <div class="cew-conference-feature__media">
        {latestConference.photos.map((photo, index) => (
            <figure>
                <a href={`${latestConference.href}#conference-${latestConference.year}-day-${index === 1 ? "two" : "one"}-gallery`}>
                    <Image src={photo.src} alt={photo.alt} loading="lazy" decoding="async" format="webp" quality={75} widths={[360, 720, 1200]} sizes={index === 0 ? "(max-width: 1000px) 90vw, 55vw" : "(max-width: 1000px) 45vw, 28vw"} />
                </a>
                <figcaption>{photo.caption}</figcaption>
            </figure>
        ))}
    </div>

    <div class="cew-conference-feature__card">
        <Image src={logo} alt="The Woman Excel International Conference" loading="lazy" decoding="async" format="webp" widths={[240, 480]} sizes="240px" />
        <p class="cew-kicker">{latestConference.year} Conference recap</p>
        <h2 id="home-conference-recap-heading">One room.<br /><em>Many stories.</em></h2>
        <p>{latestConference.summary}</p>
        <a class="cew-button" href={latestConference.href}>Explore the conference</a>
    </div>
</section>

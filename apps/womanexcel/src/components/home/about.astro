---
import { Image } from "astro:assets";
import gathering from "../../../public/images/conference/2026/day-one-03.jpg";
import worship from "../../../public/images/conference/2025/gallery-03.jpg";
import prayer from "../../../public/images/conference/2025/gallery-25.jpg";
---

<section id="about" class="cew-editorial cew-anchor-section">
    <div class="cew-editorial__intro">
        <div class="cew-section-label">
            <span class="cew-section-label__line"></span>
            <span class="cew-section-label__number">01</span>
            <span>Who we are</span>
        </div>
        <h2>A place to become<br /><em>all God imagined.</em></h2>
        <figure class="cew-editorial__image" data-reveal="image">
            <Image
                src={gathering}
                alt="Women gathered around tables at the Woman Excel International Conference"
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={75}
                widths={[480, 960, 1600]}
                sizes="(max-width: 760px) 90vw, 50vw"
            />
            <figcaption>Faith · Fellowship · Together</figcaption>
        </figure>
        <p>
            We exist to create a vibrant community of women who seek to deepen their relationship with God,
            embrace their God-given potential, and transform lives through acts of love, service, and discipleship.
        </p>
    </div>

    <div class="cew-story-grid">
        <figure class="cew-story-grid__main">
            <Image src={worship} alt="Women worshipping together at a Woman Excel gathering" loading="lazy" decoding="async" format="webp" quality={75} widths={[360, 720, 1080]} sizes="(max-width: 900px) 90vw, 60vw" />
            <figcaption>Worship · The Word · Community</figcaption>
        </figure>

        <div class="cew-story-grid__copy">
            <p class="cew-kicker">There is room for you</p>
            <h3>Every season.<br />Every story.</h3>
            <p>
                Whether you are new to the church or have been here for years, married or single, a mother or
                not yet — there is a place for you here. We gather to study the Word, pray for one another,
                and walk through every season together.
            </p>
            <div class="cew-goal-note">
                <span>Our goal</span>
                <p>
                    To equip and encourage our women to fulfil their creation design and embrace the
                    redemptive calling with excellence.
                </p>
            </div>
            <a class="cew-text-link" href="/contact">Connect with us <span aria-hidden="true">→</span></a>
        </div>

        <figure class="cew-story-grid__small">
            <Image src={prayer} alt="Women praying during a Woman Excel gathering" loading="lazy" decoding="async" format="webp" quality={75} widths={[360, 720, 1080]} sizes="(max-width: 900px) 75vw, 35vw" />
        </figure>
    </div>
</section>

---
// Meeting days/times are intentionally not stated here — they still need to be
// confirmed by the fellowship leads before going on the site.
---

<section class="bg-cream-soft border-t border-sand">
    <div class="cew-section flex flex-col items-center text-center gap-6">
        <div class="flex items-center gap-3 md:gap-4">
            <span class="cew-rule"></span>
            <p class="cew-eyebrow">Join Us</p>
            <span class="cew-rule"></span>
        </div>

        <h2 class="cew-heading text-balance max-w-3xl">There is a seat here with your name on it</h2>

        <p class="cew-prose max-w-2xl text-pretty">
            Come and grow with us. Reach out to find out when we next meet, to share a testimony,
            or to ask for prayer — we would love to hear from you.
        </p>

        <div class="flex flex-wrap justify-center gap-3 md:gap-4 pt-2">
            <a class="cew-btn" href="/contact">Get In Touch</a>
            <a class="cew-btn-outline" href="mailto:connect@rccgcornerstoneassembly.com">Email the Church</a>
        </div>
    </div>
</section>

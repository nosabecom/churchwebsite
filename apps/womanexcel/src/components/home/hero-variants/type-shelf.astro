---
// Variant G — Type Shelf. Pushes D further: the headline is the whole top of
// the page on bare cream, then a full-bleed photographic "shelf" runs edge to
// edge beneath it with the verse card breaking across the seam.
import Logo from '../../../assets/excellent-women-logo.jpg';
import { Image } from 'astro:assets';
---

<section class="pt-10 md:pt-16 overflow-hidden">
    <div class="mx-auto w-full max-w-6xl px-4 md:px-8 flex flex-col gap-6">
        <div class="flex items-center gap-4">
            <Image src={Logo} alt="Cornerstone Excellent Women" width="160" height="160" class="w-14 md:w-16 h-auto rounded-full" />
            <span class="cew-rule"></span>
            <p class="cew-eyebrow">Proverbs 31:10</p>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-[5.5rem] text-charcoal leading-[0.95] text-balance max-w-5xl">
            Inspire, empower, and support women to <em class="text-orchid not-italic">excel</em> in God’s purpose.
        </h1>

        <div class="grid md:grid-cols-2 gap-6 md:gap-12 items-end pt-2">
            <p class="cew-prose text-pretty">
                The women’s fellowship of RCCG Cornerstone Assembly — a community of women growing together
                in the Word, in prayer, and in the calling God has placed on their lives.
            </p>
            <div class="flex flex-wrap gap-3 md:gap-4 md:justify-end">
                <a class="cew-btn" href="/#mission">Our Mission</a>
                <a class="cew-btn-outline" href="/conference">Woman Excel Conference</a>
            </div>
        </div>
    </div>

    <div class="relative mt-10 md:mt-16">
        <img src="/images/placeholds/photo-5.jpg" alt="" loading="eager"
            class="w-full h-72 md:h-[30rem] object-cover" />

        <!-- Card straddles the seam between the type and the photograph. -->
        <div class="hidden md:block absolute -top-10 right-[max(2rem,calc((100vw-72rem)/2+2rem))] max-w-xs rounded-2xl bg-orchid text-white p-6 shadow-lg">
            <p class="font-sans text-xs tracking-[0.25em] uppercase text-white/70 mb-2">Proverbs 31:10</p>
            <p class="text-lg leading-snug">Her value is more precious than jewels and her worth is far above rubies or pearls.</p>
        </div>
    </div>
</section>

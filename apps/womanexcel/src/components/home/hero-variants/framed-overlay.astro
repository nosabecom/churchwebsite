---
// Variant F — Framed Overlay. C's full-bleed photograph, but the type moves
// flush left and an inset rule frames the whole thing like a printed poster.
import Logo from '../../../assets/excellent-women-logo.jpg';
import { Image } from 'astro:assets';
---

<section class="relative min-h-[38rem] md:min-h-[46rem] flex items-center overflow-hidden">
    <img src="/images/placeholds/photo-1.jpg" alt="" loading="eager"
        class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-charcoal/72"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal/70 via-transparent to-transparent"></div>

    <!-- Inset rule; decorative only, so it stays out of the pointer path. -->
    <div class="absolute inset-4 md:inset-8 border border-cream/25 rounded-2xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col gap-6 px-10 md:px-20 lg:px-28 py-20 max-w-3xl">
        <Image src={Logo} alt="Cornerstone Excellent Women" width="200" height="200" class="w-20 md:w-24 h-auto rounded-full" />

        <div class="flex items-center gap-3 md:gap-4">
            <span class="h-px w-10 md:w-16 bg-blush/60 shrink-0"></span>
            <p class="font-sans uppercase text-xs md:text-sm tracking-[0.25em] text-blush">Proverbs 31:10</p>
        </div>

        <h1 class="text-4xl md:text-6xl lg:text-7xl text-cream leading-[1.05] text-balance">
            Inspire, empower, <em class="text-blush not-italic">excel.</em>
        </h1>

        <p class="text-lg md:text-xl text-cream/85 max-w-xl text-pretty">
            Cornerstone Excellent Women is the women’s fellowship of RCCG Cornerstone Assembly — a community
            growing together in the Word, in prayer, and in the calling God has placed on their lives.
        </p>

        <div class="flex flex-wrap gap-3 md:gap-4 pt-2">
            <a class="cew-btn" href="/#mission">Our Mission</a>
            <a
                class="inline-block font-sans text-sm md:text-base rounded-full border border-cream/50 text-cream px-7 py-3 transition-colors hover:bg-cream hover:text-charcoal"
                href="/conference"
            >Woman Excel Conference</a>
        </div>
    </div>

    <p class="hidden lg:block absolute bottom-14 right-14 z-10 max-w-xs text-right text-cream/70 text-sm leading-relaxed">
        “Her value is more precious than jewels and her worth is far above rubies or pearls.”
    </p>
</section>

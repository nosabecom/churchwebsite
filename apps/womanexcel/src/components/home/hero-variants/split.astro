---
// Variant B — Split Portrait. Type flush left against a single tall image,
// with the verse carried on an overlapping card. Reads more editorial and
// puts a face to the fellowship sooner than the centered treatment.
import Logo from '../../../assets/excellent-women-logo.jpg';
import { Image } from 'astro:assets';
---

<section class="cew-section pt-10 md:pt-16 grid lg:grid-cols-2 items-center gap-10 lg:gap-16">
    <div class="flex flex-col gap-6 order-2 lg:order-1">
        <Image src={Logo} alt="Cornerstone Excellent Women" width="200" height="200" class="w-24 md:w-28 h-auto rounded-full" />

        <div class="flex items-center gap-3 md:gap-4">
            <span class="cew-rule"></span>
            <p class="cew-eyebrow">Proverbs 31:10</p>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl text-charcoal text-balance leading-tight">
            Inspire, empower, and support women to <em class="text-orchid not-italic">excel</em> in God’s purpose.
        </h1>

        <p class="cew-prose text-pretty">
            The women’s fellowship of RCCG Cornerstone Assembly — a community of women growing together
            in the Word, in prayer, and in the calling God has placed on their lives.
        </p>

        <div class="flex flex-wrap gap-3 md:gap-4 pt-2">
            <a class="cew-btn" href="/#mission">Our Mission</a>
            <a class="cew-btn-outline" href="/conference">Woman Excel Conference</a>
        </div>
    </div>

    <div class="relative order-1 lg:order-2">
        <img
            src="/images/placeholds/photo-6.jpg"
            alt=""
            loading="eager"
            class="w-full h-96 md:h-[34rem] object-cover rounded-3xl"
        />
        <div class="absolute -bottom-6 -left-6 hidden md:block max-w-xs rounded-2xl bg-orchid text-white p-6">
            <p class="font-sans text-xs tracking-[0.25em] uppercase text-white/70 mb-2">Proverbs 31:10</p>
            <p class="text-lg leading-snug">Her value is more precious than jewels and her worth is far above rubies or pearls.</p>
        </div>
    </div>
</section>

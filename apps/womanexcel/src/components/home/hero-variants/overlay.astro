---
// Variant C — Full-bleed Overlay. Photography carries the section and the type
// sits over a scrim. The boldest of the four; it depends most on having a
// strong real photograph, so it will read differently once the placeholders go.
import Logo from '../../../assets/excellent-women-logo.jpg';
import { Image } from 'astro:assets';
---

<section class="relative min-h-[36rem] md:min-h-[44rem] flex items-center justify-center overflow-hidden">
    <img
        src="/images/placeholds/photo-9.jpg"
        alt=""
        loading="eager"
        class="absolute inset-0 h-full w-full object-cover"
    />
    <!-- Scrim keeps the type legible whatever photograph ends up here. The
         extra gradient guards against a photo that is bright at the top,
         which is where the headline lands. -->
    <div class="absolute inset-0 bg-charcoal/75"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-charcoal/50 via-transparent to-charcoal/50"></div>

    <div class="relative z-10 flex flex-col items-center text-center gap-6 px-4 md:px-8 py-20 max-w-4xl">
        <Image src={Logo} alt="Cornerstone Excellent Women" width="240" height="240" class="w-28 md:w-36 h-auto rounded-full" />

        <div class="flex items-center gap-3 md:gap-4">
            <span class="h-px w-10 md:w-16 bg-blush/60 shrink-0"></span>
            <p class="font-sans uppercase text-xs md:text-sm tracking-[0.25em] text-blush">Proverbs 31:10</p>
            <span class="h-px w-10 md:w-16 bg-blush/60 shrink-0"></span>
        </div>

        <h1 class="text-4xl md:text-6xl text-cream text-balance leading-tight">
            Inspire, empower, and support women to <em class="text-blush not-italic">excel</em> in God’s purpose.
        </h1>

        <p class="text-lg md:text-xl text-cream/85 max-w-2xl text-pretty">
            The women’s fellowship of RCCG Cornerstone Assembly — growing together in the Word,
            in prayer, and in the calling God has placed on our lives.
        </p>

        <div class="flex flex-wrap justify-center gap-3 md:gap-4 pt-2">
            <a class="cew-btn" href="/#mission">Our Mission</a>
            <a
                class="inline-block font-sans text-sm md:text-base rounded-full border border-cream/50 text-cream px-7 py-3 transition-colors hover:bg-cream hover:text-charcoal"
                href="/conference"
            >Woman Excel Conference</a>
        </div>
    </div>
</section>

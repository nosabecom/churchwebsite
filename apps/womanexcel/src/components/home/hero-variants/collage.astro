---
// Variant H — Asymmetric Collage. The most designed of the set: an oversized
// headline with a portrait crossing into it from the right and a second image
// offset low-left, the verse running as a vertical caption.
import Logo from '../../../assets/excellent-women-logo.jpg';
import { Image } from 'astro:assets';
---

<section class="relative pt-10 md:pt-16 pb-16 md:pb-24 overflow-hidden">
    <div class="mx-auto w-full max-w-6xl px-4 md:px-8">
        <div class="flex items-center gap-4 mb-6">
            <Image src={Logo} alt="Cornerstone Excellent Women" width="160" height="160" class="w-14 md:w-16 h-auto rounded-full" />
            <span class="cew-rule"></span>
            <p class="cew-eyebrow">Proverbs 31:10</p>
        </div>

        <!-- min-height reserves room for the absolute portrait so it cannot
             spill down over the body copy in the grid below. -->
        <div class="relative lg:min-h-[24rem]">
            <h1 class="relative z-10 text-5xl md:text-7xl lg:text-8xl text-charcoal leading-[0.95] max-w-3xl text-balance">
                Inspire,<br />empower,<br /><em class="text-orchid not-italic">excel.</em>
            </h1>

            <!-- Portrait crosses behind the last line of the headline. -->
            <img src="/images/placeholds/photo-6.jpg" alt="" loading="eager"
                class="hidden lg:block absolute top-0 right-0 z-0 w-72 h-[22rem] object-cover rounded-2xl" />
        </div>

        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 mt-10 lg:mt-14 items-start">
            <div class="lg:col-span-5 flex flex-col gap-5">
                <img src="/images/placeholds/photo-3.jpg" alt="" loading="lazy"
                    class="w-full h-56 md:h-72 object-cover rounded-2xl" />
            </div>

            <div class="lg:col-span-5 flex flex-col gap-5">
                <p class="cew-prose text-pretty">
                    Cornerstone Excellent Women is the women’s fellowship of RCCG Cornerstone Assembly —
                    a community growing together in the Word, in prayer, and in the calling God has placed
                    on their lives.
                </p>
                <div class="flex flex-wrap gap-3 md:gap-4">
                    <a class="cew-btn" href="/#mission">Our Mission</a>
                    <a class="cew-btn-outline" href="/conference">Conference</a>
                </div>
            </div>

            <div class="hidden lg:flex lg:col-span-2 justify-end">
                <p class="font-sans uppercase text-xs tracking-[0.3em] text-orchid-deep [writing-mode:vertical-rl]">
                    Far above rubies
                </p>
            </div>
        </div>
    </div>

    <!-- Portrait, mobile placement: inline rather than overlapping. -->
    <div class="lg:hidden mx-auto w-full max-w-6xl px-4 md:px-8 mt-8">
        <img src="/images/placeholds/photo-6.jpg" alt="" loading="lazy"
            class="w-full h-72 md:h-96 object-cover rounded-2xl" />
    </div>
</section>

---
const pillars = [
    { number: "01", title: "Rooted in the Word", body: "To empower women to lead a Christ-like life and encourage growth in knowledge and application of the Word of faith." },
    { number: "02", title: "Excelling in Every Area", body: "To raise women who strive to excel in everything and every area of life." },
    { number: "03", title: "Home and Family", body: "To address issues and matters relevant to women as wives and mothers, and families as a whole." },
];
---

<section id="mission" class="cew-mission cew-anchor-section">
    <span class="cew-mission__ghost" aria-hidden="true">02</span>
    <div class="cew-mission__inner">
        <div class="cew-section-label">
            <span class="cew-section-label__line"></span>
            <span class="cew-section-label__number">02</span>
            <span>Our mission</span>
        </div>
        <div class="cew-mission__heading">
            <h2>Faith that<br /><em>moves with us.</em></h2>
            <p>
                We are believing God for women whose inner life and everyday life tell the same story:
                grounded, growing, and generous.
            </p>
        </div>

        <ol class="cew-pillar-list">
            {pillars.map((pillar) => (
                <li>
                    <span class="cew-pillar-list__number">{pillar.number}</span>
                    <div><h3>{pillar.title}</h3><p>{pillar.body}</p></div>
                    <span class="cew-pillar-list__arrow" aria-hidden="true">↗</span>
                </li>
            ))}
        </ol>
    </div>
</section>

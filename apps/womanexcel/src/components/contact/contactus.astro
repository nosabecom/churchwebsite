<section class="cew-contact" aria-labelledby="contact-heading">
    <header class="cew-contact__hero">
        <img src="/images/conference/2026/day-two-08.jpg" alt="Two women sharing an embrace at Woman Excel" fetchpriority="high" />
        <div aria-hidden="true"></div>
        <div>
            <p class="cew-kicker cew-kicker--light">Prayer · Testimony · Connection</p>
            <h1 id="contact-heading">Let’s begin a<br /><em>conversation.</em></h1>
            <p>However you arrived here, you do not have to walk the next part alone.</p>
        </div>
    </header>

    <div class="cew-contact__body">
        <aside>
            <div class="cew-section-label"><span class="cew-section-label__line"></span><span>Reach out</span></div>
            <h2>We would love<br />to hear from you.</h2>
            <p>
                Share a testimony, ask for prayer, send a suggestion, or simply introduce yourself.
                A member of the team will receive your message.
            </p>
            <a href="mailto:connect@rccgcornerstoneassembly.com">
                <span>Email us directly</span>
                connect@rccgcornerstoneassembly.com
            </a>
        </aside>

        <form method="POST" class="cew-contact-form">
            <fieldset>
                <legend>What would you like to share?</legend>
                <div class="cew-contact-form__choices">
                    <label><input type="radio" name="category" value="Testimony" checked /><span>Testimony</span></label>
                    <label><input type="radio" name="category" value="Prayer" /><span>Prayer</span></label>
                    <label><input type="radio" name="category" value="Suggestion" /><span>Suggestion</span></label>
                </div>
            </fieldset>

            <div class="cew-contact-form__field cew-contact-form__field--wide">
                <label for="fullname">Full name</label>
                <input id="fullname" name="fullname" type="text" autocomplete="name" required placeholder="Jane Doe" />
            </div>

            <div class="cew-contact-form__field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
            </div>
            <div class="cew-contact-form__field">
                <label for="phone">Phone <span>Optional</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(306) 555-0123" />
            </div>
            <div class="cew-contact-form__field cew-contact-form__field--wide">
                <label for="address">Address <span>Optional</span></label>
                <input id="address" name="address" type="text" autocomplete="street-address" placeholder="123 Main Street" />
            </div>
            <div class="cew-contact-form__field">
                <label for="city">City</label>
                <input id="city" name="city" type="text" autocomplete="address-level2" placeholder="Saskatoon" />
            </div>
            <div class="cew-contact-form__field">
                <label for="province">Province</label>
                <input id="province" name="province" type="text" autocomplete="address-level1" placeholder="Saskatchewan" />
            </div>
            <div class="cew-contact-form__field cew-contact-form__field--wide">
                <label for="postalcode">Postal code</label>
                <input id="postalcode" name="postalcode" type="text" autocomplete="postal-code" placeholder="S7K 3J7" />
            </div>
            <div class="cew-contact-form__field cew-contact-form__field--wide">
                <label for="message">Your message</label>
                <textarea id="message" name="message" rows="6" required placeholder="Tell us what is on your heart"></textarea>
            </div>

            <button type="submit">Send your message <span aria-hidden="true">→</span></button>
        </form>
    </div>
</section>

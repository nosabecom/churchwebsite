---
// Crossfading slideshow, extracted from the 2026 conference hero so the
// homepage can use it too.
//
// Timing lives in CSS so the slides advance without JavaScript; the controls
// re-seat that same animation rather than taking over from it. The original
// keyframes were hardcoded to ten slides, so the percentages are derived per
// instance here and emitted as instance-scoped keyframes.

interface Props {
    images: string[];
    /** Seconds each slide holds before it starts crossfading out. */
    perSlide?: number;
    /** Seconds of crossfade between one slide and the next. */
    fade?: number;
    arrows?: boolean;
    dots?: boolean;
    /** Control colouring: navy for the conference, cream for the fellowship. */
    theme?: "navy" | "cream";
    class?: string;
    /** Alt text is empty by default — these are decorative. */
    alt?: string;
}

const {
    images,
    perSlide = 8,
    fade = 1.6,
    arrows = false,
    dots = false,
    theme = "navy",
    class: className = "",
    alt = "",
} = Astro.props;

const count = images.length;
const total = count * perSlide;

// Keyframe stops as a percentage of the whole cycle.
const pct = (seconds: number) => Number(((seconds / total) * 100).toFixed(4));
const inAt = pct(fade);
const holdTo = pct(perSlide);
const outAt = pct(perSlide + fade);

// Start slide one mid-hold so the first paint is never a blank frame.
const offset = perSlide / 2;
const delay = (i: number) => `animation-delay: ${i * perSlide - offset}s`;

// Deterministic per-instance id, so two slideshows on a page cannot collide
// and the markup stays stable between builds.
const uid = "ss" + [...images.join("|"), String(perSlide)]
    .reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7)
    .toString(36);

const control = theme === "cream"
    ? "bg-cream/70 text-charcoal hover:bg-cream"
    : "bg-navy/60 text-white hover:bg-navy";
const dotOn = theme === "cream" ? "bg-cream" : "bg-white";
const dotOff = theme === "cream" ? "bg-cream/50 hover:bg-cream/80" : "bg-white/50 hover:bg-white/80";

// The dot keyframes animate background-color, so they need literal colours
// rather than the utility classes above (which only cover reduced motion).
const dotLit = theme === "cream" ? "233, 225, 212" : "255, 255, 255";
---

<div
    id={uid}
    class:list={["group relative overflow-hidden", className]}
    data-slideshow
    data-per-slide={perSlide}
    data-duration={total}
>
    {images.map((src, i) => (
        <img
            src={src}
            alt={alt}
            loading={i === 0 ? "eager" : "lazy"}
            data-slide
            style={delay(i)}
            class="absolute inset-0 h-full w-full object-cover"
        />
    ))}

    <slot />

    {arrows && (
        <>
            <button
                type="button"
                aria-label="Previous image"
                data-prev
                class:list={["absolute left-1 md:left-6 top-1/2 z-20 -translate-y-1/2 flex items-center justify-center w-5 h-7 md:w-12 md:h-12 rounded-full transition-opacity opacity-0 group-hover:opacity-100 focus-visible:opacity-100 any-pointer-coarse:opacity-100 cursor-pointer", control]}
            >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 18l-6-6 6-6" />
                </svg>
            </button>

            <button
                type="button"
                aria-label="Next image"
                data-next
                class:list={["absolute right-1 md:right-6 top-1/2 z-20 -translate-y-1/2 flex items-center justify-center w-5 h-7 md:w-12 md:h-12 rounded-full transition-opacity opacity-0 group-hover:opacity-100 focus-visible:opacity-100 any-pointer-coarse:opacity-100 cursor-pointer", control]}
            >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 18l6-6-6-6" />
                </svg>
            </button>
        </>
    )}

    {dots && (
        <div class="absolute bottom-4 left-0 right-0 z-20 flex justify-center gap-1 opacity-0 group-hover:opacity-100 focus-within:opacity-100 any-pointer-coarse:opacity-100 transition-opacity" data-dots>
            {images.map((_, i) => (
                <button
                    type="button"
                    aria-label={`Go to image ${i + 1}`}
                    data-dot
                    style={delay(i)}
                    class:list={["h-2 w-2 bg-clip-content rounded-full transition-colors cursor-pointer", i === 0 ? dotOn : dotOff]}
                ></button>
            ))}
        </div>
    )}
</div>

<style is:inline set:html={`
#${uid} [data-slide] { opacity: 0; animation: ${uid}-fade ${total}s infinite; }
#${uid} [data-dot] { animation: ${uid}-dot ${total}s infinite; }

@keyframes ${uid}-fade {
    0% { opacity: 0; }
    ${inAt}% { opacity: 1; }
    ${holdTo}% { opacity: 1; }
    ${outAt}% { opacity: 0; }
    100% { opacity: 0; }
}

@keyframes ${uid}-dot {
    0% { background-color: rgb(${dotLit}); }
    ${holdTo}% { background-color: rgb(${dotLit}); }
    ${outAt}% { background-color: rgba(${dotLit}, 0.5); }
    100% { background-color: rgba(${dotLit}, 0.5); }
}

@media (prefers-reduced-motion: reduce) {
    #${uid} [data-slide],
    #${uid} [data-dot] { animation: none; }
    #${uid} [data-slide]:first-child { opacity: 1; }
}
`}></style>

<script>
    // Auto-advance timing lives in CSS. The controls re-phase that same
    // animation so it keeps playing on from the slide you picked, instead of
    // restarting or stopping.
    document.querySelectorAll<HTMLElement>("[data-slideshow]").forEach((root) => {
        const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
        const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
        const count = slides.length;
        if (count === 0) return;

        // Read the cadence the component rendered rather than re-deriving it.
        const perSlide = Number(root.dataset.perSlide);
        const duration = Number(root.dataset.duration);
        if (!perSlide || !duration) return;
        const visiblePhase = perSlide / 2;

        const currentIndex = () => {
            let best = 0;
            let bestOpacity = -1;
            slides.forEach((slide, i) => {
                const opacity = parseFloat(getComputedStyle(slide).opacity);
                if (opacity > bestOpacity) {
                    bestOpacity = opacity;
                    best = i;
                }
            });
            return best;
        };

        // Shifting animation-delay against the animation's own clock re-seats
        // it without a restart. The old animation:none/reflow trick applied
        // fresh delays to a stale clock when the restart silently failed on
        // mobile, leaving every slide transparent until the cycle wrapped.
        const seat = (index: number) => {
            const target = ((index % count) + count) % count;

            const reseat = (node: HTMLElement, i: number) => {
                const anim = node.getAnimations().find((a) => a instanceof CSSAnimation);
                if (!anim) return;
                const step = (i - target + count) % count;
                const elapsed = Number(anim.currentTime ?? 0) / 1000;
                const phase = visiblePhase - step * perSlide;
                const at = ((phase % duration) + duration) % duration;
                node.style.animationDelay = `${elapsed - at}s`;
            };

            slides.forEach(reseat);
            dots.forEach((dot, i) => reseat(dot, i));
        };

        root.querySelector("[data-prev]")?.addEventListener("click", () => seat(currentIndex() - 1));
        root.querySelector("[data-next]")?.addEventListener("click", () => seat(currentIndex() + 1));
        dots.forEach((dot, i) => dot.addEventListener("click", () => seat(i)));
    });
</script>

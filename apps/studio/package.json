{
  "name": "@churchwebsite/studio",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node --env-file-if-exists=../../.env.development ./node_modules/sanity/bin/sanity build",
    "deploy": "node --env-file-if-exists=../../.env.development ./node_modules/sanity/bin/sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "node --env-file-if-exists=../../.env.development ./node_modules/sanity/bin/sanity dev",
    "schema:extract": "node --env-file-if-exists=../../.env.development ./node_modules/sanity/bin/sanity schemas extract --force --enforce-required-fields",
    "start": "node --env-file-if-exists=../../.env.development ./node_modules/sanity/bin/sanity start",
    "typegen:generate": "node --env-file-if-exists=../../.env.development ./node_modules/sanity/bin/sanity typegen generate && node scripts/sync-generated-types.mjs",
    "typegen": "pnpm schema:extract && pnpm typegen:generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^6.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.9.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}

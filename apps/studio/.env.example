SANITY_STUDIO_PROJECT_ID=your-project-id
# Use development locally; reserve production for deployed production builds.
SANITY_STUDIO_DATASET=your-dataset-name

# Optional override used by the Blueprint helper on machines without a local stack binding.
SANITY_BLUEPRINT_STACK_ID=
# Secret input for the Church Main Bash/PowerShell helpers; prefer their hidden prompt.
# Never commit a real deploy-hook URL or expose it through a PUBLIC_ variable.
CHURCH_MAIN_VERCEL_DEPLOY_HOOK_URL=

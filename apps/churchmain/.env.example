# In Google Forms, choose Send > Embed (<>) and copy the URL from the iframe's src attribute.
PUBLIC_NEW_TO_CHURCH_FORM_URL=https://docs.google.com/forms/d/e/REPLACE_WITH_YOUR_FORM_ID/viewform?embedded=true

PUBLIC_SANITY_PROJECT_ID=your-project-id
# Use development locally; reserve production for deployed production builds.
PUBLIC_SANITY_DATASET=your-dataset-name
# Enable only after the newsletter review import and parity checks pass.
PUBLIC_SANITY_NEWSLETTERS_ENABLED=false
# Required for the private production dataset. Keep server-only; never rename with PUBLIC_.
SANITY_API_READ_TOKEN=

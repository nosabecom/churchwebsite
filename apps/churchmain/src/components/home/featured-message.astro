---
import { messages } from "../../data/messages";
import ArrowIcon from "../arrow-icon.astro";

const featuredMessages = messages.slice(0, 4);
const [latest] = featuredMessages;
---

<section class="word-section" id="latest-message" aria-labelledby="word-heading">
    <div class="word-bg" aria-hidden="true">
        <div class="word-orb word-orb--gold"></div>
        <div class="word-orb word-orb--coral"></div>
        <div class="sunlit-motes" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
    </div>

    <div class="page-shell word-inner">
        <header class="word-header" data-animate>
            <div>
                <p class="section-kicker section-kicker--light"><span>02</span> Hear the word</p>
                <h2 id="word-heading" class="section-title section-title--light">
                    Life-giving truth for <em>everyday life.</em>
                </h2>
            </div>
            <a class="btn btn--glass" href="/messages" data-magnetic>
                <span>Explore all messages</span>
                <span class="btn__icon"><ArrowIcon /></span>
            </a>
        </header>

        <div class="word-stage" data-message-switcher>
            <article class="word-feature" data-animate data-spotlight>
                <div class="word-feature__meta">
                    <span class="sound-pill">
                        <span class="equalizer" aria-hidden="true">
                            <i></i><i></i><i></i><i></i>
                        </span>
                        <span data-msg-series>{latest.series}</span>
                    </span>
                    <span class="word-feature__scripture" data-msg-scripture>{latest.scripture}</span>
                </div>

                <blockquote class="word-feature__quote" data-msg-quote>
                    “{latest.quote}”
                </blockquote>

                <div class="word-feature__details">
                    <div>
                        <h3 data-msg-title>{latest.title}</h3>
                        <p class="word-feature__speaker" data-msg-speaker>
                            {latest.speaker} · {latest.date} · {latest.duration}
                        </p>
                        <p class="word-feature__summary" data-msg-summary>{latest.summary}</p>
                    </div>

                    <a
                        class="play-portal"
                        href={`/messages/${latest.slug}`}
                        data-msg-href
                        data-magnetic
                        aria-label={`Watch and read ${latest.title}`}
                    >
                        <span class="play-portal__ring" aria-hidden="true"></span>
                        <span class="play-portal__ring play-portal__ring--outer" aria-hidden="true"></span>
                        <span class="play-portal__core">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M8.5 5.2v13.6L19.5 12 8.5 5.2Z" />
                            </svg>
                        </span>
                    </a>
                </div>

                <div class="word-feature__cta">
                    <a class="btn btn--gold" href={`/messages/${latest.slug}`} data-msg-cta data-magnetic>
                        <span>Watch &amp; read transcript</span>
                        <span class="btn__icon"><ArrowIcon /></span>
                    </a>
                </div>
            </article>

            <div class="word-playlist" role="tablist" aria-label="Recent Sunday messages" data-animate data-delay="120">
                <p class="word-playlist__label">Recent Sunday messages</p>
                {featuredMessages.map((msg, index) => (
                    <button
                        type="button"
                        class={`playlist-item ${index === 0 ? "is-active" : ""}`}
                        role="tab"
                        aria-selected={index === 0 ? "true" : "false"}
                        data-msg-tab
                        data-title={msg.title}
                        data-speaker={`${msg.speaker} · ${msg.date} · ${msg.duration}`}
                        data-series={msg.series}
                        data-scripture={msg.scripture}
                        data-quote={`“${msg.quote}”`}
                        data-summary={msg.summary}
                        data-href={`/messages/${msg.slug}`}
                    >
                        <span class="playlist-item__index">{String(index + 1).padStart(2, "0")}</span>
                        <span class="playlist-item__body">
                            <strong>{msg.title}</strong>
                            <small>{msg.speaker} · {msg.scripture}</small>
                        </span>
                        <span class="playlist-item__dur">{msg.duration}</span>
                    </button>
                ))}
            </div>
        </div>
    </div>
</section>

---
import { churchEvents, formatEventDate, formatEventTime } from "../../data/events";
import ArrowIcon from "../arrow-icon.astro";
const events = churchEvents.slice(0, 3);
const accents = ["lime", "blue", "coral"];
---

<section class="events-section page-shell" id="upcoming-events" aria-labelledby="events-heading">
    <header class="section-header">
        <div><p class="section-kicker">Save the date</p><h2 id="events-heading">There’s always<br />something <span class="scribble">happening.</span></h2></div>
        <a class="button button--outline" href="/events">See every event <ArrowIcon /></a>
    </header>
    <div class="event-grid">
        {events.map((event, index) => (
            <article class={`event-card event-card--${accents[index]}`}>
                <div class="event-card__top">
                    <p class="event-card__category">{event.category}</p>
                    <time class="event-card__date" datetime={event.date}><strong>{formatEventDate(event.date, { day: "2-digit" })}</strong><span>{formatEventDate(event.date, { month: "short" })}</span></time>
                </div>
                <div class="event-card__body">
                    <h3>{event.title}</h3>
                    <p>{event.description}</p>
                </div>
                <div class="event-card__footer">
                    <span>{formatEventDate(event.date, { weekday: "long" })} · {formatEventTime(event.startTime)}<small>{event.location}</small></span>
                    <a class="event-card__arrow" href={`/events?view=month&month=${event.date.slice(0, 7)}&event=${event.id}#${event.id}`} aria-label={`View ${event.title} details`}><ArrowIcon /></a>
                </div>
            </article>
        ))}
    </div>
</section>

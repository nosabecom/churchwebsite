---
import { churchEvents, formatEventDate, formatEventTime } from "../../data/events";

const events = churchEvents.slice(0, 5);
---

<section class="events-section" id="upcoming-events" aria-labelledby="events-heading">
    <div class="page-shell">
        <header class="events-header" data-reveal>
            <div>
                <p class="section-kicker section-kicker--dark">What’s happening</p>
                <h2 id="events-heading">Make room<br /><em>for more.</em></h2>
            </div>
            <div class="events-header__aside">
                <p>Worship. Community. Moments that move us forward together.</p>
                <a class="text-link" href="/events">Explore the full calendar <span aria-hidden="true">→</span></a>
            </div>
        </header>

        <div class="event-rail" tabindex="0" aria-label="Upcoming events" data-event-rail>
            {events.map((event, index) => (
                <article class:list={["event-card", `event-card--${(index % 3) + 1}`]} data-reveal style={`--reveal-delay: ${index * .07}s`}>
                    <div class="event-card__topline">
                        <span>{event.category}</span>
                        <span>{String(index + 1).padStart(2, "0")}</span>
                    </div>
                    <time class="event-card__date" datetime={event.date}>
                        <strong>{formatEventDate(event.date, { day: "2-digit" })}</strong>
                        <span>{formatEventDate(event.date, { month: "short" })}</span>
                    </time>
                    <div class="event-card__body">
                        <h3>{event.title}</h3>
                        <p>{event.description}</p>
                    </div>
                    <div class="event-card__footer">
                        <p>{formatEventTime(event.startTime)} · {event.location}</p>
                        <a href={`/events?view=month&month=${event.date.slice(0, 7)}&event=${event.id}#${event.id}`} aria-label={`View details for ${event.title}`}>→</a>
                    </div>
                </article>
            ))}
        </div>

        <p class="rail-hint" aria-hidden="true">Drag to explore <span>→</span></p>
    </div>
</section>

---
import { Image } from "astro:assets";
import { Quote, Slideshow } from "@churchwebsite/ui";
import Welcome from "./welcome.astro";
import Wordmark from "../../assets/cornerstone-logo-horizontal.png";

// Add more church-owned images here as they are placed in public/images.
const slides = [
    {
        src: "/images/placeholds/1.jpg",
        alt: "RCCG Cornerstone Assembly congregation",
    },
];
---

<div class="px-4 py-8">
    <section class="mx-auto grid max-w-400 overflow-hidden rounded-2xl shadow-2xl shadow-sky-950/40 lg:grid-cols-[minmax(0,1fr)_26rem] 2xl:grid-cols-[minmax(0,1fr)_32rem]">
        <Slideshow
            slides={slides}
            label="RCCG Cornerstone Assembly highlights"
            class="churchmain-slideshow h-full w-full min-h-96 md:min-h-80"
        >
            <div class="relative z-10 flex h-full flex-col items-center justify-center gap-8 px-4 py-8 md:px-12 md:py-10 lg:gap-8 lg:py-7">
                <Image
                    src={Wordmark}
                    alt="RCCG Cornerstone Assembly"
                    class="h-auto w-full max-w-3xl drop-shadow-2xl lg:max-w-lg"
                    widths={[320, 640, 768]}
                    sizes="(min-width: 1024px) 32rem, 90vw"
                />

                <Quote
                    quote="The stone which the builders rejected has become the chief cornerstone."
                    citation="Mark 12:10"
                    class="churchmain-quote max-w-3xl"
                />
            </div>
        </Slideshow>

        <Welcome />
    </section>
</div>

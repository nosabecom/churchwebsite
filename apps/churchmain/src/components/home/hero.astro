---
import { Image } from "astro:assets";
import Gathering from "../../assets/community/cornerstone-gathering.jpg";
import ArrowIcon from "../arrow-icon.astro";
---

<section class="home-hero" aria-labelledby="hero-heading">
    <div class="home-hero__opening">
        <div class="home-hero__content">
            <p class="hero-eyebrow"><span></span> RCCG Cornerstone Assembly · Saskatoon</p>
            <h1 id="hero-heading"><span>You belong</span><em>here.</em></h1>
            <p class="home-hero__intro">Come as you are. Meet Jesus, find your people, and grow into your purpose.</p>
            <div class="home-hero__actions">
                <a class="button button--electric" href="/new-to-church">Plan your first Sunday <ArrowIcon /></a>
                <a class="button button--ghost" href="#welcome">Meet Cornerstone</a>
            </div>
        </div>

        <figure class="home-hero__photo">
            <Image src={Gathering} alt="Members of the Cornerstone church family smiling and gathering together" widths={[540, 800, 1080]} sizes="(min-width: 900px) 42vw, 100vw" loading="eager" fetchpriority="high" />
            <figcaption><span>Real people.</span><strong>Real family.</strong></figcaption>
            <button class="motion-toggle" type="button" aria-pressed="false" data-motion-toggle hidden>Pause motion</button>
        </figure>
    </div>

    <div class="sunday-bar">
        <div class="sunday-bar__time">
            <span class="sunday-bar__pulse" aria-hidden="true"></span>
            <div><span class="detail-label">This Sunday</span><strong>9:00 AM</strong></div>
        </div>
        <div class="sunday-bar__address"><span class="detail-label">Meet us here</span><address>70–3904 Millar Avenue · Saskatoon, SK</address></div>
        <a class="button button--dark" href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1" target="_blank" rel="noreferrer">Get directions <ArrowIcon /></a>
    </div>
</section>

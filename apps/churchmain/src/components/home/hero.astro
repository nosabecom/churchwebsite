---
import { Image } from "astro:assets";
import HeroImage from "../../assets/cornerstone-worship-hero.png";
---

<section class="home-hero" aria-labelledby="hero-heading" data-hero>
    <Image
        class="home-hero__image"
        src={HeroImage}
        alt="A joyful, multicultural congregation worshipping together"
        widths={[768, 1200, 1672]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
    />
    <div class="home-hero__wash" aria-hidden="true"></div>
    <div class="home-hero__glow" aria-hidden="true"></div>

    <div class="home-hero__content page-shell">
        <p class="hero-eyebrow hero-reveal" style="--delay: .12s">
            <span class="hero-eyebrow__dot" aria-hidden="true"></span>
            RCCG Cornerstone Assembly · Saskatoon
        </p>

        <h1 class="home-hero__title" id="hero-heading">
            <span class="hero-line"><span style="--delay: .18s">Built for</span></span>
            <span class="hero-line hero-line--accent"><span style="--delay: .28s">purpose.</span></span>
            <span class="hero-line"><span style="--delay: .38s">Alive with</span></span>
            <span class="hero-line hero-line--accent"><span style="--delay: .48s">praise.</span></span>
        </h1>

        <div class="home-hero__intro hero-reveal" style="--delay: .68s">
            <p>
                Faith for real life. Family for every season. A place to meet Jesus,
                grow with people, and become who God made you to be.
            </p>

            <div class="home-hero__actions">
                <a class="button button--coral" href="/new-to-church">
                    Plan your visit <span aria-hidden="true">→</span>
                </a>
                <a class="text-link text-link--light" href="/messages">
                    Watch a message <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>

    <p class="home-hero__verse hero-reveal" style="--delay: .82s">
        <span>Mark 12:10</span>
        “The stone the builders rejected has become the cornerstone.”
    </p>

    <div class="home-hero__services hero-reveal" style="--delay: .92s">
        <div class="page-shell home-hero__services-inner">
            <p class="service-callout">
                <span class="service-callout__label">This Sunday</span>
                <strong>9:00 AM</strong>
            </p>
            <p class="service-callout service-callout--address">
                <span class="service-callout__label">In person</span>
                <span>70–3904 Millar Ave, Saskatoon</span>
            </p>
            <a
                class="service-map"
                href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1"
                target="_blank"
                rel="noreferrer"
            >
                Get directions <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>

    <span class="home-hero__side-note" aria-hidden="true">COME AS YOU ARE · LEAVE WITH PURPOSE</span>
</section>

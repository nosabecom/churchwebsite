---
import { Image } from "astro:assets";
import CornerstoneSculpture from "../../assets/cornerstone-sculpture.png";
import ArrowIcon from "../arrow-icon.astro";
---

<section class="home-hero page-shell" aria-labelledby="hero-heading">
    <div class="home-hero__opening">
        <div class="home-hero__content">
            <p class="section-kicker">RCCG Cornerstone Assembly · Saskatoon</p>
            <h1 id="hero-heading">Built on faith.<br /><span>Made for life.</span></h1>
            <p class="home-hero__intro">A church family for the whole of life.<br class="desktop-break" /> Come meet Jesus. Find your people. Grow with purpose.</p>
            <div class="home-hero__actions">
                <a class="button button--ink" href="/new-to-church">Plan your visit <span><ArrowIcon /></span></a>
                <a class="button button--outline" href="/messages">Explore messages <span><ArrowIcon direction="right" /></span></a>
            </div>
        </div>
        <div class="home-hero__art" data-ambient-art>
            <span class="home-hero__art-grid" aria-hidden="true"></span>
            <Image src={CornerstoneSculpture} alt="" widths={[400, 600, 900]} sizes="(min-width: 900px) 40vw, 75vw" loading="eager" fetchpriority="high" />
            <span class="home-hero__art-note" aria-hidden="true"><i></i> There’s room for you.</span>
            <span class="home-hero__art-caption" aria-hidden="true">A firm foundation. An open door.</span>
            <button class="motion-toggle" type="button" aria-pressed="false" data-motion-toggle hidden>Pause animation</button>
        </div>
    </div>
    <div class="sunday-bar">
        <div class="sunday-bar__time"><span class="status-dot" aria-hidden="true"></span><div><span class="detail-label">See you on Sunday</span><strong>9:00 AM</strong></div></div>
        <div class="sunday-bar__address"><span class="detail-label">You’ll find us here</span><address>70–3904 Millar Avenue<br />Saskatoon, SK S7P 0B1</address></div>
        <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1" target="_blank" rel="noreferrer">Get directions <span><ArrowIcon /></span></a>
    </div>
</section>

---
import { Image } from "astro:assets";
import Gathering from "../../assets/community/cornerstone-gathering.jpg";
import ArrowIcon from "../arrow-icon.astro";
---

<section class="hero-stage" aria-labelledby="hero-heading">
    <div class="hero-frame">
        <div class="hero-media" data-parallax="0.14">
            <Image
                src={Gathering}
                alt="Members of the RCCG Cornerstone Assembly church family smiling and greeting one another"
                widths={[640, 1080, 1600]}
                sizes="(min-width: 900px) 96vw, 100vw"
                loading="eager"
                fetchpriority="high"
            />
        </div>
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="hero-aurora hero-aurora--gold" aria-hidden="true"></div>
        <div class="hero-aurora hero-aurora--coral" aria-hidden="true"></div>
        <div class="sunlit-motes" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>

        <div class="hero-topbar">
            <p class="hero-pill">
                <span class="live-dot" aria-hidden="true"></span>
                <span class="hero-pill__brand">RCCG Cornerstone · Saskatoon</span>
                <span class="hero-pill__sep" aria-hidden="true">·</span>
                <span class="hero-pill__countdown" data-next-sunday>This Sunday at 9:00 AM</span>
            </p>

            <button
                class="motion-toggle"
                type="button"
                aria-pressed="false"
                data-motion-toggle
                hidden
            >
                <span class="motion-toggle__dot" aria-hidden="true"></span>
                <span data-motion-label>Pause motion</span>
            </button>
        </div>

        <div class="hero-body">
            <div class="hero-copy">
                <h1 id="hero-heading" class="hero-title">
                    <span class="reveal-mask"><span class="reveal-line" style="--d: 0.06s">Where faith</span></span>
                    <span class="reveal-mask"><span class="reveal-line" style="--d: 0.18s">feels like <em>home.</em></span></span>
                </h1>

                <p class="hero-lead">
                    Come just as you are. Experience vibrant worship, grounded scripture, and a warm church family walking through real life together in Saskatoon.
                </p>

                <div class="hero-actions">
                    <a class="btn btn--gold" href="/new-to-church" data-magnetic>
                        <span>Plan your first Sunday</span>
                        <span class="btn__icon"><ArrowIcon /></span>
                    </a>
                    <a class="btn btn--glass" href="#latest-message" data-magnetic>
                        <span class="play-chip" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
                        </span>
                        <span>Hear a Sunday message</span>
                    </a>
                </div>
            </div>

            <div class="hero-caption">
                <span class="hero-caption__rule" aria-hidden="true"></span>
                <div>
                    <strong>Real people.</strong>
                    <span>Real family.</span>
                </div>
            </div>
        </div>

        <div class="hero-dock" aria-label="Service times and location">
            <div class="hero-dock__item">
                <span class="hero-dock__sun" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                        <circle cx="12" cy="12" r="4.2" />
                        <path d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6" />
                    </svg>
                </span>
                <div>
                    <span class="dock-label">Sunday Worship</span>
                    <strong class="dock-value">9:00 AM</strong>
                </div>
            </div>

            <div class="hero-dock__item hero-dock__item--mid">
                <span class="dock-pulse" aria-hidden="true"></span>
                <div>
                    <span class="dock-label">Mid-Week &amp; Prayer</span>
                    <strong class="dock-value dock-value--sm">Wed 7:00 PM · Power Night Last Fri</strong>
                </div>
            </div>

            <div class="hero-dock__item hero-dock__item--address">
                <div>
                    <span class="dock-label">Find us in Saskatoon</span>
                    <address class="dock-address">70–3904 Millar Avenue, SK S7P 0B1</address>
                </div>
                <a
                    class="dock-link"
                    href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1"
                    target="_blank"
                    rel="noreferrer"
                    data-magnetic
                >
                    <span>Directions</span>
                    <ArrowIcon />
                </a>
            </div>
        </div>
    </div>

    <div class="spirit-marquee" aria-hidden="true">
        <div class="spirit-marquee__track">
            <span>People of Purpose</span><i class="marquee-star">✦</i>
            <span>Power &amp; Praise</span><i class="marquee-star">✦</i>
            <span>Sundays at 9:00 AM</span><i class="marquee-star">✦</i>
            <span>Room at the Table</span><i class="marquee-star">✦</i>
            <span>Saskatoon, Saskatchewan</span><i class="marquee-star">✦</i>
            <span>Come As You Are</span><i class="marquee-star">✦</i>
            <span>People of Purpose</span><i class="marquee-star">✦</i>
            <span>Power &amp; Praise</span><i class="marquee-star">✦</i>
            <span>Sundays at 9:00 AM</span><i class="marquee-star">✦</i>
            <span>Room at the Table</span><i class="marquee-star">✦</i>
            <span>Saskatoon, Saskatchewan</span><i class="marquee-star">✦</i>
            <span>Come As You Are</span><i class="marquee-star">✦</i>
        </div>
    </div>
</section>

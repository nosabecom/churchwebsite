---
import MinistryArt from "./ministry-art.astro";
import ArrowIcon from "../arrow-icon.astro";
const ministries = [
    { title: "Women", kind: "women" as const, description: "Faith, friendship, and encouragement through every season.", href: "/ministries/women", style: "coral" },
    { title: "Men", kind: "men" as const, description: "Growing together in faith, purpose, and everyday life.", href: "/ministries/men", style: "blue" },
    { title: "Youth", kind: "youth" as const, description: "Real questions. Real friendships. A faith of your own.", href: "/ministries/youths-teenagers", style: "lime" },
    { title: "Children", kind: "children" as const, description: "A little wonder, a lot of joy, and room to grow in Jesus.", href: "/ministries/children", style: "cream" },
];
---

<section class="ministries-section" id="ministries" aria-labelledby="ministries-heading">
    <div class="page-shell">
        <header class="section-header">
            <div><p class="section-kicker">Life is better together</p><h2 id="ministries-heading">Find your people.</h2></div>
            <a class="text-link" href="/ministries">Explore our ministries <span><ArrowIcon /></span></a>
        </header>
        <div class="ministry-grid">
            {ministries.map((ministry) => (
                <a class:list={["ministry-tile", `ministry-tile--${ministry.style}`]} href={ministry.href}>
                    <span class="ministry-tile__stage"><MinistryArt kind={ministry.kind} /></span>
                    <span class="ministry-tile__heading"><span class="ministry-tile__title">{ministry.title}</span><span class="ministry-tile__arrow"><ArrowIcon /></span></span>
                    <span class="ministry-tile__description">{ministry.description}</span>
                </a>
            ))}
        </div>
    </div>
</section>

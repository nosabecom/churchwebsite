---
const ministries = [
    { number: "01", title: "Women", label: "Grow boldly", description: "A community of women becoming excellent in faith, family, and purpose.", href: "/ministries/women", style: "coral" },
    { number: "02", title: "Men", label: "Lead faithfully", description: "Brotherhood, accountability, and practical faith for every season of life.", href: "/ministries/men", style: "blue" },
    { number: "03", title: "Youth", label: "Live unfiltered", description: "A space for young people to ask real questions and build resilient faith.", href: "/ministries/youths-teenagers", style: "lime" },
    { number: "04", title: "Children", label: "Wonder out loud", description: "Safe, energetic, age-appropriate environments where little faith grows big.", href: "/ministries/children", style: "cream" },
];
---

<section class="ministries-section" id="ministries" aria-labelledby="ministries-heading">
    <div class="ministries-noise" aria-hidden="true"></div>
    <div class="page-shell">
        <header class="ministries-header" data-reveal>
            <p class="section-kicker section-kicker--light">There’s a circle for you</p>
            <h2 id="ministries-heading">Find your people.<br /><em>Grow your faith.</em></h2>
            <a class="text-link text-link--light" href="/ministries">Meet every ministry <span aria-hidden="true">→</span></a>
        </header>

        <div class="ministry-grid">
            {ministries.map((ministry, index) => (
                <a
                    class:list={["ministry-tile", `ministry-tile--${ministry.style}`]}
                    href={ministry.href}
                    data-reveal
                    style={`--reveal-delay: ${index * .08}s`}
                >
                    <span class="ministry-tile__number">{ministry.number}</span>
                    <span class="ministry-tile__label">{ministry.label}</span>
                    <span class="ministry-tile__title">{ministry.title}</span>
                    <span class="ministry-tile__description">{ministry.description}</span>
                    <span class="ministry-tile__arrow" aria-hidden="true">→</span>
                </a>
            ))}
        </div>
    </div>
</section>

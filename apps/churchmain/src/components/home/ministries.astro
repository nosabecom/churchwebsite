---
import { Image } from "astro:assets";
import Prayer from "../../assets/community/prayer.jpg";
import Fellowship from "../../assets/community/fellowship.jpg";
import ArrowIcon from "../arrow-icon.astro";
const ministries = [
    { title: "Women", number: "01", href: "/ministries/women" },
    { title: "Men", number: "02", href: "/ministries/men" },
    { title: "Youth", number: "03", href: "/ministries/youths-teenagers" },
    { title: "Children", number: "04", href: "/ministries/children" },
];
---

<section class="ministries-section" id="ministries" aria-labelledby="ministries-heading">
    <div class="page-shell ministries-layout">
        <div class="ministries-copy">
            <p class="section-kicker">Find your people</p>
            <h2 id="ministries-heading">Faith grows<br /><span>together.</span></h2>
            <p>Big church becomes family when you find your circle. There’s a place here for every age and every season.</p>
            <div class="ministry-grid">
                {ministries.map(ministry => (
                    <a class="ministry-tile" href={ministry.href}><small>{ministry.number}</small><span class="ministry-tile__title">{ministry.title}</span><ArrowIcon /></a>
                ))}
            </div>
            <a class="button button--electric" href="/ministries">Explore every ministry <ArrowIcon /></a>
        </div>
        <div class="community-photos">
            <figure class="community-photos__prayer"><Image src={Prayer} alt="Women from the Cornerstone community joining hands in prayer" widths={[500, 800, 1080]} sizes="(min-width: 900px) 50vw, 100vw" /><figcaption>We pray together.</figcaption></figure>
            <figure class="community-photos__table"><Image src={Fellowship} alt="The Cornerstone community sharing fellowship around tables" widths={[400, 650, 900]} sizes="(min-width: 900px) 26vw, 55vw" /><figcaption>We do life together.</figcaption></figure>
            <span class="community-sticker" aria-hidden="true">BETTER<br />TOGETHER</span>
        </div>
    </div>
</section>

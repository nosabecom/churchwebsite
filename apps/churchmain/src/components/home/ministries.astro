---
import { Image } from "astro:assets";
import Prayer from "../../assets/community/prayer.jpg";
import Fellowship from "../../assets/community/fellowship.jpg";
import ArrowIcon from "../arrow-icon.astro";

const ministries = [
    { title: "Women", description: "Faith & friendship", href: "/ministries/women" },
    { title: "Men", description: "Purpose & brotherhood", href: "/ministries/men" },
    { title: "Youth", description: "Questions & possibility", href: "/ministries/youths-teenagers" },
    { title: "Children", description: "Wonder & growing faith", href: "/ministries/children" },
];
---

<section class="ministries-section" id="ministries" aria-labelledby="ministries-heading">
    <div class="page-shell ministries-layout">
        <div class="community-photos">
            <figure class="community-photos__prayer"><Image src={Prayer} alt="Women from the Cornerstone community joining hands in prayer at Woman Excel" widths={[400, 650, 900]} sizes="(min-width: 900px) 32vw, 64vw" /><figcaption>Faith that brings us together.</figcaption></figure>
            <figure class="community-photos__table"><Image src={Fellowship} alt="The Woman Excel community sharing fellowship around tables at the 2026 conference" widths={[350, 550, 800]} sizes="(min-width: 900px) 24vw, 50vw" /></figure>
            <span class="community-photos__detail" aria-hidden="true">Together<br /><em>is a good place.</em></span>
        </div>
        <div class="ministries-copy">
            <p class="section-kicker">More than a Sunday</p>
            <h2 id="ministries-heading">Life is better<br /><em>together.</em></h2>
            <p>There’s room for every generation, every story, and every season of life. Find a community to grow with.</p>
            <div class="ministry-grid">
                {ministries.map(ministry => (
                    <a class="ministry-tile" href={ministry.href}>
                        <span class="ministry-tile__heading"><span class="ministry-tile__title">{ministry.title}</span><ArrowIcon /></span>
                        <span class="ministry-tile__description">{ministry.description}</span>
                    </a>
                ))}
            </div>
            <a class="text-link" href="/ministries">Explore our ministries <ArrowIcon /></a>
        </div>
    </div>
</section>

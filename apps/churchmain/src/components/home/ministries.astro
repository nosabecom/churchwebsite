---
import CardRail from "./card-rail.astro";

// Placeholder content only. These entries will later be pulled from the
// church YouTube channel; no API work is wired up yet.
const ministrations = [
    {
        title: "The Stone The Builders Rejected",
        speaker: "Pastor in charge",
        published: "This week",
        duration: "48:12",
        current: true,
    },
    {
        title: "Walking In Step With The Spirit",
        speaker: "Assistant Pastor",
        published: "1 week ago",
        duration: "52:40",
    },
    {
        title: "Sunday Worship — Full Service",
        speaker: "Cornerstone Choir",
        published: "1 week ago",
        duration: "1:24:05",
    },
    {
        title: "Foundations: Prayer That Moves",
        speaker: "Prayer Department",
        published: "2 weeks ago",
        duration: "39:57",
    },
    {
        title: "Youth Night: Chosen Generation",
        speaker: "Youths & Teenagers",
        published: "3 weeks ago",
        duration: "45:20",
    },
    {
        title: "Bible Study: The Book Of Acts",
        speaker: "Bible Study Department",
        published: "1 month ago",
        duration: "1:02:33",
    },
];
---

<CardRail
    id="ministries"
    heading="Ministries"
    description="The most recent ministrations first, straight from our YouTube channel."
    previousLabel="Newer ministrations"
    nextLabel="Older ministrations"
    linkLabel="See all ministrations"
    linkHref="#"
>
    {ministrations.map((ministration) => (
        <li class="flex w-80 shrink-0 snap-start flex-col overflow-hidden rounded-2xl bg-slate-50 text-slate-900 shadow-xl shadow-sky-950/30 md:w-88">
            <div class="relative grid aspect-video place-items-center bg-linear-to-br from-sky-800 to-sky-950">
                {/* Placeholder for the YouTube thumbnail. */}
                <span
                    class="grid size-14 place-items-center rounded-full bg-red-600 text-lg text-white"
                    aria-hidden="true"
                >▶</span>

                <span class="absolute right-3 bottom-3 rounded-md bg-black/70 px-2 py-1 text-xs font-semibold text-white">
                {ministration.duration}
                </span>

                {ministration.current && (
                    <span class="absolute top-3 left-3 rounded-md bg-red-600 px-2 py-1 text-xs font-extrabold tracking-widest text-white uppercase">
                        Latest
                    </span>
                )}
            </div>

            <div class="flex flex-1 flex-col p-8">
                <h3 class="mb-3 text-2xl leading-snug font-bold text-sky-900">{ministration.title}</h3>

                <p class="mb-4 text-sm font-semibold tracking-wide text-red-700">
                    {ministration.speaker}
                    <span class="mx-2 text-slate-400" aria-hidden="true">•</span>
                    {ministration.published}
                </p>

                <a
                    class="mt-auto inline-flex items-center gap-2 self-start text-base font-semibold text-sky-900 no-underline underline-offset-4 hover:underline focus-visible:underline"
                    href="#"
                >
                    Watch this ministration →
                </a>
            </div>
        </li>
    ))}
</CardRail>

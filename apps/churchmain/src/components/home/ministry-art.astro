---
interface Props { kind: "women" | "men" | "youth" | "children"; }
const { kind } = Astro.props;
const metalId = `metal-${kind}`;
const colorId = `color-${kind}`;
const shadowId = `shadow-${kind}`;
---

<svg viewBox="0 0 240 220" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id={metalId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fdfefd" /><stop offset=".24" stop-color="#b8bcb7" /><stop offset=".45" stop-color="#f9fbf7" /><stop offset=".65" stop-color="#858b82" /><stop offset="1" stop-color="#d6d9d0" />
        </linearGradient>
        <linearGradient id={colorId} x1="0" y1="0" x2=".9" y2="1">
            <stop offset="0" stop-color={kind === "men" ? "#7694ff" : "#ffde72"} /><stop offset=".5" stop-color={kind === "men" ? "#3158d8" : "#f2ca45"} /><stop offset="1" stop-color={kind === "men" ? "#173087" : "#c99c19"} />
        </linearGradient>
        <filter id={shadowId} x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="7" /></filter>
    </defs>
    <ellipse cx="120" cy="181" rx="60" ry="8" fill="#4d5040" opacity=".17" filter={`url(#${shadowId})`} />
    {kind === "women" && (
        <g transform="rotate(-23 120 110)">
            <ellipse cx="94" cy="101" rx="47" ry="64" fill="none" stroke={`url(#${metalId})`} stroke-width="21" />
            <ellipse cx="151" cy="125" rx="47" ry="64" fill="none" stroke={`url(#${colorId})`} stroke-width="21" />
            <path d="M 115 44 A 47 64 0 0 1 133 157" fill="none" stroke={`url(#${metalId})`} stroke-width="21" />
        </g>
    )}
    {kind === "men" && (
        <g transform="translate(2 -7) rotate(-12 120 110)">
            <path d="M45 144 81 163 198 137 161 119Z" fill="#19368d" />
            <path d="M45 113 81 131 81 163 45 144Z" fill="#3a5bc3" />
            <path d="M81 131 198 106 198 137 81 163Z" fill="#22469f" />
            <path d="M45 113 161 88 198 106 81 131Z" fill={`url(#${colorId})`} />
            <path d="M87 76 143 64 181 82 125 95 125 130 87 111Z" fill="#3158d8" />
            <path d="M125 95 181 82 181 116 125 130Z" fill="#22469f" />
            <path d="M87 76 143 64 181 82 125 95Z" fill="#6e91fb" />
            <path d="M115 38 152 30 184 47 149 55 149 86 115 69Z" fill={`url(#${metalId})`} />
            <path d="M149 55 184 47 184 78 149 86Z" fill="#969d99" />
        </g>
    )}
    {kind === "youth" && (
        <g transform="translate(120 104) rotate(12)">
            {Array.from({ length: 12 }, (_, index) => <rect x="-11" y="-81" width="22" height="64" rx="10" fill={`url(#${colorId})`} transform={`rotate(${index * 30})`} />)}
            <circle r="42" fill={`url(#${colorId})`} /><circle r="24" fill={`url(#${metalId})`} />
        </g>
    )}
    {kind === "children" && (
        <g transform="rotate(-12 120 110)">
            <rect x="44" y="47" width="72" height="72" rx="22" fill={`url(#${colorId})`} />
            <rect x="124" y="47" width="72" height="72" rx="22" fill="#6d87ce" />
            <rect x="44" y="127" width="72" height="72" rx="22" fill="#9faf83" />
            <rect x="124" y="127" width="72" height="72" rx="22" fill={`url(#${metalId})`} />
            <path d="M61 65h34M141 65h34M61 145h34M141 145h34" stroke="white" opacity=".45" stroke-width="3" stroke-linecap="round" />
            <circle cx="80" cy="83" r="12" fill="#fff9da" opacity=".7" /><path d="m152 72 20 11-20 11Z" fill="#e9eefb" /><path d="M67 163h26M80 150v26" stroke="#e9f4df" stroke-width="5" stroke-linecap="round" />
        </g>
    )}
</svg>

---
import { getLatestNewsletter, getNewsletterHref } from "../../data/newsletters";

const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
---

<section class="stay-connected" aria-labelledby="newsletter-heading">
    <div class="page-shell stay-connected__inner" data-reveal>
        <p class="stay-connected__orbit" aria-hidden="true">STAY CLOSE · STAY CLOSE · STAY CLOSE ·</p>
        <div>
            <p class="section-kicker section-kicker--dark">The week at Cornerstone</p>
            <h2 id="newsletter-heading">Don’t miss<br /><em>the good stuff.</em></h2>
        </div>
        <div class="stay-connected__copy">
            <p>Announcements, stories, event updates, and everything you need for the week ahead.</p>
            <a class="button button--ink" href={latestNewsletterHref}>
                Read the latest newsletter <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>

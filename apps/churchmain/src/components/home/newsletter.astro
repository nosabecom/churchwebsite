---
import { getLatestNewsletter, getNewsletterHref } from "../../data/newsletters";

const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
---

<section class="px-4 pb-16" aria-labelledby="newsletter-heading">
    <div class="mx-auto grid max-w-400 items-center gap-8 rounded-2xl bg-slate-50 p-8 text-slate-900 shadow-2xl shadow-sky-950/30 md:p-12 lg:grid-cols-2 lg:gap-16">
        <div>
            <p class="mb-4 text-xs font-extrabold tracking-[0.16em] text-red-700 uppercase">
                Stay in the loop
            </p>

            <h2 class="text-3xl leading-tight font-bold text-sky-900 md:text-4xl" id="newsletter-heading">
                Church news, straight to your inbox
            </h2>

            <p class="mt-4 text-lg leading-relaxed text-slate-700">
                Announcements, upcoming events, and any changes to our service times &mdash;
                so you never have to wonder what is happening this week.
            </p>

            <a
                class="mt-6 inline-block rounded-full bg-sky-900 px-6 py-3 font-semibold text-white hover:bg-sky-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-900"
                href={latestNewsletterHref}
            >View latest newsletter</a>
        </div>

        <div>
            <a
                class="inline-block rounded-full bg-red-600 px-8 py-3 text-lg font-semibold text-white hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red-600"
                href="/newsletters/#newsletter-preferences"
            >Subscribe or update preferences</a>

            <p class="mt-3 text-sm text-slate-600">
                Verify your email on our newsletter page, and we will safely match your request to Breeze.
            </p>
        </div>
    </div>
</section>

---
import { getLatestNewsletter, getNewsletterHref } from "../../data/newsletters";
import ArrowIcon from "../arrow-icon.astro";

const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
---

<section class="stay-connected page-shell" aria-labelledby="newsletter-heading">
    <div class="stay-connected__inner">
        <div class="stay-connected__copy">
            <p class="section-kicker">The Cornerstone Chronicle</p>
            <h2 id="newsletter-heading">A little closer.<br />A little more connected.</h2>
            <p>Church news, stories, and what’s ahead. A little of our life together, all in one place.</p>
            <a class="button button--ink" href={latestNewsletterHref}>Read the latest newsletter <span><ArrowIcon /></span></a>
        </div>
        <div class="newsletter-art" aria-hidden="true"><div class="newsletter-art__paper"><span>CORNERSTONE</span><i></i><i></i><i></i><b>Good news<br />travels.</b></div><div class="newsletter-art__envelope"></div><span class="newsletter-art__seal">C</span></div>
    </div>
</section>

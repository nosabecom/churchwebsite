---
import { getLatestNewsletter, getNewsletterHref } from "../../data/newsletters";
import ArrowIcon from "../arrow-icon.astro";
const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
---

<section class="stay-connected page-shell" aria-labelledby="newsletter-heading">
    <div class="stay-connected__inner">
        <div class="stay-connected__copy">
            <p class="section-kicker"><span>04</span> The Cornerstone Chronicle</p>
            <h2 id="newsletter-heading">Good news.<br /><span>Delivered.</span></h2>
            <p>Stories, updates, and what’s next in the life of our church—all in one joyful little read.</p>
            <a class="button button--light" href={latestNewsletterHref}>Read the latest issue <ArrowIcon /></a>
        </div>
        <div class="newsletter-art" aria-hidden="true">
            <div class="newsletter-art__orbit">NEW<br />ISSUE</div>
            <div class="newsletter-art__paper"><small>THE CORNERSTONE CHRONICLE</small><strong>Faith.<br />Family.<br /><em>Everyday life.</em></strong><span>Stories from our church family →</span></div>
        </div>
    </div>
</section>

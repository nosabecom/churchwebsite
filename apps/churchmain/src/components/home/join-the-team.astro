---
// Same lists as the "Who We Are" menu in the layout. No backend is wired up
// yet, so the form posts to itself and does nothing.
const ministries = ["Men's", "Women's", "Children", "Youths & Teenagers"];

const departments = [
    "Music",
    "Prayer",
    "Bible Study",
    "Evangelism",
    "Welfare",
    "Multimedia",
    "Sanctuary Helpers",
];

const chip = "rounded-full border border-white/25 px-4 py-2 text-base text-sky-100";
---

<section class="px-4 py-16" aria-labelledby="join-heading">
    <div class="mx-auto grid max-w-400 items-start gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
            <p class="mb-4 text-xs font-extrabold tracking-[0.16em] text-red-400 uppercase">
                Serve with us
            </p>

            <h2 class="text-4xl leading-tight font-bold text-white 2xl:text-5xl" id="join-heading">
                Join the team
            </h2>

            <p class="mt-6 text-lg leading-relaxed text-sky-100">
                Every Sunday takes a whole family: voices leading worship, hands setting up
                chairs, someone at the door with a smile. God has given you something the
                body needs, and there is room for it here. You do not need experience &mdash;
                only a willing heart. We will train you and walk with you.
            </p>

            <h3 class="mt-10 text-sm font-extrabold tracking-[0.16em] text-white uppercase">
                Ministries
            </h3>
            <ul class="mt-4 flex list-none flex-wrap gap-3 p-0">
                {ministries.map((ministry) => <li class={chip}>{ministry}</li>)}
            </ul>

            <h3 class="mt-8 text-sm font-extrabold tracking-[0.16em] text-white uppercase">
                Departments
            </h3>
            <ul class="mt-4 flex list-none flex-wrap gap-3 p-0">
                {departments.map((department) => <li class={chip}>{department}</li>)}
            </ul>
        </div>

        <div class="rounded-2xl bg-slate-50 p-8 text-slate-900 shadow-2xl shadow-sky-950/30 md:p-12">
            <h3 class="text-2xl leading-snug font-bold text-sky-900">Tell us where you would like to serve</h3>

            <p class="mt-3 text-base leading-relaxed text-slate-700">
                A department lead will get in touch to talk it through with you.
            </p>

            <form class="mt-8 flex flex-col gap-5" method="POST">
                <div class="form-field">
                    <label class="form-label" for="join-name">Full Name</label>
                    <input
                        class="form-input"
                        id="join-name"
                        name="fullname"
                        type="text"
                        autocomplete="name"
                        required
                        placeholder="e.g. Jane Doe"
                    />
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div class="form-field">
                        <label class="form-label" for="join-email">Email</label>
                        <input
                            class="form-input"
                            id="join-email"
                            name="email"
                            type="email"
                            autocomplete="email"
                            required
                            placeholder="you@example.com"
                        />
                    </div>
                    <div class="form-field">
                        <label class="form-label" for="join-phone">Phone</label>
                        <input
                            class="form-input"
                            id="join-phone"
                            name="phone"
                            type="tel"
                            autocomplete="tel"
                            placeholder="(555) 123-4567"
                        />
                    </div>
                </div>

                <div class="form-field">
                    <label class="form-label" for="join-team">Where would you like to serve?</label>
                    <select class="form-input" id="join-team" name="team" required>
                        <option value="" selected disabled>Choose a ministry or department</option>
                        <optgroup label="Ministries">
                            {ministries.map((ministry) => (
                                <option value={ministry}>{ministry}</option>
                            ))}
                        </optgroup>
                        <optgroup label="Departments">
                            {departments.map((department) => (
                                <option value={department}>{department}</option>
                            ))}
                        </optgroup>
                        <option value="Not sure yet">I am not sure yet &mdash; help me find a fit</option>
                    </select>
                </div>

                <div class="form-field">
                    <label class="form-label" for="join-about">Anything we should know?</label>
                    <textarea
                        class="form-input resize-y"
                        id="join-about"
                        name="about"
                        rows="5"
                        placeholder="Your availability, gifts, or any experience you already have"></textarea>
                </div>

                <button class="form-submit" type="submit">Count me in</button>
            </form>
        </div>
    </div>
</section>

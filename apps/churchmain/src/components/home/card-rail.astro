---
// Manually driven horizontal carousel. It never auto-scrolls and never wraps:
// the first card stays pinned to the left edge and there is nothing before it.
export interface Props {
    id: string;
    heading: string;
    description?: string;
    previousLabel: string;
    nextLabel: string;
    linkLabel: string;
    linkHref: string;
    class?: string;
}

const {
    id,
    heading,
    description,
    previousLabel,
    nextLabel,
    linkLabel,
    linkHref,
    class: className,
} = Astro.props;

// Ghost controls, matching the announcement panel arrows in the hero.
const arrow = "grid size-10 cursor-pointer place-items-center rounded-full border-0 bg-transparent text-sky-100 transition-colors hover:bg-white/10 hover:text-white focus-visible:bg-white/10 focus-visible:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 disabled:cursor-default disabled:text-sky-100/25 disabled:hover:bg-transparent disabled:hover:text-sky-100/25";
const chevron = "size-4.5 fill-none stroke-current stroke-[2.5] [stroke-linecap:round] [stroke-linejoin:round]";
---

<section class:list={["px-4 py-8", className]} aria-labelledby={`${id}-heading`}>
    <div
        class="mx-auto max-w-400"
        role="region"
        aria-roledescription="carousel"
        aria-labelledby={`${id}-heading`}
        data-card-rail
    >
        <header class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
            <div>
                <h2 class="text-4xl leading-tight font-bold text-white 2xl:text-5xl" id={`${id}-heading`}>
                    {heading}
                </h2>
                {description && (
                    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-sky-100">
                        {description}
                    </p>
                )}
            </div>

            <div class="flex items-center gap-4">
                <a
                    class="group inline-flex items-center gap-2 text-base font-semibold whitespace-nowrap text-white no-underline underline-offset-4 hover:underline focus-visible:underline"
                    href={linkHref}
                >
                    {linkLabel}
                    <span
                        class="transition-transform group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none"
                        aria-hidden="true"
                    >→</span>
                </a>

                <div class="flex items-center gap-1.5">
                    <button
                        class={arrow}
                        type="button"
                        aria-label={previousLabel}
                        aria-controls={`${id}-track`}
                        data-rail-prev
                        disabled
                    >
                        <svg class={chevron} viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m15 18-6-6 6-6" />
                        </svg>
                    </button>
                    <button
                        class={arrow}
                        type="button"
                        aria-label={nextLabel}
                        aria-controls={`${id}-track`}
                        data-rail-next
                    >
                        <svg class={chevron} viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <ul
            class="flex snap-x snap-mandatory list-none gap-6 overflow-x-auto scroll-smooth p-0 pb-4 scrollbar-none motion-reduce:scroll-auto [&::-webkit-scrollbar]:hidden"
            id={`${id}-track`}
            tabindex="0"
            data-rail-track
        >
            <slot />
        </ul>
    </div>
</section>

<script>
    document.querySelectorAll<HTMLElement>("[data-card-rail]").forEach((rail) => {
        const track = rail.querySelector<HTMLElement>("[data-rail-track]");
        const previous = rail.querySelector<HTMLButtonElement>("[data-rail-prev]");
        const next = rail.querySelector<HTMLButtonElement>("[data-rail-next]");
        if (!track) return;

        // One click moves by a single card, including the gap between cards.
        const step = () => {
            const cards = Array.from(track.children) as HTMLElement[];
            if (cards.length === 0) return track.clientWidth;
            if (cards.length > 1) return cards[1].offsetLeft - cards[0].offsetLeft;
            return cards[0].offsetWidth;
        };

        const sync = () => {
            const maxScroll = track.scrollWidth - track.clientWidth;
            // The leftmost card is the hard start of the rail, so "previous"
            // is unavailable there rather than looping to the end.
            if (previous) previous.disabled = track.scrollLeft <= 1;
            if (next) next.disabled = track.scrollLeft >= maxScroll - 1;
        };

        previous?.addEventListener("click", () => {
            track.scrollBy({ left: -step() });
        });
        next?.addEventListener("click", () => {
            track.scrollBy({ left: step() });
        });

        track.addEventListener("scroll", sync, { passive: true });
        window.addEventListener("resize", sync);
        sync();
    });
</script>

---
import { Image } from "astro:assets";
import ReubenAdeleye from "../../assets/pastors/reuben-adeleye.png";
import ToyinAdeleye from "../../assets/pastors/toyin-adeleye.jpg";
import ArrowIcon from "../arrow-icon.astro";

const firstSundaySteps = [
    {
        step: "01",
        icon: "door",
        title: "Arrive relaxed",
        copy: "Free parking right outside Millar Avenue, warm smiles at the door, and zero dress code—come just as you are.",
    },
    {
        step: "02",
        icon: "worship",
        title: "Vibrant worship & word",
        copy: "Expect joyful praise, heartfelt prayer, and practical scripture teaching that speaks into your Monday morning.",
    },
    {
        step: "03",
        icon: "family",
        title: "Room for every generation",
        copy: "Engaging spaces for children and youth, plus unhurried conversation and warm fellowship after service.",
    },
];
---

<section class="welcome-section page-shell" id="welcome" aria-labelledby="welcome-heading">
    <div class="welcome-grid">
        <div class="welcome-story" data-animate>
            <p class="section-kicker"><span>01</span> Welcome home</p>
            <h2 id="welcome-heading" class="section-title">
                Church shouldn’t feel like a performance—it should feel like{" "}
                <span class="highlight-word">
                    <em>family.</em>
                    <svg class="highlight-swoosh" viewBox="0 0 220 20" fill="none" aria-hidden="true" data-swoosh>
                        <path d="M4 14.5C58 4.5 148 3 216 12.5" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
                    </svg>
                </span>
            </h2>

            <div class="welcome-prose">
                <p class="welcome-lead">
                    At Cornerstone, we are building our lives on Jesus and carrying our faith into every ordinary day.
                </p>
                <p>
                    Whether church has always been part of your story or you are walking through church doors for the very first time, there is genuine warmth, honest community, and a seat saved for you here.
                </p>
            </div>

            <div class="welcome-actions">
                <a class="btn btn--navy" href="/new-to-church" data-magnetic>
                    <span>What to expect on Sunday</span>
                    <span class="btn__icon"><ArrowIcon /></span>
                </a>
                <a class="text-link" href="/contact">
                    <span>Ask a question or request prayer</span>
                    <ArrowIcon />
                </a>
            </div>
        </div>

        <div class="pastors-stage" aria-label="Our pastors">
            <div class="pastors-orbit" aria-hidden="true">
                <svg viewBox="0 0 140 140" class="orbit-svg">
                    <defs>
                        <path id="welcome-orbit-path" d="M 70, 70 m -50, 0 a 50,50 0 1,1 100,0 a 50,50 0 1,1 -100,0" />
                    </defs>
                    <text>
                        <textPath href="#welcome-orbit-path" startOffset="0%">
                            WARM WELCOME · SASKATOON · CORNERSTONE ·
                        </textPath>
                    </text>
                </svg>
                <span class="pastors-orbit__star">✦</span>
            </div>

            <div class="pastors-arches">
                <figure class="pastor-arch pastor-arch--reuben" data-animate data-tilt data-parallax="-0.03">
                    <div class="pastor-arch__frame">
                        <div class="pastor-arch__sheen" aria-hidden="true"></div>
                        <Image
                            class="pastor-arch__img pastor-arch__img--cutout"
                            src={ReubenAdeleye}
                            alt="Lead Pastor Reuben Adeleye smiling warmly"
                            widths={[320, 480, 640]}
                            sizes="(min-width: 900px) 22vw, 48vw"
                        />
                    </div>
                    <figcaption>
                        <span class="pastor-role">Lead Pastor</span>
                        <strong>Reuben Adeleye</strong>
                    </figcaption>
                </figure>

                <figure class="pastor-arch pastor-arch--toyin" data-animate data-delay="120" data-tilt data-parallax="0.04">
                    <div class="pastor-arch__frame">
                        <div class="pastor-arch__sheen" aria-hidden="true"></div>
                        <Image
                            class="pastor-arch__img"
                            src={ToyinAdeleye}
                            alt="Pastor Toyin Adeleye smiling warmly"
                            widths={[320, 480, 640]}
                            sizes="(min-width: 900px) 22vw, 48vw"
                        />
                    </div>
                    <figcaption>
                        <span class="pastor-role">Pastor</span>
                        <strong>Toyin Adeleye</strong>
                    </figcaption>
                </figure>
            </div>

            <blockquote class="pastors-quote" data-animate data-delay="180">
                <span class="pastors-quote__mark" aria-hidden="true">“</span>
                <p>We can’t wait to welcome you home this Sunday.</p>
                <footer>— Pastors Reuben &amp; Toyin Adeleye</footer>
            </blockquote>
        </div>
    </div>

    <div class="first-sunday" aria-label="What your first Sunday looks like">
        <div class="first-sunday__head" data-animate>
            <span class="detail-label">Planning your visit</span>
            <p>Three simple things to know before you walk in.</p>
        </div>

        <ol class="first-sunday__steps">
            {firstSundaySteps.map((item, idx) => (
                <li
                    class="step-card"
                    data-animate
                    data-delay={idx * 100}
                    data-spotlight
                >
                    <div class="step-card__top">
                        <span class="step-card__num">{item.step}</span>
                        <span class="step-card__line" aria-hidden="true"></span>
                        <span class="step-card__glyph" aria-hidden="true">
                            {item.icon === "door" && (
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 8h1a4 4 0 0 1 0 8h-1" />
                                    <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8Z" />
                                    <path d="M6 2v3M10 2v3M14 2v3" />
                                </svg>
                            )}
                            {item.icon === "worship" && (
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 3v18M5 8l7-5 7 5M4 17c2.5-1.5 5.5-1.5 8 0s5.5 1.5 8 0" />
                                </svg>
                            )}
                            {item.icon === "family" && (
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                                </svg>
                            )}
                        </span>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.copy}</p>
                </li>
            ))}
        </ol>
    </div>
</section>

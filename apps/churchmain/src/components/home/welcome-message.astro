---
import { Image } from "astro:assets";
import ReubenAdeleye from "../../assets/pastors/reuben-adeleye.png";
import ToyinAdeleye from "../../assets/pastors/toyin-adeleye.png";

const pastors = [
    { name: "Pst. Reuben Adeleye", image: ReubenAdeleye },
    { name: "Pst. Toyin Adeleye", image: ToyinAdeleye },
];
---

<section class="welcome-section" id="welcome" aria-labelledby="welcome-heading">
    <span class="welcome-ghost" aria-hidden="true">BELONG</span>
    <div class="welcome-orbit" aria-hidden="true"><span>YOU BELONG HERE · YOU BELONG HERE · </span></div>

    <div class="page-shell welcome-grid">
        <div class="welcome-heading-wrap" data-reveal>
            <p class="section-kicker">More than a Sunday</p>
            <h2 class="welcome-heading" id="welcome-heading">
                Don’t just attend.
                <em>Come alive.</em>
            </h2>
        </div>

        <div class="welcome-copy" data-reveal style="--reveal-delay: .12s">
            <p class="welcome-lead">
                Cornerstone is a family learning to live with purpose, walk in power,
                and make praise our everyday posture.
            </p>
            <p>
                Whether faith is familiar or you are asking your first questions, there
                is room to breathe, belong, and take your next step here. Come exactly as
                you are—we will save you a seat.
            </p>
            <a class="text-link" href="/new-to-church">
                Here for the first time? <span aria-hidden="true">→</span>
            </a>
        </div>

        <div class="pastors-composition" data-reveal style="--reveal-delay: .2s">
            <span class="pastors-composition__shape" aria-hidden="true"></span>
            {pastors.map((pastor, index) => (
                <figure class:list={["pastor-card", { "pastor-card--offset": index === 1 }]}>
                    <Image
                        class="pastor-card__image"
                        src={pastor.image}
                        alt={pastor.name}
                        widths={[300, 450, 600]}
                        sizes="(min-width: 1024px) 18rem, 42vw"
                    />
                    <figcaption>
                        <span>{String(index + 1).padStart(2, "0")}</span>
                        {pastor.name}
                    </figcaption>
                </figure>
            ))}
        </div>
    </div>

    <div class="belief-marquee" aria-hidden="true">
        <div>
            <span>PURPOSE</span><i>✦</i><span>POWER</span><i>✦</i><span>PRAISE</span><i>✦</i>
            <span>PURPOSE</span><i>✦</i><span>POWER</span><i>✦</i><span>PRAISE</span><i>✦</i>
        </div>
    </div>
</section>

---
// Welcome copy is a first draft and still needs sign-off from church leadership.
const gatherings = [
    {
        title: "Sunday Service",
        day: "Every Sunday",
        time: "9:00 AM",
        detail: "Worship, the Word, and children's church.",
    },
    {
        title: "Mid-week Service",
        day: "Every Wednesday",
        time: "7:00 PM",
        detail: "Prayer and Bible study together.",
    },
    {
        title: "Power Night",
        day: "Last Friday of the month",
        time: "10:00 PM",
        detail: "Our monthly vigil.",
    },
];
---

<section class="px-4 py-16" aria-labelledby="welcome-heading">
    <div class="mx-auto grid max-w-400 items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
            <p class="mb-4 text-xs font-extrabold tracking-[0.16em] text-red-400 uppercase">
                Welcome
            </p>

            <h2 class="text-4xl leading-tight font-bold text-white 2xl:text-5xl" id="welcome-heading">
                There is a place for you at Cornerstone
            </h2>

            <p class="mt-6 text-lg leading-relaxed text-sky-100">
                Whether you have walked with God for years or you are only starting to ask
                the questions, you are welcome exactly as you are. RCCG Cornerstone Assembly
                is a family in Saskatoon built on Jesus &mdash; the stone the builders
                rejected, who has become the cornerstone.
            </p>

            <p class="mt-4 text-lg leading-relaxed text-sky-100">
                When you visit you will find worship you can lose yourself in, teaching you
                can build a life on, and people who will know your name before you leave.
                Come early, stay after for coffee, and let us pray with you on your way out.
            </p>

            <a
                class="group mt-8 inline-flex items-center gap-2 text-base font-semibold text-white no-underline underline-offset-4 hover:underline focus-visible:underline"
                href="#"
            >
                More about who we are
                <span
                    class="transition-transform group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none"
                    aria-hidden="true"
                >→</span>
            </a>
        </div>

        <div class="overflow-hidden rounded-2xl bg-slate-50 p-8 text-slate-900 shadow-2xl shadow-sky-950/30 md:p-12">
            <p class="mb-6 text-xs font-extrabold tracking-[0.16em] text-red-700 uppercase">
                Worship with us
            </p>

            <ul class="list-none space-y-6 p-0">
                {gatherings.map((gathering) => (
                    <li class="border-b border-slate-200 pb-6 last:border-b-0 last:pb-0">
                        <h3 class="text-2xl leading-snug font-bold text-sky-900">{gathering.title}</h3>
                        <p class="mt-2 text-lg text-slate-700">
                            {gathering.day}
                            <span class="mx-2 text-slate-400" aria-hidden="true">•</span>
                            <span class="font-semibold text-slate-900">{gathering.time}</span>
                        </p>
                        <p class="mt-1 text-base text-slate-600">{gathering.detail}</p>
                    </li>
                ))}
            </ul>

            <address class="mt-8 text-lg leading-relaxed text-slate-700 not-italic">
                70-3904 Millar Avenue<br />
                Saskatoon, SK S7P 0B1
            </address>

            <a
                class="mt-4 inline-flex items-center gap-3 text-lg font-semibold text-red-600 no-underline underline-offset-4 hover:underline focus-visible:underline"
                href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1"
                target="_blank"
                rel="noreferrer"
            >
                <span
                    class="relative size-5 shrink-0 -rotate-45 rounded-[999px_999px_999px_0] bg-red-600 after:absolute after:inset-1.5 after:rounded-full after:bg-white"
                    aria-hidden="true"
                ></span>
                Find us on the map
            </a>
        </div>
    </div>
</section>

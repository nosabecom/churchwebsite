---
import Icon from "./icon.astro";
import type { Organization } from "../../data/organizations";
interface Props {
  organization: Organization;
}
const { organization } = Astro.props;
const directory = organization.kind === "ministry" ? "/ministries" : "/departments";
const label = organization.kind === "ministry" ? "ministries" : "teams";
---

<section class="organization-detail" aria-labelledby="organization-heading">
  <a class="organization-back" href={directory}>← Explore all {label}</a>
  <div class="organization-heading">
    <div>
      <p class="eyebrow">A PLACE TO GROW. A WAY TO BELONG.</p><h1 id="organization-heading">
        {organization.name}
      </h1><p>{organization.summary}</p>
    </div><span class="organization-symbol" aria-hidden="true"
      ><Icon name={organization.icon} class="size-24" /></span>
  </div>
  <div class="organization-body">
    <div>
      <h2>Life is better<br /><span>when we share it.</span></h2>{
        organization.description.map((paragraph) => <p>{paragraph}</p>)
      }<div class="organization-actions">
        <a class="c-button" href={`mailto:${organization.email}`}>Let’s get connected →</a>{
          organization.websiteUrl && (
            <a class="text-link" href={organization.websiteUrl} target="_blank" rel="noreferrer">
              {organization.websiteLabel ?? "Explore the ministry"} →
            </a>
          )
        }
      </div>
    </div><aside>
      <p class="eyebrow">YOUR NEXT STEP</p><h3>Come join us.</h3><dl>
        <div><dt>When we meet</dt><dd>{organization.meeting}</dd></div><div>
          <dt>Where</dt><dd>{organization.location}</dd>
        </div><div>
          <dt>Get in touch</dt><dd>
            <a href={`mailto:${organization.email}`}>{organization.email}</a>
          </dd>
        </div>
      </dl>
    </aside>
  </div>
  {
    organization.pictures.length > 0 && (
      <div class="organization-photos">
        {organization.pictures.map((picture) => (
          <figure>
            <img src={picture.src} alt={picture.alt} loading="lazy" />
            {picture.caption && <figcaption>{picture.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }
</section>
<style>
  .organization-detail {
    padding: 45px var(--gutter) 80px !important;
    background: var(--paper) !important;
  }
  .organization-back {
    font-size: 10px;
    text-decoration: none;
  }
  .organization-heading {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 35px;
    align-items: center;
    margin: 50px 0;
  }
  .organization-heading h1 {
    font-size: clamp(60px, 7.8vw, 115px) !important;
    margin: 20px 0 25px;
    max-width: 900px;
  }
  .organization-heading > div > p:last-child {
    font-size: 16px;
    line-height: 1.8;
    max-width: 600px;
  }
  .organization-symbol {
    display: grid;
    place-items: center;
    width: 180px;
    height: 180px;
    background: #e5ea6b;
  }
  .organization-body {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 10vw;
    border-top: 1px solid var(--line);
    padding-top: 50px;
  }
  .organization-body h2 {
    font: 600 56px/1 var(--display);
    margin: 0 0 30px;
  }
  .organization-body h2 span {
    color: var(--accent);
  }
  .organization-body > div > p {
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 18px;
    max-width: 500px;
  }
  .organization-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 15px 30px;
    margin-top: 30px;
    align-items: center;
  }
  .organization-body aside {
    background: var(--ink);
    color: var(--paper);
    padding: 35px;
  }
  .organization-body h3 {
    font: 600 44px var(--display);
    margin: 20px 0;
  }
  .organization-body dl > div {
    padding: 18px 0;
    border-top: 1px solid #ffffff40;
  }
  .organization-body dt {
    font-size: 9px;
    color: #e5ea6b;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }
  .organization-body dd {
    font-size: 12px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .organization-photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 60px;
  }
  .organization-photos img {
    width: 100%;
    height: 260px;
    object-fit: cover;
  }
  .organization-photos figcaption {
    font-size: 12px;
    margin-top: 10px;
  }
  @media (max-width: 700px) {
    .organization-heading {
      grid-template-columns: 1fr;
      margin: 35px 0;
    }
    .organization-symbol {
      width: 85px;
      height: 85px;
      grid-row: 1;
    }
    .organization-symbol svg {
      width: 45px;
      height: 45px;
    }
    .organization-heading h1 {
      font-size: 65px !important;
    }
    .organization-body {
      grid-template-columns: 1fr;
      gap: 35px;
      padding-top: 35px;
    }
    .organization-body h2 {
      font-size: 48px;
    }
    .organization-photos {
      grid-template-columns: 1fr;
    }
  }
</style>

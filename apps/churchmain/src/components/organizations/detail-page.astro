---
import Icon from "./icon.astro";
import type { Organization } from "../../data/organizations";

interface Props {
    organization: Organization;
}

const { organization } = Astro.props;
const isMinistry = organization.kind === "ministry";
const kindLabel = isMinistry ? "Ministry" : "Department";
const directoryLabel = isMinistry ? "Ministries" : "Departments";
const directoryPath = isMinistry ? "/ministries" : "/departments";
---

<div class="bg-slate-100">
    <section class="px-4 py-10 sm:py-14" aria-labelledby="organization-heading">
        <div class="mx-auto max-w-400">
            <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-600" aria-label="Breadcrumb">
                <a class="underline-offset-4 hover:text-sky-900 hover:underline" href="/">Home</a>
                <span aria-hidden="true">›</span>
                <a class="underline-offset-4 hover:text-sky-900 hover:underline" href={directoryPath}>{directoryLabel}</a>
                <span aria-hidden="true">›</span>
                <span class="font-semibold text-sky-900" aria-current="page">{organization.name}</span>
            </nav>

            <div class="mt-10 grid items-center gap-10 xl:grid-cols-[minmax(0,1fr)_22rem] xl:gap-16">
                <div class="grid items-center gap-7 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-9">
                    <span class="grid size-28 place-items-center rounded-full bg-sky-900 text-white shadow-xl shadow-sky-950/20 sm:size-34" aria-hidden="true">
                        <Icon name={organization.icon} class="size-12 sm:size-14" />
                    </span>

                    <div>
                        <p class="text-xs font-extrabold tracking-[0.16em] text-red-700 uppercase">{kindLabel}</p>
                        <h1 class="mt-3 text-4xl leading-[0.95] font-extrabold tracking-tight text-sky-900 sm:text-5xl lg:text-6xl" id="organization-heading">
                            {organization.name}
                        </h1>
                        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-700">{organization.summary}</p>

                        <div class="mt-7 flex flex-wrap gap-3">
                            <a class="inline-flex items-center justify-center rounded-lg bg-sky-900 px-5 py-3 text-sm font-bold text-white hover:bg-sky-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" href={`mailto:${organization.email}`}>
                                Contact the {organization.kind}
                            </a>

                            {organization.websiteUrl && (
                                <a
                                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-red-600 px-5 py-3 text-sm font-bold text-white hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
                                    href={organization.websiteUrl}
                                    target="_blank"
                                    rel="noreferrer"
                                >
                                    {organization.websiteLabel ?? "Visit website"}
                                    <Icon name="external" class="size-4" />
                                </a>
                            )}
                        </div>
                    </div>
                </div>

                <aside class="rounded-2xl bg-white p-7 shadow-xl shadow-sky-950/15" aria-labelledby="quick-details-heading">
                    <h2 class="text-xl font-extrabold text-sky-900" id="quick-details-heading">At a glance</h2>

                    <dl class="mt-6 space-y-5">
                        <div class="flex items-start gap-4">
                            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-sky-100 text-sky-900" aria-hidden="true">
                                <Icon name="clock" class="size-6" />
                            </span>
                            <div class="pt-0.5">
                                <dt class="font-bold text-slate-950">When we meet</dt>
                                <dd class="mt-1 text-slate-600">{organization.meeting}</dd>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-sky-100 text-sky-900" aria-hidden="true">
                                <Icon name="location" class="size-6" />
                            </span>
                            <div class="pt-0.5">
                                <dt class="font-bold text-slate-950">Where</dt>
                                <dd class="mt-1 text-slate-600">{organization.location}</dd>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-sky-100 text-sky-900" aria-hidden="true">
                                <Icon name="email" class="size-6" />
                            </span>
                            <div class="min-w-0 pt-0.5">
                                <dt class="font-bold text-slate-950">Email</dt>
                                <dd class="mt-1 break-words text-slate-600">{organization.email}</dd>
                            </div>
                        </div>
                    </dl>
                </aside>
            </div>
        </div>
    </section>

    <section class="bg-white px-4 py-14 sm:py-16" aria-labelledby="about-organization-heading">
        <div class="mx-auto max-w-400">
            <div class="max-w-3xl">
                <h2 class="text-3xl leading-tight font-extrabold text-sky-900 sm:text-4xl" id="about-organization-heading">
                    About the {organization.kind}
                </h2>

                <div class="mt-6 space-y-5 text-lg leading-relaxed text-slate-700">
                    {organization.description.map((paragraph) => <p>{paragraph}</p>)}
                </div>
            </div>
        </div>
    </section>

    <section class="px-4 py-14 sm:py-16" aria-labelledby="organization-pictures-heading">
        <div class="mx-auto max-w-400">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-extrabold tracking-[0.16em] text-red-700 uppercase">Gallery</p>
                    <h2 class="mt-2 text-3xl leading-tight font-extrabold text-sky-900 sm:text-4xl" id="organization-pictures-heading">
                        Pictures
                    </h2>
                </div>
                <p class="max-w-xl text-slate-600">A look at life in the {organization.name}.</p>
            </div>

            {organization.pictures.length > 0 ? (
                <ul class="mt-8 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
                    {organization.pictures.map((picture) => (
                        <li>
                            <figure class="overflow-hidden rounded-2xl bg-white shadow-lg shadow-sky-950/10">
                                <img
                                    class="aspect-4/3 w-full object-cover"
                                    src={picture.src}
                                    alt={picture.alt}
                                    loading="lazy"
                                    decoding="async"
                                />
                                {picture.caption && <figcaption class="px-5 py-4 text-sm text-slate-600">{picture.caption}</figcaption>}
                            </figure>
                        </li>
                    ))}
                </ul>
            ) : (
                <div class="mt-8 grid min-h-64 place-items-center rounded-2xl border-2 border-dashed border-sky-200 bg-white px-6 py-12 text-center">
                    <div>
                        <span class="mx-auto grid size-16 place-items-center rounded-full bg-sky-100 text-sky-900" aria-hidden="true">
                            <Icon name="image" class="size-8" />
                        </span>
                        <p class="mt-5 text-xl font-extrabold text-sky-900">Pictures coming soon</p>
                        <p class="mt-2 text-slate-600">Photos from this {organization.kind} will be added here.</p>
                    </div>
                </div>
            )}
        </div>
    </section>
</div>

---
import type { OrganizationIcon } from "../../data/organizations";

interface Props {
    name: OrganizationIcon | "clock" | "location" | "email" | "external" | "image";
    class?: string;
}

const { name, class: className = "size-8" } = Astro.props;
---

<svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    {name === "men" && (
        <>
            <circle cx="9" cy="7" r="3" />
            <path d="M3.5 19v-1.5A4.5 4.5 0 0 1 8 13h2a4.5 4.5 0 0 1 4.5 4.5V19" />
            <circle cx="17.5" cy="8.5" r="2.5" />
            <path d="M15.5 14.2a4 4 0 0 1 5 3.8v1" />
        </>
    )}
    {name === "women" && (
        <>
            <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.7A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" />
            <path d="M8.5 11.5c1.2.2 2.3-.2 3.5-1.5 1.2 1.3 2.3 1.7 3.5 1.5" />
        </>
    )}
    {name === "children" && (
        <>
            <circle cx="12" cy="12" r="8" />
            <path d="M9 10h.01M15 10h.01M8.8 14.2c1.8 2.1 4.6 2.1 6.4 0" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2" />
        </>
    )}
    {name === "youth" && <path d="m13 2-8 12h7l-1 8 8-12h-7l1-8Z" />}
    {name === "music" && (
        <>
            <path d="M9 18V5l11-2v13" />
            <circle cx="6" cy="18" r="3" />
            <circle cx="17" cy="16" r="3" />
        </>
    )}
    {name === "prayer" && (
        <>
            <path d="M8.5 11.5 6 9a2 2 0 0 0-3 2.6l4.8 6.2A5.5 5.5 0 0 0 12.2 20H15a5 5 0 0 0 5-5v-4.5a2 2 0 0 0-4 0V13" />
            <path d="m8.5 11.5 2 2M8.5 11.5V5a2 2 0 0 1 4 0v6M12.5 10V6a2 2 0 0 1 4 0v5" />
        </>
    )}
    {name === "bible" && (
        <>
            <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H11v18H6.5A2.5 2.5 0 0 0 4 22Z" />
            <path d="M20 4.5A2.5 2.5 0 0 0 17.5 2H13v18h4.5A2.5 2.5 0 0 1 20 22Z" />
            <path d="M8 7h1M15 7h2" />
        </>
    )}
    {name === "evangelism" && (
        <>
            <path d="m3 11 15-6v14L3 13Z" />
            <path d="M7 14v5h4v-3.4M18 9h3M18 15h3M18 12h4" />
        </>
    )}
    {name === "welfare" && (
        <>
            <path d="M12 21s-8-4.7-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.3-8 11-8 11Z" />
            <path d="M9 12h6M12 9v6" />
        </>
    )}
    {name === "multimedia" && (
        <>
            <rect x="3" y="4" width="18" height="14" rx="2" />
            <path d="m10 9 5 3-5 3ZM8 22h8M12 18v4" />
        </>
    )}
    {name === "sanctuary" && (
        <>
            <path d="M3 21h18M5 21V10l7-6 7 6v11" />
            <path d="M9 21v-6h6v6M12 4V1M10 2h4" />
        </>
    )}
    {name === "clock" && (
        <>
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
        </>
    )}
    {name === "location" && (
        <>
            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="2.5" />
        </>
    )}
    {name === "email" && (
        <>
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m4 7 8 6 8-6" />
        </>
    )}
    {name === "external" && (
        <>
            <path d="M15 4h5v5M20 4l-9 9" />
            <path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" />
        </>
    )}
    {name === "image" && (
        <>
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="8.5" cy="9" r="1.5" />
            <path d="m5 17 4.5-4.5 3.5 3 2.5-2.5 3.5 4" />
        </>
    )}
</svg>

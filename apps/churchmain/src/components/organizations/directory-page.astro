---
import Icon from "./icon.astro";
import type { Organization, OrganizationKind } from "../../data/organizations";
interface Props {
  kind: OrganizationKind;
  organizations: Organization[];
}
const { kind, organizations } = Astro.props;
const ministry = kind === "ministry";
const basePath = ministry ? "/ministries" : "/departments";
---

<section class="community-directory" aria-labelledby="directory-heading">
  <header>
    <p class="eyebrow">
      {ministry ? "FAITH GROWS IN GOOD COMPANY" : "YOUR GIFTS HAVE A HOME HERE"}
    </p><h1 id="directory-heading">
      {ministry ? "FIND YOUR" : "BRING YOUR"}<br /><span>{ministry ? "PEOPLE." : "PURPOSE."}</span>
    </h1><p>
      {
        ministry
          ? "A community for every season of life. Explore our ministries and find a place to grow, connect, and belong."
          : "There are many ways to be part of the life of our church. Explore the teams that serve our community."
      }
    </p>
  </header>
  <ul>
    {
      organizations.map((organization, i) => (
        <li>
          <a href={`${basePath}/${organization.slug}`}>
            <>
              <span class="directory-number">{String(i + 1).padStart(2, "0")}</span>
              <div class="directory-icon" aria-hidden="true">
                <Icon name={organization.icon} class="size-9" />
              </div>
              <h2>{organization.name}</h2>
              <p>{organization.summary}</p>
              <span class="directory-link">
                Meet the {kind}
                <svg
                  class="arrow-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M5 19 19 5M5 5h14v14" />
                </svg>
              </span>
            </>
          </a>
        </li>
      ))
    }
  </ul>
</section>
<style>
  .community-directory {
    padding: 75px var(--gutter) !important;
    background: var(--paper) !important;
  }
  .community-directory header {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 25px 12vw;
    align-items: end;
    margin-bottom: 55px;
  }
  .community-directory header > .eyebrow {
    grid-column: 1/-1;
  }
  .community-directory h1 {
    font-size: clamp(80px, 9vw, 135px) !important;
    margin: 0;
  }
  .community-directory h1 span {
    color: var(--accent);
  }
  .community-directory header > p:not(.eyebrow) {
    font-size: 14px;
    line-height: 1.9;
    max-width: 350px;
    margin: 0;
  }
  .community-directory ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 0;
    list-style: none;
  }
  .community-directory li > a {
    display: flex;
    flex-direction: column;
    background: #e9eadf;
    padding: 30px;
    min-height: 345px;
    position: relative;
    text-decoration: none;
    transition: transform 0.25s;
  }
  .community-directory li:nth-child(3n + 2) > a {
    background: #d7dfbf;
  }
  .community-directory li:nth-child(3n) > a {
    background: var(--ink);
    color: var(--paper);
  }
  .community-directory li > a:hover {
    transform: translateY(-5px);
  }
  .directory-number {
    position: absolute;
    right: 25px;
    top: 25px;
    font-size: 10px;
  }
  .directory-icon {
    margin: 5px 0 35px;
  }
  .community-directory h2 {
    font: 600 35px/1.1 var(--display);
    margin: 0 0 16px;
  }
  .community-directory li p {
    font-size: 12px;
    line-height: 1.8;
    margin: 0 0 30px;
  }
  .directory-link {
    border-top: 1px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 15px;
    font-size: 10px;
    margin-top: auto;
  }
  .directory-link svg {
    font-size: 23px;
  }
  @media (max-width: 1000px) {
    .community-directory ul {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 700px) {
    .community-directory {
      padding: 45px var(--gutter) !important;
    }
    .community-directory header {
      grid-template-columns: 1fr;
      gap: 25px;
      margin-bottom: 35px;
    }
    .community-directory h1 {
      font-size: 23vw !important;
    }
    .community-directory ul {
      grid-template-columns: 1fr;
    }
    .community-directory li > a {
      min-height: 290px;
    }
  }
</style>

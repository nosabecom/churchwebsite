---
import {
  getSanityImageDimensions,
  getSanityImageUrl,
} from "../../data/sanity-image";

interface Props {
  node: {
    alt?: string;
    decorative?: boolean;
    asset?: { _ref?: string } | null;
    crop?: unknown;
    hotspot?: unknown;
    dimensions?: {
      width?: number;
      height?: number;
    };
  };
}

const BODY_IMAGE_WIDTH = 1200;

const { node } = Astro.props as Props;
const alt = node.decorative ? "" : (node.alt ?? "");
const url = getSanityImageUrl(node, { width: BODY_IMAGE_WIDTH });
const dimensions = getSanityImageDimensions(node, {
  width: BODY_IMAGE_WIDTH,
});
---

{
  url ? (
    <img
      src={url}
      alt={alt}
      width={dimensions.width}
      height={dimensions.height}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <figure
      class="my-6 rounded-lg border border-slate-300 bg-slate-100 px-4 py-8 text-center text-sm text-slate-600"
      aria-label="Image unavailable"
    >
      Image unavailable
    </figure>
  )
}

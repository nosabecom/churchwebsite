---
interface Props { direction?: "out" | "right" | "down"; }
const { direction = "out" } = Astro.props;
const path = direction === "right"
    ? "M5 12h14m-6-6 6 6-6 6"
    : direction === "down"
      ? "m6 6 12 12M6 18h12V6"
      : "M6 18 18 6M6 6h12v12";
---

<svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={path} /></svg>

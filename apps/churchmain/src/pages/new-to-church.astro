---
import Layout from "../layouts/layout.astro";

const configuredUrl = import.meta.env.PUBLIC_NEW_TO_CHURCH_FORM_URL?.trim();
let formUrl: string | undefined;

if (configuredUrl) {
  try {
    const url = new URL(configuredUrl);
    const isBreezeForm =
      url.protocol === "https:" &&
      url.hostname.endsWith(".breezechms.com") &&
      url.pathname.startsWith("/form/");

    if (isBreezeForm) {
      formUrl = url.toString();
    }
  } catch {
    // An invalid value falls through to the friendly setup state below.
  }
}
---

<Layout
  title="New to Church? | RCCG Cornerstone Assembly"
  description="Connect with RCCG Cornerstone Assembly in Saskatoon. Tell us a little about yourself and how we can welcome you."
>
  <section class="visit-opening">
    <div>
      <p class="eyebrow">YOUR FIRST SUNDAY STARTS HERE</p><h1>
        NEW HERE?<br /><span>WELCOME HOME.</span>
      </h1><p>
        You don’t need to know all the words or have all the answers. Come as you are. We’d love to
        meet you.
      </p><a class="c-button" href="#visit-connect"
        >Let’s get connected <span aria-hidden="true">→</span></a>
    </div><figure>
      <img
        src="/images/community/prayer.jpg"
        alt="Members of Cornerstone Assembly praying together"
        width="1600"
        height="1067"
      /><figcaption>Faith. Family. A fresh start.</figcaption>
    </figure>
  </section>
  <section class="visit-details">
    <div>
      <p class="eyebrow">WHEN WE GATHER</p><h2>MAKE ROOM<br />FOR SUNDAY.</h2><dl>
        <div><dt>Sunday service</dt><dd>9:00 AM</dd></div><div>
          <dt>Wednesday service</dt><dd>7:00 PM</dd>
        </div><div><dt>Power Night · Last Friday</dt><dd>10:00 PM</dd></div>
      </dl>
    </div><div>
      <p class="eyebrow">FIND YOUR WAY HERE</p><h2>RIGHT HERE.<br />IN SASKATOON.</h2><address>
        70-3904 Millar Avenue<br />Saskatoon, SK S7P 0B1
      </address><a
        class="text-link"
        href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1"
        target="_blank"
        rel="noreferrer">Open directions →</a>
    </div>
  </section>
  <section class="visit-questions">
    <p class="eyebrow">A FEW THINGS YOU MIGHT BE WONDERING</p><h2>
      A LITTLE LESS UNKNOWN.<br /><span>A LOT MORE WELCOME.</span>
    </h2><div>
      <details>
        <summary>What happens on a Sunday?</summary><p>
          We gather for worship, prayer, fellowship, and a message from God’s Word. Our Sunday
          service begins at 9:00 AM.
        </p>
      </details><details>
        <summary>Is there a place for my family?</summary><p>
          Yes. Our church has ministries for children, youths and teenagers, men, and women. <a
            href="/ministries">Explore our ministries</a
          >, or contact us with questions about your family’s first visit.
        </p>
      </details><details>
        <summary>Can I speak with someone before I come?</summary><p>
          Of course. <a href="/contact">Get in touch with our team</a> or email connect@rccgcornerstoneassembly.com.
          We’d love to help you feel at home.
        </p>
      </details>
    </div>
  </section>
  <section class="visit-connect" id="visit-connect">
    <div>
      <p class="eyebrow">TAKE THE FIRST STEP</p><h2>
        LET’S MAKE<br /><span>A CONNECTION.</span>
      </h2><p>Tell us a little about yourself and our team will help you get connected.</p>
    </div><div>
      {
        formUrl ? (
          <iframe
            class="visit-form"
            src={formUrl}
            title="New to Cornerstone connection form"
            loading="lazy"
          />
        ) : (
          <div class="visit-email">
            <>
              <h3>We’d love to meet you.</h3>
              <p>
                Email our team before your visit. We’re here to answer your questions and help you
                find your place.
              </p>
              <a class="c-button" href="mailto:connect@rccgcornerstoneassembly.com">
                Say hello by email →
              </a>
            </>
          </div>
        )
      }
    </div>
  </section>
</Layout>
<style>
  .visit-opening {
    padding: 70px var(--gutter) !important;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 5vw;
    background: var(--paper) !important;
    align-items: center;
  }
  .visit-opening h1 {
    font-size: clamp(66px, 7.7vw, 115px) !important;
    margin: 25px 0;
  }
  .visit-opening h1 span {
    color: var(--accent);
  }
  .visit-opening p:not(.eyebrow) {
    max-width: 365px;
    font-size: 14px;
    line-height: 1.9;
    margin-bottom: 25px;
  }
  .visit-opening figure {
    margin: 0;
    position: relative;
  }
  .visit-opening img {
    width: 100%;
    height: 450px;
    object-fit: cover;
  }
  .visit-opening figcaption {
    position: absolute;
    bottom: 20px;
    left: 20px;
    padding: 12px;
    background: var(--paper);
    font-size: 10px;
  }
  .visit-details {
    padding: 65px var(--gutter) !important;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10vw;
    background: var(--ink) !important;
    color: var(--paper);
  }
  .visit-details h2,
  .visit-questions h2,
  .visit-connect h2 {
    font: 700 clamp(45px, 4.5vw, 65px)/1 var(--display);
    margin: 25px 0;
  }
  .visit-details dl {
    margin-top: 30px;
  }
  .visit-details dl > div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid #ffffff33;
    font-size: 12px;
  }
  .visit-details dd {
    color: #e5ea6b;
  }
  .visit-details address {
    font-size: 17px;
    line-height: 1.8;
    font-style: normal;
  }
  .visit-questions {
    padding: 75px var(--gutter) !important;
    background: var(--paper) !important;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 7vw;
  }
  .visit-questions > .eyebrow {
    grid-column: 1/-1;
  }
  .visit-questions h2 {
    margin: 0;
  }
  .visit-questions h2 > span,
  .visit-connect h2 > span {
    color: var(--accent);
  }
  .visit-questions details {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .visit-questions summary {
    font-size: 14px;
    cursor: pointer;
  }
  .visit-questions details p {
    font-size: 13px;
    line-height: 1.9;
    margin-top: 20px;
    overflow-wrap: anywhere;
  }
  .visit-questions details a {
    text-decoration: underline;
  }
  .visit-connect {
    padding: 65px var(--gutter) !important;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7vw;
    background: #e9eadf !important;
  }
  .visit-connect p {
    font-size: 13px;
    line-height: 1.8;
    max-width: 360px;
  }
  .visit-connect .eyebrow {
    font-size: 9px;
  }
  .visit-email {
    padding: 35px;
    background: var(--paper);
  }
  .visit-email h3 {
    font: 600 35px var(--display);
    margin: 0 0 15px;
  }
  .visit-email .c-button {
    margin-top: 25px;
  }
  .visit-form {
    width: 100%;
    min-height: 1200px;
    background: white;
    border: 0;
  }
  @media (max-width: 700px) {
    .visit-opening,
    .visit-details,
    .visit-questions,
    .visit-connect {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 45px var(--gutter) !important;
    }
    .visit-opening h1 {
      font-size: 18vw !important;
    }
    .visit-opening img {
      height: 310px;
    }
    .visit-questions h2 {
      font-size: 43px;
    }
    .visit-email {
      padding: 25px;
    }
  }
</style>

---
import Layout from "../layouts/layout.astro";
import { ContactPanel } from "@churchwebsite/ui";
---

<Layout
  title="Let’s connect | RCCG Cornerstone Assembly"
  description="Ask a question, share a prayer request, or get connected with Cornerstone Assembly in Saskatoon."
>
  <section class="contact-page">
    <div class="contact-intro">
      <p class="eyebrow">YOU DON’T HAVE TO WALK ALONE</p><h1>LET’S<br /><span>CONNECT.</span></h1><p
      >
        A question, a prayer, a story to share. Whatever brings you here, we’d love to hear from
        you.
      </p><a href="mailto:connect@rccgcornerstoneassembly.com"
        >connect@rccgcornerstoneassembly.com</a
      ><div class="contact-location">
        <p class="eyebrow">OR COME SAY HELLO</p><address>
          70-3904 Millar Avenue<br />Saskatoon, SK S7P 0B1
        </address><p>Sundays at 9:00 AM</p><a href="/new-to-church">Plan your first visit →</a>
      </div>
    </div>
    <ContactPanel />
  </section>
</Layout>
<style>
  .contact-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    padding: 80px var(--gutter) !important;
    background: var(--paper) !important;
  }
  .contact-intro h1 {
    font-size: clamp(80px, 9vw, 135px) !important;
    margin: 25px 0;
  }
  .contact-intro h1 span {
    color: var(--accent);
  }
  .contact-intro > p:not(.eyebrow) {
    max-width: 350px;
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 25px;
  }
  .contact-intro > a {
    font-size: 11px;
    overflow-wrap: anywhere;
    border-bottom: 1px solid currentColor;
    padding-bottom: 7px;
  }
  .contact-location {
    margin-top: 50px;
    border-top: 1px solid var(--line);
    padding-top: 25px;
  }
  .contact-location address {
    font-size: 14px;
    line-height: 1.8;
    font-style: normal;
    margin-top: 16px;
  }
  .contact-location > p:not(.eyebrow),
  .contact-location > a {
    font-size: 12px;
    margin-top: 15px;
    display: block;
  }
  @media (max-width: 800px) {
    .contact-page {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 45px var(--gutter) !important;
    }
    .contact-intro h1 {
      font-size: 88px !important;
    }
    .contact-location {
      margin-top: 30px;
    }
  }
</style>

---
import Layout from "../../layouts/layout.astro";
import { messages, series, speakers, years } from "../../data/messages";

const latest = messages[0];
---

<Layout
    title="Message Archive | RCCG Cornerstone Assembly"
    description="Search the complete archive of Sunday messages from RCCG Cornerstone Assembly."
>
    <div class="mx-auto mt-8 mb-26 max-w-[93.75rem] overflow-hidden rounded-[1.125rem] bg-slate-50 shadow-[0_1.75rem_4.5rem_rgb(8_47_73_/_45%)] max-lg:mx-4 max-lg:mt-5 max-lg:mb-18 max-[35rem]:mx-3">
        <header class="grid grid-cols-[1.2fr_0.8fr] items-end gap-15 bg-sky-950 p-[clamp(3.25rem,7vw,5.75rem)] text-white max-lg:grid-cols-1 max-lg:gap-9 max-[35rem]:px-6 max-[35rem]:py-13">
            <div>
                <p class="m-0 text-[0.7rem] font-extrabold tracking-[0.16em] text-rose-300 uppercase">Cornerstone messages</p>
                <h1 class="mt-3 mb-0 text-[clamp(4.25rem,8vw,7.25rem)] leading-[0.85] font-bold tracking-[-0.06em] max-[35rem]:text-[3.65rem]">Sunday by Sunday.</h1>
            </div>
            <p class="m-0 max-w-132 text-xl leading-[1.65] text-sky-200">Follow the teaching life of our church—from the latest service back through every season.</p>
        </header>

        <article class="grid grid-cols-[7rem_minmax(0,1fr)_auto] items-center gap-[1.8rem] bg-red-600 px-[clamp(2rem,7vw,5.75rem)] py-7 text-white max-[35rem]:grid-cols-[minmax(0,1fr)_auto] max-[35rem]:px-[1.4rem] max-[35rem]:py-[1.6rem]">
            <time class="flex items-center gap-3 border-r border-white/30 max-[35rem]:hidden" datetime={latest.isoDate}>
                <b class="text-[3.6rem] leading-none">03</b>
                <span class="text-[0.65rem] leading-[1.45] font-extrabold tracking-[0.12em]">AUG<br />2026</span>
            </time>
            <div>
                <p class="m-0 text-[0.7rem] font-extrabold tracking-[0.16em] text-rose-200 uppercase">Latest Sunday</p>
                <h2 class="my-[0.3rem] text-[2.5rem] leading-none font-bold max-[35rem]:text-[1.9rem]">{latest.title}</h2>
                <p class="m-0 text-red-100">{latest.speaker} · {latest.scripture}</p>
            </div>
            <a
                class="grid size-17 shrink-0 place-items-center rounded-full bg-white text-red-600 no-underline hover:bg-sky-900 hover:text-white focus-visible:bg-sky-900 focus-visible:text-white max-[35rem]:size-14"
                href={`/messages/${latest.slug}`}
                aria-label={`Open ${latest.title}`}
            >
                <svg class="w-6 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" /></svg>
            </a>
        </article>

        <section class="mx-auto max-w-304 p-[clamp(3rem,6vw,5rem)] max-[35rem]:px-5 max-[35rem]:py-[2.8rem]" aria-labelledby="archive-heading">
            <header>
                <p class="m-0 text-[0.7rem] font-extrabold tracking-[0.16em] text-red-700 uppercase">The complete timeline</p>
                <h2 class="mt-2 mb-9 text-[clamp(2.75rem,5vw,4.2rem)] leading-none font-bold text-sky-900" id="archive-heading">Browse every Sunday</h2>
            </header>

            <div class="grid grid-cols-[minmax(17rem,1.6fr)_repeat(3,minmax(10rem,0.7fr))] gap-[0.65rem] max-lg:grid-cols-2 max-[35rem]:grid-cols-1">
                <label class="col-span-full flex min-w-0 items-center gap-[0.65rem] rounded-[0.65rem] border border-slate-300 bg-white px-4 text-slate-500 focus-within:border-sky-900 focus-within:ring-[3px] focus-within:ring-sky-500/20 lg:col-span-1">
                    <span class="sr-only">Search messages</span>
                    <svg class="w-[1.1rem] shrink-0 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                    <input class="w-full min-w-0 border-0 bg-transparent py-[1.05rem] text-slate-900 outline-0 placeholder:text-slate-400" data-message-search type="search" placeholder="Search title, speaker, series, or scripture" />
                </label>

                <label class="relative grid min-w-0 gap-[0.35rem] rounded-[0.65rem] border border-slate-300 bg-white px-[1.1rem] pt-3 pb-[0.8rem] text-left focus-within:border-sky-900 focus-within:ring-[3px] focus-within:ring-sky-500/20">
                    <span class="m-0 w-full p-0 text-left text-[0.65rem] leading-none font-extrabold tracking-[0.14em] text-slate-500 uppercase">Series</span>
                    <select class="m-0 w-full appearance-none border-0 bg-transparent p-0 pr-8 text-left text-base leading-5 font-bold text-slate-900 outline-0 [text-indent:0]" data-message-series>
                        <option value="">All series</option>
                        {series.map((name) => <option value={name}>{name}</option>)}
                    </select>
                    <svg class="pointer-events-none absolute right-[1.1rem] bottom-[1.15rem] size-[0.65rem] fill-none stroke-slate-900" viewBox="0 0 12 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 4 4 4-4" /></svg>
                </label>

                <label class="relative grid min-w-0 gap-[0.35rem] rounded-[0.65rem] border border-slate-300 bg-white px-[1.1rem] pt-3 pb-[0.8rem] text-left focus-within:border-sky-900 focus-within:ring-[3px] focus-within:ring-sky-500/20">
                    <span class="m-0 w-full p-0 text-left text-[0.65rem] leading-none font-extrabold tracking-[0.14em] text-slate-500 uppercase">Speaker</span>
                    <select class="m-0 w-full appearance-none border-0 bg-transparent p-0 pr-8 text-left text-base leading-5 font-bold text-slate-900 outline-0 [text-indent:0]" data-message-speaker>
                        <option value="">All speakers</option>
                        {speakers.map((name) => <option value={name}>{name}</option>)}
                    </select>
                    <svg class="pointer-events-none absolute right-[1.1rem] bottom-[1.15rem] size-[0.65rem] fill-none stroke-slate-900" viewBox="0 0 12 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 4 4 4-4" /></svg>
                </label>

                <label class="relative grid min-w-0 gap-[0.35rem] rounded-[0.65rem] border border-slate-300 bg-white px-[1.1rem] pt-3 pb-[0.8rem] text-left focus-within:border-sky-900 focus-within:ring-[3px] focus-within:ring-sky-500/20">
                    <span class="m-0 w-full p-0 text-left text-[0.65rem] leading-none font-extrabold tracking-[0.14em] text-slate-500 uppercase">Year</span>
                    <select class="m-0 w-full appearance-none border-0 bg-transparent p-0 pr-8 text-left text-base leading-5 font-bold text-slate-900 outline-0 [text-indent:0]" data-message-year>
                        <option value="">All years</option>
                        {years.map((year) => <option value={year}>{year}</option>)}
                    </select>
                    <svg class="pointer-events-none absolute right-[1.1rem] bottom-[1.15rem] size-[0.65rem] fill-none stroke-slate-900" viewBox="0 0 12 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 4 4 4 4-4" /></svg>
                </label>
            </div>

            <div class="flex items-center justify-between px-[0.3rem] pt-[1.35rem] pb-3 text-xs text-slate-500">
                <p class="m-0"><b class="text-sky-900" data-message-count>{messages.length}</b> messages</p>
                <span>Newest first</span>
            </div>

            <div class="border-b border-slate-300">
                {messages.map((message, index) => (
                    <article
                        class="grid grid-cols-[3.25rem_minmax(0,1fr)_8rem_2.5rem] items-center gap-5 border-t border-slate-300 px-1 py-6 max-[35rem]:grid-cols-[2rem_minmax(0,1fr)_2.5rem] max-[35rem]:gap-[0.65rem]"
                        data-message-row
                        data-search={`${message.title} ${message.speaker} ${message.series} ${message.scripture}`.toLowerCase()}
                        data-series={message.series}
                        data-speaker={message.speaker}
                        data-year={message.isoDate.slice(0, 4)}
                    >
                        <span class="text-xs text-slate-500">{String(index + 1).padStart(2, "0")}</span>
                        <div>
                            <p class="m-0 text-[0.7rem] font-extrabold tracking-[0.16em] text-red-700 uppercase">{message.series}</p>
                            <h3 class="mt-[0.35rem] mb-2 text-[clamp(1.65rem,2.5vw,2.15rem)] leading-none font-bold text-sky-900 max-[35rem]:text-[1.55rem]">{message.title}</h3>
                            <p class="m-0 flex flex-wrap gap-[0.45rem] text-slate-500">{message.speaker} <i class="font-normal text-slate-300 not-italic" aria-hidden="true">·</i> {message.scripture}</p>
                        </div>
                        <time class="text-right max-[35rem]:hidden" datetime={message.isoDate}>
                            <b class="block text-[0.78rem] text-slate-600">{message.date}</b>
                            <span class="mt-[0.35rem] block text-xs text-slate-400">{message.duration}</span>
                        </time>
                        <a
                            class="grid size-10 shrink-0 place-items-center rounded-full bg-sky-100 text-sky-900 no-underline hover:bg-sky-900 hover:text-white focus-visible:bg-sky-900 focus-visible:text-white"
                            href={`/messages/${message.slug}`}
                            aria-label={`Open ${message.title}`}
                        >
                            <svg class="w-[1.1rem] fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                        </a>
                    </article>
                ))}
            </div>

            <div class="mt-6 hidden rounded-xl border-2 border-dashed border-slate-300 px-6 py-16 text-center" data-message-empty>
                <h3 class="m-0 text-[1.75rem] font-bold text-sky-900">No messages found</h3>
                <p class="mt-2 mb-0 text-slate-500">Try another title, speaker, series, scripture, or year.</p>
            </div>
        </section>
    </div>

    <script>
        const search = document.querySelector<HTMLInputElement>("[data-message-search]");
        const series = document.querySelector<HTMLSelectElement>("[data-message-series]");
        const speaker = document.querySelector<HTMLSelectElement>("[data-message-speaker]");
        const year = document.querySelector<HTMLSelectElement>("[data-message-year]");
        const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-message-row]"));
        const count = document.querySelector<HTMLElement>("[data-message-count]");
        const empty = document.querySelector<HTMLElement>("[data-message-empty]");

        const filterMessages = () => {
            const query = search?.value.trim().toLowerCase() ?? "";
            let visible = 0;

            rows.forEach((row) => {
                const matches = (row.dataset.search ?? "").includes(query)
                    && (!series?.value || row.dataset.series === series.value)
                    && (!speaker?.value || row.dataset.speaker === speaker.value)
                    && (!year?.value || row.dataset.year === year.value);

                row.classList.toggle("hidden", !matches);
                if (matches) visible += 1;
            });

            if (count) count.textContent = String(visible);
            empty?.classList.toggle("hidden", visible !== 0);
        };

        search?.addEventListener("input", filterMessages);
        series?.addEventListener("change", filterMessages);
        speaker?.addEventListener("change", filterMessages);
        year?.addEventListener("change", filterMessages);
    </script>
</Layout>

---
import { render } from "astro:content";
import Layout from "../../layouts/layout.astro";
import PortableText from "../../components/newsletters/portable-text.astro";
import {
    getNewsletters,
    isExternalNewsletterLink,
    type Newsletter,
} from "../../data/newsletters";

export async function getStaticPaths() {
    const newsletters = await getNewsletters();

    return newsletters.map((newsletter) => ({
        params: { slug: newsletter.slug },
        props: { newsletter },
    }));
}

interface Props {
    newsletter: Newsletter;
}

const { newsletter } = Astro.props as Props;
const Content = newsletter.source === "markdown"
    ? (await render(newsletter.entry)).Content
    : undefined;
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-CA", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
}).format(date);
const isExternal = newsletter.relatedLink
    ? isExternalNewsletterLink(newsletter.relatedLink.href)
    : false;
---

<Layout title={`${newsletter.seo.title} | RCCG Cornerstone Assembly`} description={newsletter.seo.description}>
    <article class="bg-white">
        <header class="border-b border-slate-300 bg-slate-50">
            <div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-4 py-12 md:px-8 md:py-20 lg:grid-cols-[1fr_0.8fr]">
                <div class="order-2 lg:order-1">
                    <a class="text-xs font-extrabold tracking-[0.16em] text-red-700 uppercase hover:text-red-600" href="/newsletters">← All newsletters</a>
                    <p class="mt-8 text-xs font-extrabold tracking-[0.18em] text-red-700 uppercase">
                        {newsletter.issue ? `Issue ${String(newsletter.issue).padStart(2, "0")}` : "Newsletter"}
                    </p>
                    <h1 class="newsletter-serif mt-3 text-5xl leading-none text-balance text-sky-950 md:text-7xl">{newsletter.title}</h1>
                    <time class="mt-5 block text-xs font-bold tracking-[0.16em] text-slate-500 uppercase" datetime={newsletter.publishedAt.toISOString()}>
                        {formatDate(newsletter.publishedAt)}
                    </time>
                    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-slate-700">{newsletter.excerpt}</p>
                </div>

                <div class="order-1 aspect-[4/3] overflow-hidden rounded-2xl bg-sky-950 lg:order-2 lg:aspect-[3/4]">
                    {newsletter.coverImage ? (
                        <img src={newsletter.coverImage.url} alt={newsletter.coverImage.alt} width={newsletter.coverImage.width} height={newsletter.coverImage.height} class="h-full w-full object-cover" />
                    ) : (
                        <div class="relative grid h-full place-items-center overflow-hidden p-8 text-center text-white">
                            <div class="absolute -right-20 top-12 size-64 rounded-full border-[2.5rem] border-white/15"></div>
                            <p class="newsletter-serif relative text-5xl leading-none md:text-6xl">{newsletter.title}</p>
                        </div>
                    )}
                </div>
            </div>
        </header>

        <div class="mx-auto w-full max-w-3xl px-4 py-14 md:px-8 md:py-20">
            <div class="newsletter-prose">
                {newsletter.source === "sanity"
                    ? <PortableText value={newsletter.body} />
                    : Content && <Content />}
            </div>

            {newsletter.relatedLink && (
                <p class="mt-12 border-t border-slate-300 pt-8">
                    <a
                        class="inline-block rounded-full border-2 border-sky-900 px-7 py-3 font-bold text-sky-900 transition-colors hover:bg-sky-900 hover:text-white"
                        href={newsletter.relatedLink.href}
                        target={isExternal ? "_blank" : undefined}
                        rel={isExternal ? "noopener noreferrer" : undefined}
                    >{newsletter.relatedLink.label}</a>
                </p>
            )}
        </div>
    </article>
</Layout>

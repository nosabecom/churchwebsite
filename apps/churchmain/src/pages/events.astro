        color: #0c4a6e;
        font-size: .85rem;
        font-weight: 850;
        text-underline-offset: .2rem;
    }

    .event-list-row > a:hover,
    .event-list-row > a:focus-visible {
        text-decoration: underline;
    }

    .event-empty-state {
        border-block: 1px solid #cbd5e1;
        padding: 3rem 0;
        color: #475569;
    }

    .event-empty-state h2 {
        margin: 0 0 .5rem;
        color: #082f49;
    }

    [data-event-filter-item][hidden],
    [data-list-month][hidden],
    [data-filter-empty][hidden],
    [data-event-detail][hidden],
    [data-selected-filter-empty][hidden] {
        display: none;
    }

    @media (max-width: 62.5rem) {
        .calendar-month-panel {
            grid-template-columns: 1fr;
        }

        .selected-event {
            min-height: auto;
        }

        .event-list-heading span:nth-child(4),
        .event-list-row > .event-list-row__meta:last-of-type {
            display: none;
        }

        .event-list-heading,
        .event-list-row {
            grid-template-columns: 5.9375rem minmax(0, 1.2fr) minmax(7rem, .55fr) 3.75rem;
        }
    }

    @media (max-width: 43.75rem) {
        .event-calendar {
            padding-right: 1.1875rem;
            padding-left: 1.1875rem;
        }

        .event-calendar__heading {
            grid-template-columns: 1fr;
        }

        .event-calendar__search {
            width: min(100%, 28rem);
        }

        .event-command {
            align-items: flex-start;
            flex-direction: column;
        }

        .event-command__tools {
            max-width: 100%;
            overflow-x: auto;
            padding-bottom: .15rem;
        }

        .event-command__month {
            min-width: 9rem;
        }

        .calendar-table {
            min-width: 36rem;
        }

        .calendar-table__weekday-full {
            display: none;
        }

        .calendar-table__weekday-short {
            display: inline;
        }

        .calendar-day {
            height: 4.5rem;
        }

        .calendar-day__event {
            height: .4rem;
            padding: 0;
            color: transparent;
        }

        .event-list-heading,
        .event-list-row > .event-list-row__meta {
            display: none;
        }

        .event-list-row {
            grid-template-columns: 5.3125rem minmax(0, 1fr) 3.4375rem;
            gap: .75rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        * {
            scroll-behavior: auto !important;
        }
    }
</style>

<script>
    const calendar = document.querySelector<HTMLElement>("[data-event-calendar]");

    if (calendar) {
        const viewButtons = Array.from(calendar.querySelectorAll<HTMLButtonElement>("[data-view-button]"));
        const viewPanels = Array.from(calendar.querySelectorAll<HTMLElement>("[data-view-panel]"));
        const monthPanels = Array.from(calendar.querySelectorAll<HTMLElement>("[data-month-panel]"));
        const monthLabel = calendar.querySelector<HTMLElement>("[data-current-month]");
        const previousMonth = calendar.querySelector<HTMLButtonElement>("[data-previous-month]");
        const nextMonth = calendar.querySelector<HTMLButtonElement>("[data-next-month]");
        const todayButton = calendar.querySelector<HTMLButtonElement>("[data-today]");
        const search = calendar.querySelector<HTMLInputElement>("[data-event-search-input]");
        const category = calendar.querySelector<HTMLSelectElement>("[data-event-category-select]");
        const status = calendar.querySelector<HTMLElement>("[data-calendar-status]");
        const emptyState = calendar.querySelector<HTMLElement>("[data-filter-empty]");
        let currentMonthIndex = 0;

        const updateUrl = (updates: Record<string, string | undefined>, push = true) => {
            const url = new URL(window.location.href);
            Object.entries(updates).forEach(([key, value]) => {
                if (value) url.searchParams.set(key, value);
                else url.searchParams.delete(key);
            });
            window.history[push ? "pushState" : "replaceState"]({}, "", url);
        };

        const setView = (view: "month" | "list", push = true) => {
            viewButtons.forEach((button) => {
                button.setAttribute("aria-pressed", String(button.dataset.viewButton === view));
            });
            viewPanels.forEach((panel) => {
                panel.hidden = panel.dataset.viewPanel !== view;
            });
            updateUrl({ view }, push);
            if (status) status.textContent = `${view === "month" ? "Month" : "List"} view selected.`;
        };

        const showMonth = (index: number, push = true) => {
            const boundedIndex = Math.max(0, Math.min(monthPanels.length - 1, index));
            currentMonthIndex = boundedIndex;
            monthPanels.forEach((panel, panelIndex) => panel.hidden = panelIndex !== boundedIndex);
            const currentPanel = monthPanels[boundedIndex];
            const currentKey = currentPanel?.dataset.monthPanel;
            const currentName = currentPanel?.querySelector("caption")?.textContent?.trim() ?? "Selected month";
            const previousName = monthPanels[boundedIndex - 1]?.querySelector("caption")?.textContent?.trim();
            const nextName = monthPanels[boundedIndex + 1]?.querySelector("caption")?.textContent?.trim();

            if (monthLabel) monthLabel.textContent = currentName;
            if (previousMonth) {
                previousMonth.disabled = boundedIndex === 0;
                previousMonth.setAttribute("aria-label", previousName ? `Show ${previousName}` : "No previous month available");
            }
            if (nextMonth) {
                nextMonth.disabled = boundedIndex === monthPanels.length - 1;
                nextMonth.setAttribute("aria-label", nextName ? `Show ${nextName}` : "No next month available");
            }
            calendar.querySelectorAll<HTMLElement>("[data-list-month]").forEach((listMonth) => {
                const hasVisibleRows = Array.from(listMonth.querySelectorAll<HTMLElement>("[data-event-filter-item]"))
                    .some((row) => !row.hidden);
                listMonth.hidden = listMonth.dataset.listMonth !== currentKey || !hasVisibleRows;
            });
            updateUrl({ month: currentKey }, push);
            if (status) status.textContent = `${currentName} shown.`;
        };

        const selectEvent = (eventId: string, push = true) => {
            const detail = document.getElementById(eventId);
            const monthPanel = detail?.closest<HTMLElement>("[data-month-panel]");
            if (!detail || !monthPanel) return;
            const monthIndex = monthPanels.indexOf(monthPanel);
            if (monthIndex >= 0) showMonth(monthIndex, false);

            monthPanel.querySelectorAll<HTMLElement>("[data-event-detail]").forEach((item) => {
                item.hidden = item.dataset.eventDetail !== eventId;
            });
            const filteredEmpty = monthPanel.querySelector<HTMLElement>("[data-selected-filter-empty]");
            if (filteredEmpty) filteredEmpty.hidden = true;
            monthPanel.querySelectorAll<HTMLButtonElement>("[data-calendar-date]").forEach((button) => {
                const selected = button.dataset.eventIds?.split(" ").includes(eventId) ?? false;
                button.setAttribute("aria-pressed", String(selected));
            });
            updateUrl({ event: eventId, month: monthPanel.dataset.monthPanel }, push);
        };

        const matchesFilters = (element: HTMLElement) => {
            const query = search?.value.trim().toLowerCase() ?? "";
            const selectedCategory = category?.value ?? "";
            return (!query || element.dataset.eventSearch?.includes(query))
                && (!selectedCategory || element.dataset.eventCategory === selectedCategory);
        };

        const applyFilters = () => {
            calendar.querySelectorAll<HTMLElement>("[data-event-filter-item]").forEach((item) => {
                item.hidden = !matchesFilters(item);
            });

            calendar.querySelectorAll<HTMLButtonElement>("[data-calendar-date]").forEach((button) => {
                const visibleEvents = Array.from(button.querySelectorAll<HTMLElement>("[data-event-filter-item]"))
                    .filter((item) => !item.hidden);
                button.disabled = visibleEvents.length === 0;
            });

            const currentMonthKey = monthPanels[currentMonthIndex]?.dataset.monthPanel;
            let visibleRows = 0;
            calendar.querySelectorAll<HTMLElement>("[data-list-month]").forEach((month) => {
                const rows = Array.from(month.querySelectorAll<HTMLElement>("[data-event-filter-item]"));
                const visible = rows.filter((row) => !row.hidden).length;
                const isCurrentMonth = month.dataset.listMonth === currentMonthKey;
                month.hidden = !isCurrentMonth || visible === 0;
                if (isCurrentMonth) visibleRows += visible;
            });
            if (emptyState) emptyState.hidden = visibleRows !== 0;

            const currentPanel = monthPanels[currentMonthIndex];
            const selectedDetail = currentPanel?.querySelector<HTMLElement>("[data-event-detail]:not([hidden])");
            const firstMatchingEvent = Array.from(currentPanel?.querySelectorAll<HTMLButtonElement>("[data-calendar-date]") ?? [])
                .filter((button) => !button.disabled)
                .flatMap((button) => Array.from(button.querySelectorAll<HTMLElement>("[data-event-filter-item]:not([hidden])")))
                .find((item) => item.dataset.eventId);
            const selectedEmpty = currentPanel?.querySelector<HTMLElement>("[data-selected-filter-empty]");

            if (firstMatchingEvent?.dataset.eventId) {
                if (!selectedDetail || !matchesFilters(selectedDetail)) {
                    selectEvent(firstMatchingEvent.dataset.eventId, false);
                }
                if (selectedEmpty) selectedEmpty.hidden = true;
            } else {
                currentPanel?.querySelectorAll<HTMLElement>("[data-event-detail]").forEach((detail) => detail.hidden = true);
                currentPanel?.querySelectorAll<HTMLButtonElement>("[data-calendar-date]").forEach((button) => {
                    button.setAttribute("aria-pressed", "false");
                });
                if (selectedEmpty) selectedEmpty.hidden = false;
            }
            if (status) status.textContent = `${visibleRows} matching ${visibleRows === 1 ? "event" : "events"}.`;
        };

        viewButtons.forEach((button) => button.addEventListener("click", () => {
            setView(button.dataset.viewButton === "list" ? "list" : "month");
        }));
        previousMonth?.addEventListener("click", () => {
            showMonth(currentMonthIndex - 1);
            applyFilters();
        });
        nextMonth?.addEventListener("click", () => {
            showMonth(currentMonthIndex + 1);
            applyFilters();
        });
        todayButton?.addEventListener("click", () => {
            showMonth(0);
            applyFilters();
        });
        search?.addEventListener("input", applyFilters);
        category?.addEventListener("change", applyFilters);
        calendar.querySelectorAll<HTMLButtonElement>("[data-calendar-date]").forEach((button) => {
            button.addEventListener("click", () => {
                const firstVisibleEvent = Array.from(button.querySelectorAll<HTMLElement>("[data-event-filter-item]"))
                    .find((item) => !item.hidden);
                if (firstVisibleEvent?.dataset.eventId) selectEvent(firstVisibleEvent.dataset.eventId);
            });
        });

        const restoreUrlState = () => {
            const url = new URL(window.location.href);
            const requestedView = url.searchParams.get("view");
            const defaultView = window.matchMedia("(max-width: 40rem)").matches ? "list" : "month";
            setView(requestedView === "list" || requestedView === "month" ? requestedView : defaultView, false);

            const requestedMonth = url.searchParams.get("month");
            const monthIndex = monthPanels.findIndex((panel) => panel.dataset.monthPanel === requestedMonth);
            showMonth(monthIndex >= 0 ? monthIndex : 0, false);

            const requestedEvent = url.searchParams.get("event");
            if (requestedEvent) selectEvent(requestedEvent, false);
            applyFilters();
        };

        window.addEventListener("popstate", restoreUrlState);
        restoreUrlState();
    }
</script>

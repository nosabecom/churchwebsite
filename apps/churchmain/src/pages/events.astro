---
import Layout from "../layouts/layout.astro";
import {
    calendarToday,
    churchEvents,
    eventDate,
    formatEventDate,
    formatEventTime,
    type ChurchEvent,
} from "../data/events";

const monthFormatter = new Intl.DateTimeFormat("en-CA", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
});

const weekdayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const firstPublishedMonth = new Date(Date.UTC(
    eventDate(calendarToday).getUTCFullYear(),
    eventDate(calendarToday).getUTCMonth(),
    1,
));

const dateKey = (date: Date) => [
    date.getUTCFullYear(),
    String(date.getUTCMonth() + 1).padStart(2, "0"),
    String(date.getUTCDate()).padStart(2, "0"),
].join("-");

const addMonths = (date: Date, amount: number) =>
    new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + amount, 1));

const eventTimeRange = (event: ChurchEvent) =>
    `${formatEventTime(event.startTime)}–${formatEventTime(event.endTime)}`;

const calendarMonths = Array.from({ length: 6 }, (_, index) => {
    const firstDay = addMonths(firstPublishedMonth, index);
    const monthKey = dateKey(firstDay).slice(0, 7);
    const leadingDays = firstDay.getUTCDay();
    const cells = Array.from({ length: 42 }, (__, cellIndex) => {
        const date = new Date(firstDay);
        date.setUTCDate(cellIndex - leadingDays + 1);
        const key = dateKey(date);

        return {
            date: key,
            day: date.getUTCDate(),
            inMonth: date.getUTCMonth() === firstDay.getUTCMonth(),
            isToday: key === calendarToday,
            events: date.getUTCMonth() === firstDay.getUTCMonth()
                ? churchEvents.filter((event) => event.date === key)
                : [],
        };
    });

    return {
        index,
        key: monthKey,
        label: monthFormatter.format(firstDay),
        cells,
        events: churchEvents.filter((event) => event.date.startsWith(monthKey)),
    };
});

const eventMonths = calendarMonths.filter((month) => month.events.length > 0);
const categories = [...new Set(churchEvents.map((event) => event.category))];
---

<Layout
    title="Church Calendar | RCCG Cornerstone Assembly"
    description="See upcoming services and gatherings at RCCG Cornerstone Assembly in Saskatoon."
>
    <section class="event-calendar" data-event-calendar data-initial-month={calendarMonths[0].key}>
        <header class="event-calendar__heading">
            <div>
                <p class="event-calendar__eyebrow">Calendar</p>
                <h1>Plan a visit</h1>
            </div>

            <label class="event-calendar__search">
                <span class="sr-only">Search events</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-4-4"></path>
                </svg>
                <input type="search" placeholder="Search events" data-event-search-input />
            </label>
        </header>

        <div class="event-command" aria-label="Calendar controls">
            <div class="event-view-switch" aria-label="Choose a calendar view">
                <button
                    type="button"
                    aria-pressed="true"
                    aria-controls="calendar-month-view"
                    data-view-button="month"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="17" rx="1"></rect>
                        <path d="M8 2v4M16 2v4M3 9h18M8 13h2M14 13h2M8 17h2M14 17h2"></path>
                    </svg>
                    Month
                </button>
                <button
                    type="button"
                    aria-pressed="false"
                    aria-controls="calendar-list-view"
                    data-view-button="list"
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M9 6h12M9 12h12M9 18h12"></path>
                        <circle cx="4" cy="6" r="1"></circle>
                        <circle cx="4" cy="12" r="1"></circle>
                        <circle cx="4" cy="18" r="1"></circle>
                    </svg>
                    List
                </button>
            </div>

            <div class="event-command__tools">
                <button
                    class="event-command__arrow"
                    type="button"
                    aria-label="Previous month"
                    data-previous-month
                    disabled
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                </button>

                <p class="event-command__month" data-current-month>{calendarMonths[0].label}</p>

                <button
                    class="event-command__arrow"
                    type="button"
                    aria-label={`Show ${calendarMonths[1].label}`}
                    data-next-month
                >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                </button>

                <label class="event-command__category">
                    <span class="sr-only">Filter by category</span>
                    <select data-event-category-select>
                        <option value="">All categories</option>
                        {categories.map((category) => <option value={category}>{category}</option>)}
                    </select>
                </label>
            </div>
        </div>

        <p class="sr-only" aria-live="polite" data-calendar-status></p>

        <div id="calendar-month-view" data-view-panel="month">
            {calendarMonths.map((month) => (
                <section
                    class="calendar-month-panel"
                    aria-labelledby={`month-${month.key}`}
                    data-month-panel={month.key}
                    hidden={month.index !== 0}
                >
                    <div class="calendar-table-scroll" tabindex="0" aria-label={`${month.label} calendar; scroll horizontally if needed`}>
                        <table class="calendar-table">
                            <caption class="sr-only" id={`month-${month.key}`}>{month.label}</caption>
                            <thead>
                                <tr>
                                    {weekdayNames.map((weekday) => (
                                        <th scope="col">
                                            <span class="calendar-table__weekday-full">{weekday}</span>
                                            <span class="calendar-table__weekday-short" aria-hidden="true">{weekday.slice(0, 3)}</span>
                                        </th>
                                    ))}
                                </tr>
                            </thead>
                            <tbody>
                                {Array.from({ length: 6 }, (_, weekIndex) => (
                                    <tr>
                                        {month.cells.slice(weekIndex * 7, weekIndex * 7 + 7).map((cell) => (
                                            <td class:list={{
                                                "calendar-day": true,
                                                "calendar-day--outside": !cell.inMonth,
                                                "calendar-day--today": cell.isToday,
                                            }}>
                                                {cell.events.length > 0 ? (
                                                    <button
                                                        type="button"
                                                        aria-label={`${formatEventDate(cell.date, { weekday: "long", month: "long", day: "numeric" })}, ${cell.events.length} ${cell.events.length === 1 ? "event" : "events"}`}
                                                        aria-current={cell.isToday ? "date" : undefined}
                                                        aria-pressed="false"
                                                        data-calendar-date
                                                        data-event-ids={cell.events.map((event) => event.id).join(" ")}
                                                    >
                                                        <span class="calendar-day__number">{cell.day}</span>
                                                        <span class="calendar-day__events">
                                                            {cell.events.map((event) => (
                                                                <span
                                                                    class:list={[
                                                                        "calendar-day__event",
                                                                        `calendar-day__event--${event.category.toLowerCase()}`,
                                                                    ]}
                                                                    data-event-filter-item
                                                                    data-event-id={event.id}
                                                                    data-event-category={event.category}
                                                                    data-event-search={`${event.title} ${event.location} ${event.description}`.toLowerCase()}
                                                                >
                                                                    {event.title}
                                                                </span>
                                                            ))}
                                                        </span>
                                                    </button>
                                                ) : (
                                                    <span
                                                        class="calendar-day__number"
                                                        aria-label={cell.inMonth ? formatEventDate(cell.date, { month: "long", day: "numeric" }) : undefined}
                                                        aria-hidden={!cell.inMonth ? "true" : undefined}
                                                    >{cell.day}</span>
                                                )}
                                            </td>
                                        ))}
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>

                    <aside class="selected-event" aria-label={`Selected event for ${month.label}`} data-selected-region>
                        {month.events.length > 0 ? month.events.map((event, eventIndex) => (
                            <article
                                id={event.id}
                                data-event-detail={event.id}
                                data-event-category={event.category}
                                data-event-search={`${event.title} ${event.location} ${event.description}`.toLowerCase()}
                                hidden={eventIndex !== 0}
                            >
                                <p class="selected-event__date">
                                    {formatEventDate(event.date, { weekday: "long", month: "long", day: "numeric" })}
                                </p>
                                <h2>{event.title}</h2>
                                <p class="selected-event__description">{event.description}</p>
                                <dl>
                                    <div>
                                        <dt>Time</dt>
                                        <dd>
                                            <time datetime={`${event.date}T${event.startTime}:00-06:00`}>
                                                {eventTimeRange(event)}
                                            </time>
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>Location</dt>
                                        <dd>{event.location}</dd>
                                    </div>
                                </dl>
                                <a href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1" target="_blank" rel="noreferrer">
                                    Get directions
                                    <span aria-hidden="true">↗</span>
                                </a>
                            </article>
                        )) : (
                            <div class="selected-event__empty">
                                <p class="selected-event__date">{month.label}</p>
                                <h2>No gatherings scheduled</h2>
                                <p>Choose another month or switch to the upcoming list.</p>
                            </div>
                        )}
                        {month.events.length > 0 && (
                            <div class="selected-event__empty" data-selected-filter-empty hidden>
                                <p class="selected-event__date">{month.label}</p>
                                <h2>No matching gatherings</h2>
                                <p>Try a different search or choose another category.</p>
                            </div>
                        )}
                    </aside>
                </section>
            ))}
        </div>

        <div id="calendar-list-view" class="event-list-view" data-view-panel="list" hidden>
            <div class="event-list-heading" aria-hidden="true">
                <span>Date</span>
                <span>Event</span>
                <span>Time</span>
                <span>Location</span>
                <span></span>
            </div>

            {eventMonths.map((month) => (
                <section class="event-list-month" data-list-month={month.key} hidden={month.key !== calendarMonths[0].key}>
                    <h2 class="sr-only">{month.label}</h2>
                    <ul>
                        {month.events.map((event) => (
                            <li
                                data-event-filter-item
                                data-event-category={event.category}
                                data-event-search={`${event.title} ${event.location} ${event.description}`.toLowerCase()}
                            >
                                <article class="event-list-row">
                                    <p class="event-list-row__date">
                                        <time datetime={event.date}>
                                            <span>{formatEventDate(event.date, { weekday: "short" })}</span>
                                            {formatEventDate(event.date, { month: "short", day: "2-digit" })}
                                        </time>
                                    </p>
                                    <div class="event-list-row__event">
                                        <h3>{event.title}</h3>
                                        <p>{event.description}</p>
                                    </div>
                                    <p class="event-list-row__meta">
                                        <span class="event-list-row__mobile-label">Time</span>
                                        <time datetime={`${event.date}T${event.startTime}:00-06:00`}>
                                            {eventTimeRange(event)}
                                        </time>
                                    </p>
                                    <p class="event-list-row__meta">
                                        <span class="event-list-row__mobile-label">Location</span>
                                        {event.location}
                                    </p>
                                    <a href={`/events?view=month&month=${event.date.slice(0, 7)}&event=${event.id}#${event.id}`}>
                                        View
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </article>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}

            <div class="event-empty-state" data-filter-empty hidden>
                <h2>No matching events</h2>
                <p>Try a different search or choose another category.</p>
            </div>
        </div>
    </section>
</Layout>

<style>
    .event-calendar {
        min-height: 70vh;
        padding: 2.75rem 4vw 3.875rem;
        background: #eef6fb;
        color: #0f172a;
    }

    .event-calendar__heading {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1.5rem;
        align-items: center;
    }

    .event-calendar__eyebrow,
    .selected-event__date {
        margin: 0;
        color: #dc2626;
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .event-calendar__heading h1 {
        margin: .5rem 0 0;
        color: #082f49;
        font-size: clamp(2.5rem, 4vw, 2.75rem);
        line-height: 1;
        letter-spacing: -.045em;
    }

    .event-calendar__search {
        display: flex;
        align-items: center;
        min-width: min(18rem, 100%);
        border: 1px solid #cbd5e1;
        border-radius: .5rem;
        background: white;
    }

    .event-calendar__search:focus-within {
        outline: 2px solid #dc2626;
        outline-offset: 2px;
    }

    .event-calendar__search svg {
        width: 1.25rem;
        margin-left: .9rem;
        fill: none;
        stroke: #64748b;
        stroke-width: 1.8;
    }

    .event-calendar__search input {
        width: 100%;
        min-height: 2.75rem;
        border: 0;
        padding: .7rem .85rem;
        color: #0f172a;
        font-size: .75rem;
        outline: 0;
    }

    .event-command {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        align-items: center;
        margin-top: 1.45rem;
        padding: .55rem;
        border: 1px solid #cbd5e1;
        border-radius: .8125rem;
        background: white;
        box-shadow: 0 10px 25px rgb(8 47 73 / 8%);
    }

    .event-view-switch,
    .event-command__tools {
        display: flex;
        align-items: center;
    }

    .event-view-switch {
        gap: .2rem;
        padding: .2rem;
        border-radius: .5625rem;
        background: #f1f5f9;
    }

    .event-command__tools {
        gap: .45rem;
    }

    .event-view-switch button {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        min-height: 2.5rem;
        border: 0;
        border-radius: .4375rem;
        background: transparent;
        padding: .625rem .875rem;
        color: #64748b;
        font-weight: 800;
        cursor: pointer;
    }

    .event-view-switch button[aria-pressed="true"] {
        background: #0c4a6e;
        box-shadow: 0 5px 14px rgb(12 74 110 / 21%);
        color: white;
    }

    .event-view-switch svg,
    .event-command__arrow svg {
        width: 1.2rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .event-command__arrow {
        min-width: 2.75rem;
        min-height: 2.75rem;
        border: 1px solid #cbd5e1;
        border-radius: .5rem;
        background: white;
        padding: .75rem;
        color: #0c4a6e;
        cursor: pointer;
    }

    .event-command__arrow:disabled {
        color: #cbd5e1;
        cursor: default;
    }

    .event-command__month {
        display: grid;
        min-width: 10rem;
        margin: 0;
        place-items: center;
        min-height: 2.75rem;
        border: 1px solid #cbd5e1;
        border-radius: .5rem;
        background: white;
        padding: .65rem 1rem;
        color: #082f49;
        font-weight: 800;
    }

    .event-command__category {
        border: 1px solid #cbd5e1;
        border-radius: .5rem;
        background: white;
    }

    .event-command__category select {
        min-height: 2.625rem;
        border: 0;
        border-radius: inherit;
        background: transparent;
        padding: .75rem 2.25rem .75rem 1rem;
        color: #334155;
        cursor: pointer;
    }

    .calendar-month-panel {
        display: grid;
        grid-template-columns: minmax(38.75rem, 1fr) 20rem;
        gap: .875rem;
        margin-top: .875rem;
    }

    .calendar-month-panel[hidden],
    [data-view-panel][hidden] {
        display: none;
    }

    .calendar-table-scroll {
        overflow-x: auto;
        border: 1px solid #cbd5e1;
        border-radius: .875rem;
        background: white;
        box-shadow: 0 10px 25px rgb(8 47 73 / 6%);
    }

    .calendar-table-scroll:focus-visible {
        outline: 2px solid #dc2626;
        outline-offset: 3px;
    }

    .calendar-table {
        width: 100%;
        min-width: 43rem;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .calendar-table th {
        border-right: 1px solid #cbd5e1;
        border-bottom: 1px solid #cbd5e1;
        padding: .75rem .65rem;
        color: #64748b;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-align: right;
        text-transform: uppercase;
    }

    .calendar-table th:last-child,
    .calendar-day:last-child {
        border-right: 0;
    }

    .calendar-table__weekday-short {
        display: none;
    }

    .calendar-day {
        height: 5.375rem;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        padding: 0;
        vertical-align: top;
    }

    .calendar-day > button {
        width: 100%;
        height: 100%;
        border: 0;
        background: white;
        padding: .55rem;
        color: #334155;
        text-align: left;
        cursor: pointer;
    }

    .calendar-day > button:hover,
    .calendar-day > button:focus-visible,
    .calendar-day > button[aria-pressed="true"] {
        background: #e0f2fe;
    }

    .calendar-day > button:focus-visible {
        position: relative;
        z-index: 1;
        outline: 2px solid #dc2626;
        outline-offset: -2px;
    }

    .calendar-day > button:disabled {
        background: white;
        color: #94a3b8;
        cursor: default;
    }

    .calendar-day__number {
        display: block;
        padding: .55rem;
        color: #334155;
        font-size: .8rem;
        font-weight: 700;
        text-align: right;
    }

    button .calendar-day__number {
        padding: 0;
    }

    .calendar-day--outside {
        background: #f8fafc;
    }

    .calendar-day--outside .calendar-day__number {
        color: #cbd5e1;
    }

    .calendar-day--today {
        box-shadow: inset 0 0 0 2px #0c4a6e;
    }

    .calendar-day__event {
        display: block;
        overflow: hidden;
        margin-top: .3rem;
        background: #0c4a6e;
        padding: .32rem .4rem;
        color: white;
        font-size: .65rem;
        font-weight: 700;
        line-height: 1.15;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .calendar-day__event--worship {
        background: #dc2626;
    }

    .calendar-day__event--community {
        background: #15803d;
    }

    .selected-event {
        min-height: 100%;
        overflow: hidden;
        border: 1px solid #cbd5e1;
        border-radius: .875rem;
        background: #082f49;
        padding: 1.45rem;
        color: white;
        box-shadow: 0 10px 25px rgb(8 47 73 / 6%);
    }

    .selected-event article,
    .selected-event__empty {
        width: 100%;
    }

    .selected-event .selected-event__date {
        color: #fca5a5;
        font-size: .6rem;
    }

    .selected-event h2 {
        margin: .625rem 0 .5rem;
        color: white;
        font-size: 1.5rem;
        line-height: 1.05;
        letter-spacing: -.035em;
    }

    .selected-event__description,
    .selected-event__empty p:last-child {
        margin: 0 0 .95rem;
        color: #bae6fd;
        font-size: .75rem;
        line-height: 1.6;
    }

    .selected-event dl {
        display: flex;
        flex-wrap: wrap;
        gap: .8rem;
        margin: 0 0 1.05rem;
    }

    .selected-event dl div {
        padding: 0;
        border: 0;
    }

    .selected-event dt {
        color: #7dd3fc;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .selected-event dd {
        margin: .25rem 0 0;
        font-size: .7rem;
    }

    .selected-event a {
        display: inline-flex;
        min-height: 2.75rem;
        align-items: center;
        gap: .5rem;
        color: white;
        font-size: .72rem;
        font-weight: 800;
        text-underline-offset: .25rem;
    }

    .selected-event a:hover,
    .selected-event a:focus-visible {
        text-decoration: underline;
    }

    .event-list-view {
        margin-top: .875rem;
        border-top: 2px solid #082f49;
        padding-top: .75rem;
    }

    .event-list-heading,
    .event-list-row {
        display: grid;
        grid-template-columns: 6.5625rem minmax(18rem, 1.2fr) minmax(8rem, .55fr) minmax(9rem, .75fr) 4.875rem;
        gap: 1.25rem;
    }

    .event-list-heading {
        padding: 0 0 .75rem;
        color: #64748b;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .event-list-month {
        border-top: 1px solid #cbd5e1;
    }

    .event-list-month > h2 {
        margin: 0;
    }

    .event-list-month ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .event-list-month li {
        border-bottom: 1px solid #cbd5e1;
    }

    .event-list-row {
        align-items: center;
        padding: 1.3rem 0;
    }

    .event-list-row__date {
        margin: 0;
        color: #0c4a6e;
        font-size: .9rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .event-list-row__date span {
        display: block;
        color: #dc2626;
        font-size: .68rem;
        letter-spacing: .08em;
    }

    .event-list-row__event h3 {
        margin: .25rem 0;
        color: #082f49;
        font-size: 1.15rem;
        line-height: 1.2;
    }

    .event-list-row__event > p:last-child {

---
import '../styles/global.css'
import { Image } from 'astro:assets'
import Analytics from '@vercel/analytics/astro'
import Logo from '../assets/logo.png'
import Wordmark from '../assets/cornerstone-logo-horizontal.png'

const year = new Date().getFullYear();

const services = [
    { title: "Sunday Service", day: "Every Sunday", time: "9:00 AM" },
    { title: "Mid-week Service", day: "Every Wednesday", time: "7:00 PM" },
    { title: "Power Night", day: "Last Friday of the month", time: "10:00 PM" },
];

// The "#" entries are pages that have not been built yet.
const explore = [
    { label: "Home", href: "/" },
    { label: "About Us", href: "#" },
    { label: "New to Church?", href: "#" },
    { label: "Events", href: "#" },
    { label: "Sermons", href: "#" },
    { label: "Contact Us", href: "/contact" },
];

const getInvolved = [
    { label: "Join the team", href: "/#join" },
    { label: "Send a prayer request", href: "/contact" },
    { label: "Ministries", href: "#" },
    { label: "Departments", href: "#" },
];

// One source of truth for the nav, so the desktop bar and the mobile drawer
// can never drift apart.
const ministries = [
    { label: "Men's", href: "#" },
    { label: "Women's", href: "#" },
    { label: "Children", href: "#" },
    { label: "Youths & Teenagers", href: "#" },
];

const departments = [
    { label: "Music", href: "#" },
    { label: "Prayer", href: "#" },
    { label: "Bible Study", href: "#" },
    { label: "Evangelism", href: "#" },
    { label: "Welfare", href: "#" },
    { label: "Multimedia", href: "#" },
    { label: "Sanctuary Helpers", href: "#" },
];

const primaryLinks = [
    { label: "New to Church?", href: "#" },
    { label: "Events", href: "#" },
    { label: "Sermons", href: "#" },
    { label: "Contact Us", href: "/contact" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
        <link rel="shortcut icon" href={Logo.src} type="image/png">
		<title>RCCG Cornerstone Assembly</title>
	</head>
	<body class="bg-sky-900 min-h-dvh flex flex-col">
        <Analytics />

        <!-- The bar shares `px-4` + `mx-auto max-w-400` with every page section,
             so the header, body and footer all sit on one gutter. -->
        <nav class="bg-white px-4 text-lg" aria-label="Main">
            <div class="mx-auto flex max-w-400 items-center justify-between gap-4 py-2.5">
                <a class="shrink-0" href="/"><Image class="w-18 h-auto" src={Logo} alt="RCCG Cornerstone Assembly — home" /></a>

                <ul class="hidden gap-6 lg:flex">
                    <li><a href="/">Home</a></li>
                    <li class="context-menu-trigger">
                        <button
                            class="flex cursor-pointer items-center gap-1"
                            type="button"
                            aria-expanded="false"
                            data-menu-trigger
                        >
                            Who We Are
                            <span class="text-sm" aria-hidden="true">▾</span>
                        </button>

                        <ul class="context-menu left-0 top-full z-10">
                            <li><a class="context-menu-item" href="#">About Us</a></li>
                            <li class="context-menu-trigger">
                                <button class="context-menu-item w-full cursor-pointer text-left" type="button" aria-expanded="false" data-menu-trigger>
                                    Ministries
                                </button>

                                <ul class="context-menu left-full -top-2 z-20">
                                    {ministries.map((item) => (
                                        <li><a class="context-menu-item whitespace-nowrap" href={item.href}>{item.label}</a></li>
                                    ))}
                                </ul>
                            </li>
                            <li class="context-menu-trigger">
                                <button class="context-menu-item w-full cursor-pointer text-left" type="button" aria-expanded="false" data-menu-trigger>
                                    Departments
                                </button>

                                <ul class="context-menu left-full -top-2 z-20 grid w-max grid-cols-2 gap-1 space-y-0">
                                    {departments.map((item) => (
                                        <li><a class="context-menu-item whitespace-nowrap" href={item.href}>{item.label}</a></li>
                                    ))}
                                </ul>
                            </li>
                        </ul>
                    </li>

                    {primaryLinks.map((link) => (
                        <li><a href={link.href}>{link.label}</a></li>
                    ))}
                </ul>

                <div class="flex shrink-0 items-center gap-1">
                    <a class="rounded-lg bg-red-600 px-4 py-2 text-white hover:bg-red-700" href="#">Give</a>

                    <button
                        class="grid size-11 cursor-pointer place-items-center rounded-lg text-sky-900 hover:bg-slate-100 lg:hidden"
                        type="button"
                        aria-label="Open menu"
                        aria-expanded="false"
                        aria-controls="mobile-nav"
                        data-nav-open
                    >
                        <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                            <path d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Off-canvas drawer, mirroring the pattern already proven on the
             Woman Excel site. Fixed and translated off-screen, so it never
             contributes to page width while closed. -->
        <div class="group lg:hidden" id="mobile-nav" data-nav>
            <div
                class="fixed inset-0 z-30 bg-sky-950/70 opacity-0 pointer-events-none transition-opacity duration-300 group-data-open:opacity-100 group-data-open:pointer-events-auto"
                data-nav-backdrop
            ></div>

            <div class="fixed top-0 right-0 z-40 flex h-dvh w-80 max-w-[85vw] translate-x-full flex-col overflow-y-auto bg-white p-6 transition-transform duration-300 ease-in-out group-data-open:translate-x-0">
                <button
                    class="grid size-11 shrink-0 cursor-pointer place-items-center self-end rounded-lg text-sky-900 hover:bg-slate-100"
                    type="button"
                    aria-label="Close menu"
                    data-nav-close
                >
                    <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </button>

                <ul class="mt-4 list-none space-y-1 p-0 text-lg text-sky-900">
                    <li><a class="block rounded-md py-2.5 hover:bg-slate-100" href="/">Home</a></li>

                    <li>
                        <details class="drawer-group">
                            <summary class="drawer-summary">Who We Are</summary>

                            <ul class="list-none space-y-1 p-0 pl-3">
                                <li><a class="block rounded-md py-2.5 hover:bg-slate-100" href="#">About Us</a></li>

                                <li>
                                    <details class="drawer-group">
                                        <summary class="drawer-summary">Ministries</summary>
                                        <ul class="list-none space-y-1 p-0 pl-3">
                                            {ministries.map((item) => (
                                                <li><a class="block rounded-md py-2.5 hover:bg-slate-100" href={item.href}>{item.label}</a></li>
                                            ))}
                                        </ul>
                                    </details>
                                </li>

                                <li>
                                    <details class="drawer-group">
                                        <summary class="drawer-summary">Departments</summary>
                                        <ul class="list-none space-y-1 p-0 pl-3">
                                            {departments.map((item) => (
                                                <li><a class="block rounded-md py-2.5 hover:bg-slate-100" href={item.href}>{item.label}</a></li>
                                            ))}
                                        </ul>
                                    </details>
                                </li>
                            </ul>
                        </details>
                    </li>

                    {primaryLinks.map((link) => (
                        <li><a class="block rounded-md py-2.5 hover:bg-slate-100" href={link.href}>{link.label}</a></li>
                    ))}
                </ul>
            </div>
        </div>

        <main class="flex-1">
            <slot/>
        </main>

        <footer class="bg-black px-4 text-white">
            <div class="mx-auto max-w-400">
                <div class="grid gap-10 py-12 md:grid-cols-2 lg:grid-cols-4">
                    <div>
                        <Image
                            class="h-auto w-full max-w-64"
                            src={Wordmark}
                            alt="RCCG Cornerstone Assembly"
                            widths={[256, 512]}
                            sizes="16rem"
                        />

                        <address class="mt-5 text-base leading-relaxed text-slate-300 not-italic">
                            70-3904 Millar Avenue<br />
                            Saskatoon, SK S7P 0B1
                        </address>

                        <a
                            class="mt-3 inline-block py-2 text-base text-slate-300 underline-offset-4 hover:text-white hover:underline"
                            href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1"
                            target="_blank"
                            rel="noreferrer"
                        >Find us on the map</a>
                    </div>

                    <div>
                        <h2 class="text-sm font-extrabold tracking-[0.16em] uppercase">Service Times</h2>

                        <ul class="mt-5 list-none space-y-4 p-0 text-base text-slate-300">
                            {services.map((service) => (
                                <li>
                                    <span class="block font-semibold text-white">{service.title}</span>
                                    {service.day}
                                    <span class="mx-1.5 text-slate-500" aria-hidden="true">•</span>
                                    {service.time}
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div>
                        <h2 class="text-sm font-extrabold tracking-[0.16em] uppercase">Explore</h2>

                        <ul class="mt-5 list-none space-y-1 p-0 text-base text-slate-300">
                            {explore.map((link) => (
                                <li>
                                    <a class="block py-2 underline-offset-4 hover:text-white hover:underline" href={link.href}>
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <div>
                        <h2 class="text-sm font-extrabold tracking-[0.16em] uppercase">Get Involved</h2>

                        <ul class="mt-5 list-none space-y-1 p-0 text-base text-slate-300">
                            {getInvolved.map((link) => (
                                <li>
                                    <a class="block py-2 underline-offset-4 hover:text-white hover:underline" href={link.href}>
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>

                        <a
                            class="mt-6 inline-block rounded-lg bg-red-600 px-4 py-2 text-white hover:bg-red-700"
                            href="#"
                        >Give</a>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-4 border-t border-white/15 py-6">
                    <div>
                        <p>© {year} RCCG Cornerstone Assembly</p>
                    </div>

                    <div class="flex gap-1">
                        <a class="grid size-11 place-items-center rounded-lg hover:bg-white/10" href="mailto:connect@rccgcornerstoneassembly.com" aria-label="Email connect@rccgcornerstoneassembly.com"><svg class="fill-white w-6" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <title>Email</title>
                            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/>
                        </svg></a>

                        <a class="grid size-11 place-items-center rounded-lg hover:bg-white/10" href="https://www.instagram.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer" aria-label="Instagram"><svg class="fill-white w-6" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <title>Instagram</title>
                            <path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/>
                        </svg></a>

                        <a class="grid size-11 place-items-center rounded-lg hover:bg-white/10" href="https://www.facebook.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer" aria-label="Facebook"><svg class="fill-white w-6" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <title>Facebook</title>
                            <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>
                        </svg></a>
                    </div>
                </div>
            </div>
        </footer>

        <script>
            // Off-canvas drawer.
            const drawer = document.querySelector<HTMLElement>("[data-nav]");
            const openBtn = document.querySelector<HTMLElement>("[data-nav-open]");

            if (drawer && openBtn) {
                const setOpen = (open: boolean) => {
                    drawer.toggleAttribute("data-open", open);
                    openBtn.setAttribute("aria-expanded", String(open));
                    document.body.classList.toggle("overflow-hidden", open);
                };

                openBtn.addEventListener("click", () => setOpen(true));
                drawer.querySelectorAll("[data-nav-close], [data-nav-backdrop], a").forEach((el) => {
                    el.addEventListener("click", () => setOpen(false));
                });
                document.addEventListener("keydown", (event) => {
                    if (event.key === "Escape") setOpen(false);
                });

                // The drawer is display:none from lg up; drop the open state too so
                // the scroll lock cannot outlive the panel.
                window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
                    if (event.matches) setOpen(false);
                });
            }

            // Desktop dropdowns. Hover alone is unreachable on a touchscreen, so the
            // triggers are buttons that toggle on click; :hover stays as an
            // enhancement for fine pointers only (see global.css).
            const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]"));

            const closeMenus = (except?: Element) => {
                triggers.forEach((trigger) => {
                    const parent = trigger.parentElement;
                    if (!parent || parent === except || parent.contains(except ?? null)) return;
                    parent.removeAttribute("data-open");
                    trigger.setAttribute("aria-expanded", "false");
                });
            };

            triggers.forEach((trigger) => {
                trigger.addEventListener("click", (event) => {
                    event.stopPropagation();
                    const parent = trigger.parentElement;
                    if (!parent) return;
                    const open = !parent.hasAttribute("data-open");
                    closeMenus(open ? parent : undefined);
                    parent.toggleAttribute("data-open", open);
                    trigger.setAttribute("aria-expanded", String(open));
                });
            });

            document.addEventListener("click", () => closeMenus());
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") closeMenus();
            });
        </script>
	</body>
</html>

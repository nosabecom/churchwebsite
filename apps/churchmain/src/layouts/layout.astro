---
import "../styles/global.css";
import { Image } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import { getLatestNewsletter, getNewsletterHref } from "../data/newsletters";
import Logo from "../assets/logo.png";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "RCCG Cornerstone Assembly | Saskatoon",
    description = "A vibrant church family in Saskatoon growing in purpose, power, and praise.",
} = Astro.props;

const year = new Date().getFullYear();
const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";

const navLinks = [
    { label: "New here", href: "/new-to-church" },
    { label: "Events", href: "/events" },
    { label: "Ministries", href: "/ministries" },
    { label: "Messages", href: "/messages" },
    { label: "Contact", href: "/contact" },
];

const ministries = [
    { label: "Women", href: "/ministries/women" },
    { label: "Men", href: "/ministries/men" },
    { label: "Youth & Teenagers", href: "/ministries/youths-teenagers" },
    { label: "Children", href: "/ministries/children" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#07182d" />
        <link rel="shortcut icon" href={Logo.src} type="image/png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=Newsreader:ital,opsz,wght@1,6..72,500;1,6..72,600&display=swap" rel="stylesheet" />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body class:list={["site-body", { "site-body--home": isHome }]}>
        <Analytics />
        <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>

        <header class:list={["site-header", { "site-header--home": isHome }]} data-site-header>
            <nav class="page-shell site-nav" aria-label="Main navigation">
                <a class="site-brand" href="/" aria-label="RCCG Cornerstone Assembly home">
                    <span class="site-brand__mark"><Image src={Logo} alt="" widths={[80, 120]} /></span>
                    <span class="site-brand__type">
                        <strong>Cornerstone</strong>
                        <small>RCCG · Saskatoon</small>
                    </span>
                </a>

                <ul class="site-nav__links">
                    {navLinks.map((link) => (
                        <li>
                            <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>

                <div class="site-nav__actions">
                    <a class="site-nav__give" href="#">Give</a>
                    <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-nav-open>
                        <span></span><span></span>
                    </button>
                </div>
            </nav>
        </header>

        <div class="mobile-nav" id="mobile-nav" aria-hidden="true" data-nav>
            <button class="mobile-nav__backdrop" type="button" aria-label="Close menu" data-nav-close></button>
            <div class="mobile-nav__panel">
                <div class="mobile-nav__top">
                    <span>Explore Cornerstone</span>
                    <button class="mobile-nav__close" type="button" aria-label="Close menu" data-nav-close>×</button>
                </div>
                <ul>
                    <li><a href="/">Home <span>01</span></a></li>
                    {navLinks.map((link, index) => (
                        <li><a href={link.href}>{link.label} <span>{String(index + 2).padStart(2, "0")}</span></a></li>
                    ))}
                </ul>
                <div class="mobile-nav__footer">
                    <p>Sunday · 9:00 AM</p>
                    <a href="/new-to-church">Plan a visit →</a>
                </div>
            </div>
        </div>

        <main class="site-main"><slot /></main>

        <footer class="site-footer">
            <div class="page-shell">
                <div class="site-footer__lead">
                    <a class="site-brand site-brand--footer" href="/">
                        <span class="site-brand__mark"><Image src={Logo} alt="" widths={[80, 120]} /></span>
                        <span class="site-brand__type"><strong>Cornerstone</strong><small>RCCG · Saskatoon</small></span>
                    </a>
                    <p>Come as you are.<br /><em>Leave with purpose.</em></p>
                </div>

                <div class="site-footer__grid">
                    <div>
                        <p class="site-footer__label">Meet with us</p>
                        <p>Sunday Service · 9:00 AM</p>
                        <p>Mid-week Service · Wed 7:00 PM</p>
                        <p>Power Night · Last Friday 10:00 PM</p>
                    </div>
                    <div>
                        <p class="site-footer__label">Find us</p>
                        <address>70–3904 Millar Avenue<br />Saskatoon, SK S7P 0B1</address>
                        <a href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1" target="_blank" rel="noreferrer">Open in Maps →</a>
                    </div>
                    <div>
                        <p class="site-footer__label">Ministries</p>
                        {ministries.map((item) => <a href={item.href}>{item.label}</a>)}
                    </div>
                    <div>
                        <p class="site-footer__label">Stay connected</p>
                        <a href={latestNewsletterHref}>Latest newsletter →</a>
                        <a href="mailto:connect@rccgcornerstoneassembly.com">Email us →</a>
                        <a href="https://www.instagram.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">Instagram →</a>
                        <a href="https://www.facebook.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">Facebook →</a>
                    </div>
                </div>

                <div class="site-footer__base">
                    <p>© {year} RCCG Cornerstone Assembly</p>
                    <p>Purpose · Power · Praise</p>
                </div>
            </div>
        </footer>

        <script>
            const drawer = document.querySelector<HTMLElement>("[data-nav]");
            const openButton = document.querySelector<HTMLButtonElement>("[data-nav-open]");

            const setDrawer = (open: boolean) => {
                if (!drawer || !openButton) return;
                drawer.toggleAttribute("data-open", open);
                drawer.setAttribute("aria-hidden", String(!open));
                openButton.setAttribute("aria-expanded", String(open));
                document.body.classList.toggle("nav-open", open);
            };

            openButton?.addEventListener("click", () => setDrawer(true));
            drawer?.querySelectorAll("[data-nav-close], a").forEach((element) => {
                element.addEventListener("click", () => setDrawer(false));
            });
            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") setDrawer(false);
            });

            const progress = document.querySelector<HTMLElement>("[data-scroll-progress]");
            const hero = document.querySelector<HTMLElement>("[data-hero]");
            let ticking = false;

            const syncScroll = () => {
                const maximum = document.documentElement.scrollHeight - window.innerHeight;
                if (progress) progress.style.transform = `scaleX(${maximum > 0 ? window.scrollY / maximum : 0})`;
                if (hero && window.scrollY < window.innerHeight) hero.style.setProperty("--hero-shift", `${window.scrollY * .12}px`);
                ticking = false;
            };

            window.addEventListener("scroll", () => {
                if (!ticking) {
                    requestAnimationFrame(syncScroll);
                    ticking = true;
                }
            }, { passive: true });
            syncScroll();

            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
            const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
            if (reducedMotion.matches || !("IntersectionObserver" in window)) {
                revealItems.forEach((item) => item.setAttribute("data-visible", ""));
            } else {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        entry.target.setAttribute("data-visible", "");
                        observer.unobserve(entry.target);
                    });
                }, { threshold: .14, rootMargin: "0px 0px -5%" });
                revealItems.forEach((item) => observer.observe(item));
            }
        </script>
    </body>
</html>

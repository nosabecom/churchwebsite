---
import "../styles/global.css";
import { Image } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import { getLatestNewsletter, getNewsletterHref } from "../data/newsletters";
import Logo from "../assets/logo.png";
import ArrowIcon from "../components/arrow-icon.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "RCCG Cornerstone Assembly | Saskatoon",
    description = "A warm church family for the whole of life. Join RCCG Cornerstone Assembly in Saskatoon on Sundays at 9:00 AM.",
} = Astro.props;

const year = new Date().getFullYear();
const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
    { label: "New here", href: "/new-to-church" },
    { label: "Events", href: "/events" },
    { label: "Ministries", href: "/ministries" },
    { label: "Messages", href: "/messages" },
    { label: "Contact", href: "/contact" },
];

const ministryLinks = [
    { label: "Women", href: "/ministries/women" },
    { label: "Men", href: "/ministries/men" },
    { label: "Youth & teenagers", href: "/ministries/youths-teenagers" },
    { label: "Children", href: "/ministries/children" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0d1b2a" />
        <link rel="shortcut icon" href={Logo.src} type="image/png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,SOFT,wght@0,9..144,50,400..700;1,9..144,80,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body class="site-body">
        <Analytics />
        <div class="scroll-progress" aria-hidden="true"></div>
        <a class="skip-link" href="#main-content">Skip to content</a>

        <header class="site-header" data-site-header>
            <nav class="site-nav" aria-label="Main navigation">
                <a class="site-brand" href="/" aria-label="RCCG Cornerstone Assembly home">
                    <span class="site-brand__mark">
                        <Image src={Logo} alt="" widths={[80, 120]} />
                    </span>
                    <span class="site-brand__type">
                        <strong>Cornerstone</strong>
                        <small>RCCG · Saskatoon</small>
                    </span>
                </a>

                <div class="site-nav__center">
                    <ul class="site-nav__links" data-nav-links>
                        <li class="site-nav__pill" aria-hidden="true" data-nav-pill></li>
                        {navLinks.map((link) => {
                            const isCurrent = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
                            return (
                                <li>
                                    <a href={link.href} aria-current={isCurrent ? "page" : undefined}>
                                        {link.label}
                                    </a>
                                </li>
                            );
                        })}
                    </ul>
                </div>

                <div class="site-nav__end">
                    <a
                        class="site-nav__give"
                        href="/give"
                        aria-current={currentPath === "/give" ? "page" : undefined}
                        data-magnetic
                    >
                        <span>Give</span>
                        <span class="site-nav__give-arrow"><ArrowIcon /></span>
                    </a>

                    <button
                        class="menu-button"
                        type="button"
                        aria-label="Open menu"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="mobile-nav"
                        data-nav-open
                        hidden
                    >
                        <span></span><span></span>
                    </button>
                </div>
            </nav>

            <noscript>
                <nav class="page-shell no-script-nav" aria-label="More navigation">
                    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                </nav>
            </noscript>
        </header>

        <dialog class="mobile-nav" id="mobile-nav" aria-labelledby="mobile-nav-heading">
            <div class="mobile-nav__inner">
                <div class="mobile-nav__top">
                    <h2 id="mobile-nav-heading">Explore Cornerstone</h2>
                    <button type="button" class="mobile-nav__close" aria-label="Close menu" data-nav-close>
                        ×
                    </button>
                </div>

                <nav aria-label="Mobile navigation">
                    <ul>
                        <li><a href="/"><span>Home</span><small>01</small></a></li>
                        {navLinks.map((link, index) => (
                            <li>
                                <a href={link.href}>
                                    <span>{link.label}</span>
                                    <small>{String(index + 2).padStart(2, "0")}</small>
                                </a>
                            </li>
                        ))}
                        <li><a href="/give"><span>Give</span><small>07</small></a></li>
                    </ul>
                </nav>

                <div class="mobile-nav__footer">
                    <div>
                        <span class="detail-label">Sunday Worship</span>
                        <p>Every Sunday · 9:00 AM</p>
                    </div>
                    <a class="btn btn--gold" href="/new-to-church">
                        <span>Plan your visit</span>
                        <span class="btn__icon"><ArrowIcon /></span>
                    </a>
                </div>
            </div>
        </dialog>

        <main class="site-main" id="main-content" tabindex="-1">
            <slot />
        </main>

        <footer class="site-footer">
            <div class="site-footer__glow" aria-hidden="true"></div>
            <div class="page-shell site-footer__inner">
                <div class="site-footer__lead" data-animate>
                    <div>
                        <p class="section-kicker section-kicker--light">This Sunday in Saskatoon</p>
                        <p class="site-footer__headline">
                            Come as you are.<br /><em>There’s a seat saved for you.</em>
                        </p>
                    </div>
                    <div class="site-footer__cta">
                        <a class="btn btn--gold" href="/new-to-church" data-magnetic>
                            <span>Plan your first Sunday</span>
                            <span class="btn__icon"><ArrowIcon /></span>
                        </a>
                        <a class="btn btn--glass" href="/contact" data-magnetic>
                            <span>Request prayer</span>
                            <span class="btn__icon"><ArrowIcon /></span>
                        </a>
                    </div>
                </div>

                <div class="site-footer__grid">
                    <div>
                        <p class="detail-label">Meet with us</p>
                        <p>Sunday Service · 9:00 AM</p>
                        <p>Wednesday Word · 7:00 PM</p>
                        <p>Power Night · Last Friday, 10:00 PM</p>
                        <a href="/events">Church calendar <ArrowIcon /></a>
                    </div>

                    <div>
                        <p class="detail-label">Find us</p>
                        <address>
                            70–3904 Millar Avenue<br />
                            Saskatoon, SK S7P 0B1
                        </address>
                        <a
                            href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1"
                            target="_blank"
                            rel="noreferrer"
                        >
                            Get directions <ArrowIcon />
                        </a>
                        <a href="/contact">Contact &amp; prayer <ArrowIcon /></a>
                    </div>

                    <div>
                        <p class="detail-label">Find your people</p>
                        {ministryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                        <a href="/departments">Serve with us <ArrowIcon /></a>
                    </div>

                    <div>
                        <p class="detail-label">Stay connected</p>
                        <a href={latestNewsletterHref}>Latest newsletter <ArrowIcon /></a>
                        <a href="/messages">Messages <ArrowIcon /></a>
                        <a href="https://www.instagram.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">
                            Instagram <ArrowIcon />
                        </a>
                        <a href="https://www.facebook.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">
                            Facebook <ArrowIcon />
                        </a>
                        <a href="/give">Give <ArrowIcon /></a>
                    </div>
                </div>

                <p class="site-footer__wordmark" aria-hidden="true" data-animate>
                    Cornerstone<span>.</span>
                </p>

                <div class="site-footer__base">
                    <p>© {year} RCCG Cornerstone Assembly · Saskatoon</p>
                    <p>People of purpose, power &amp; praise.</p>
                </div>
            </div>
        </footer>

        <script>
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
            const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
            const motionButton = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
            const motionLabel = motionButton?.querySelector<HTMLElement>("[data-motion-label]");
            let motionPaused = false;

            const isMotionDisabled = () => motionPaused || reducedMotion.matches;

            const syncMotion = () => {
                const disabled = isMotionDisabled();
                document.body.classList.toggle("motion-paused", disabled);
                if (motionButton) {
                    motionButton.hidden = reducedMotion.matches;
                    motionButton.setAttribute("aria-pressed", String(motionPaused));
                }
                if (motionLabel) {
                    motionLabel.textContent = motionPaused ? "Play motion" : "Pause motion";
                }
                if (disabled) {
                    document.getAnimations().forEach((anim) => anim.cancel());
                    document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
                        el.style.removeProperty("--py");
                    });
                }
            };

            if (motionButton) {
                motionButton.addEventListener("click", () => {
                    motionPaused = !motionPaused;
                    syncMotion();
                });
            }
            reducedMotion.addEventListener("change", syncMotion);
            syncMotion();

            // 1. Live Next Sunday countdown (Saskatoon / America/Regina)
            const countdownEl = document.querySelector<HTMLElement>("[data-next-sunday]");
            if (countdownEl) {
                try {
                    const now = new Date();
                    const parts = new Intl.DateTimeFormat("en-CA", {
                        timeZone: "America/Regina",
                        weekday: "short",
                        hour: "2-digit",
                        hour12: false,
                    }).formatToParts(now);
                    const weekdayMap: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
                    const dayStr = parts.find((p) => p.type === "weekday")?.value ?? "Sun";
                    const hourNum = Number(parts.find((p) => p.type === "hour")?.value ?? 12);
                    const day = weekdayMap[dayStr] ?? 0;

                    if (day === 0 && hourNum < 12) {
                        countdownEl.textContent = hourNum >= 9 ? "Worshiping live now · 9:00 AM" : "Today at 9:00 AM";
                    } else if (day === 6) {
                        countdownEl.textContent = "Tomorrow · Sunday 9:00 AM";
                    } else {
                        const daysUntil = day === 0 ? 7 : 7 - day;
                        countdownEl.textContent = `Sunday 9:00 AM · ${daysUntil} days away`;
                    }
                } catch {
                    countdownEl.textContent = "This Sunday at 9:00 AM";
                }
            }

            // 2. Scroll progress ribbon + header state + smooth parallax
            const header = document.querySelector<HTMLElement>("[data-site-header]");
            const parallaxEls = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
            let scrollRaf = 0;

            const updateOnScroll = () => {
                scrollRaf = 0;
                const y = window.scrollY;
                const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
                document.documentElement.style.setProperty("--scroll-progress", String(Math.min(1, y / maxScroll)));

                if (header) {
                    header.classList.toggle("is-scrolled", y > 28);
                }

                if (!isMotionDisabled() && parallaxEls.length > 0) {
                    const vh = window.innerHeight;
                    for (const el of parallaxEls) {
                        const speed = Number(el.dataset.parallax ?? 0);
                        const rect = el.getBoundingClientRect();
                        if (rect.bottom < -120 || rect.top > vh + 120) continue;
                        const progress = (rect.top + rect.height * 0.5 - vh * 0.5) / vh;
                        const shift = Math.max(-44, Math.min(44, progress * speed * 140));
                        el.style.setProperty("--py", `${shift.toFixed(1)}px`);
                    }
                }
            };

            const queueScroll = () => {
                if (!scrollRaf) scrollRaf = requestAnimationFrame(updateOnScroll);
            };
            window.addEventListener("scroll", queueScroll, { passive: true });
            window.addEventListener("resize", queueScroll, { passive: true });
            updateOnScroll();

            // 3. Choreographed Web Animations API scroll entrances (never leaves any element stuck invisible)
            const animatedEls = [...document.querySelectorAll<HTMLElement>("[data-animate]")];
            if (animatedEls.length > 0 && "IntersectionObserver" in window) {
                const animateObserver = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (!entry.isIntersecting) continue;
                            const target = entry.target as HTMLElement;
                            if (!isMotionDisabled() && typeof target.animate === "function") {
                                const delay = Number(target.dataset.delay ?? 0);
                                target.animate(
                                    [
                                        { opacity: 0.15, transform: "translate3d(0, 34px, 0) scale(0.985)" },
                                        { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)" },
                                    ],
                                    {
                                        duration: 850,
                                        delay,
                                        easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                                        fill: "backwards",
                                    },
                                );
                            }
                            animateObserver.unobserve(target);
                        }
                    },
                    { threshold: 0.08 },
                );
                for (const el of animatedEls) animateObserver.observe(el);
            }

            // Calligraphic SVG swoosh draw on entry
            const swooshes = [...document.querySelectorAll<SVGElement>("[data-swoosh]")];
            if (swooshes.length > 0 && "IntersectionObserver" in window) {
                const swooshObserver = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (!entry.isIntersecting) continue;
                            const path = entry.target.querySelector<SVGPathElement>("path");
                            if (path && !isMotionDisabled() && typeof path.animate === "function") {
                                path.animate(
                                    [
                                        { strokeDashoffset: 240 },
                                        { strokeDashoffset: 0 },
                                    ],
                                    {
                                        duration: 1200,
                                        delay: 220,
                                        easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                                        fill: "backwards",
                                    },
                                );
                            }
                            swooshObserver.unobserve(entry.target);
                        }
                    },
                    { threshold: 0.25 },
                );
                for (const svg of swooshes) swooshObserver.observe(svg);
            }

            // 4. Sliding navigation highlight pill
            const navList = document.querySelector<HTMLElement>("[data-nav-links]");
            const navPill = document.querySelector<HTMLElement>("[data-nav-pill]");
            if (navList && navPill) {
                const links = [...navList.querySelectorAll<HTMLAnchorElement>("a")];
                const activeLink = links.find((a) => a.getAttribute("aria-current") === "page");

                const placePill = (target: HTMLElement | undefined) => {
                    if (!target) {
                        navPill.style.opacity = "0";
                        return;
                    }
                    const listRect = navList.getBoundingClientRect();
                    const rect = target.getBoundingClientRect();
                    navPill.style.width = `${rect.width}px`;
                    navPill.style.transform = `translate3d(${rect.left - listRect.left}px, 0, 0)`;
                    navPill.style.opacity = "1";
                };

                if (activeLink) {
                    requestAnimationFrame(() => placePill(activeLink));
                }
                for (const link of links) {
                    link.addEventListener("mouseenter", () => placePill(link));
                    link.addEventListener("focus", () => placePill(link));
                }
                navList.addEventListener("mouseleave", () => placePill(activeLink));
                window.addEventListener("resize", () => placePill(activeLink), { passive: true });
            }

            // 5. Magnetic buttons, 3D perspective tilt, and cursor spotlights (fine pointer only)
            if (finePointer.matches) {
                document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
                    el.addEventListener("mousemove", (event) => {
                        if (isMotionDisabled()) return;
                        const rect = el.getBoundingClientRect();
                        const dx = (event.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
                        const dy = (event.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
                        el.style.setProperty("--mx-mag", `${(dx * 5).toFixed(1)}px`);
                        el.style.setProperty("--my-mag", `${(dy * 4).toFixed(1)}px`);
                    });
                    el.addEventListener("mouseleave", () => {
                        el.style.setProperty("--mx-mag", "0px");
                        el.style.setProperty("--my-mag", "0px");
                    });
                });

                document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
                    el.addEventListener("mousemove", (event) => {
                        if (isMotionDisabled()) return;
                        const rect = el.getBoundingClientRect();
                        const px = (event.clientX - rect.left) / rect.width;
                        const py = (event.clientY - rect.top) / rect.height;
                        const rx = (0.5 - py) * 7;
                        const ry = (px - 0.5) * 8;
                        el.style.setProperty("--rx", `${rx.toFixed(2)}deg`);
                        el.style.setProperty("--ry", `${ry.toFixed(2)}deg`);
                        el.style.setProperty("--gx", `${(px * 100).toFixed(1)}%`);
                        el.style.setProperty("--gy", `${(py * 100).toFixed(1)}%`);
                    });
                    el.addEventListener("mouseleave", () => {
                        el.style.setProperty("--rx", "0deg");
                        el.style.setProperty("--ry", "0deg");
                    });
                });

                document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((el) => {
                    el.addEventListener("mousemove", (event) => {
                        if (isMotionDisabled()) return;
                        const rect = el.getBoundingClientRect();
                        el.style.setProperty("--sx", `${(event.clientX - rect.left).toFixed(1)}px`);
                        el.style.setProperty("--sy", `${(event.clientY - rect.top).toFixed(1)}px`);
                    });
                });
            }

            // 6. Interactive Sunday Message Switcher
            const switcher = document.querySelector<HTMLElement>("[data-message-switcher]");
            if (switcher) {
                const tabs = [...switcher.querySelectorAll<HTMLButtonElement>("[data-msg-tab]")];
                const titleEl = switcher.querySelector<HTMLElement>("[data-msg-title]");
                const speakerEl = switcher.querySelector<HTMLElement>("[data-msg-speaker]");
                const seriesEl = switcher.querySelector<HTMLElement>("[data-msg-series]");
                const scriptureEl = switcher.querySelector<HTMLElement>("[data-msg-scripture]");
                const quoteEl = switcher.querySelector<HTMLElement>("[data-msg-quote]");
                const summaryEl = switcher.querySelector<HTMLElement>("[data-msg-summary]");
                const hrefEl = switcher.querySelector<HTMLAnchorElement>("[data-msg-href]");
                const ctaEl = switcher.querySelector<HTMLAnchorElement>("[data-msg-cta]");
                const stageCard = switcher.querySelector<HTMLElement>(".word-feature");

                tabs.forEach((tab) => {
                    tab.addEventListener("click", () => {
                        tabs.forEach((other) => {
                            const active = other === tab;
                            other.classList.toggle("is-active", active);
                            other.setAttribute("aria-selected", String(active));
                        });
                        if (stageCard && !isMotionDisabled()) {
                            stageCard.classList.remove("is-swapping");
                            void stageCard.offsetWidth;
                            stageCard.classList.add("is-swapping");
                        }
                        if (titleEl && tab.dataset.title) titleEl.textContent = tab.dataset.title;
                        if (speakerEl && tab.dataset.speaker) speakerEl.textContent = tab.dataset.speaker;
                        if (seriesEl && tab.dataset.series) seriesEl.textContent = tab.dataset.series;
                        if (scriptureEl && tab.dataset.scripture) scriptureEl.textContent = tab.dataset.scripture;
                        if (quoteEl && tab.dataset.quote) quoteEl.textContent = tab.dataset.quote;
                        if (summaryEl && tab.dataset.summary) summaryEl.textContent = tab.dataset.summary;
                        if (hrefEl && tab.dataset.href) {
                            hrefEl.href = tab.dataset.href;
                            hrefEl.setAttribute("aria-label", `Watch and read ${tab.dataset.title ?? "message"}`);
                        }
                        if (ctaEl && tab.dataset.href) ctaEl.href = tab.dataset.href;
                    });
                });
            }

            // 7. Interactive Ministry Row -> Community Collage emphasis
            const ministryList = document.querySelector<HTMLElement>("[data-ministry-list]");
            const collage = document.querySelector<HTMLElement>("[data-ministry-collage]");
            if (ministryList && collage) {
                ministryList.querySelectorAll<HTMLElement>("[data-focus-photo]").forEach((row) => {
                    const setFocus = () => {
                        collage.dataset.activePhoto = row.dataset.focusPhoto ?? "";
                    };
                    const clearFocus = () => {
                        delete collage.dataset.activePhoto;
                    };
                    row.addEventListener("mouseenter", setFocus);
                    row.addEventListener("focus", setFocus);
                    row.addEventListener("mouseleave", clearFocus);
                    row.addEventListener("blur", clearFocus);
                });
            }

            // 8. Accessible Mobile Navigation Drawer
            const drawer = document.querySelector<HTMLDialogElement>("#mobile-nav");
            const openButton = document.querySelector<HTMLButtonElement>("[data-nav-open]");
            if (drawer && openButton) {
                openButton.hidden = false;
                openButton.addEventListener("click", () => {
                    drawer.showModal();
                    openButton.setAttribute("aria-expanded", "true");
                    document.body.classList.add("nav-open");
                });
                drawer.querySelector("[data-nav-close]")?.addEventListener("click", () => drawer.close());
                drawer.addEventListener("keydown", (event) => {
                    if (event.key !== "Tab") return;
                    const focusable = drawer.querySelectorAll<HTMLElement>("a[href], button:not([disabled])");
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    if (event.shiftKey && document.activeElement === first) {
                        event.preventDefault();
                        last?.focus();
                    } else if (!event.shiftKey && document.activeElement === last) {
                        event.preventDefault();
                        first?.focus();
                    }
                });
                drawer.addEventListener("click", (event) => {
                    if (event.target === drawer) {
                        const rect = drawer.getBoundingClientRect();
                        if (
                            event.clientX < rect.left ||
                            event.clientX > rect.right ||
                            event.clientY < rect.top ||
                            event.clientY > rect.bottom
                        ) {
                            drawer.close();
                        }
                    }
                });
                drawer.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => drawer.close()));
                drawer.addEventListener("close", () => {
                    openButton.setAttribute("aria-expanded", "false");
                    document.body.classList.remove("nav-open");
                    openButton.focus();
                });
                window.matchMedia("(min-width: 68rem)").addEventListener("change", (event) => {
                    if (event.matches && drawer.open) drawer.close();
                });
            }
        </script>
    </body>
</html>

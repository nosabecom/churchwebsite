---
import "../styles/global.css";
import { Image } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import { getLatestNewsletter, getNewsletterHref } from "../data/newsletters";
import Logo from "../assets/logo.png";
import ArrowIcon from "../components/arrow-icon.astro";

interface Props {
    title?: string;
    description?: string;
    isHome?: boolean;
}

const {
    title = "RCCG Cornerstone Assembly | Saskatoon",
    description = "A vibrant, Spirit-filled church family in Saskatoon. Join RCCG Cornerstone Assembly Sundays at 9:00 AM.",
    isHome = false,
} = Astro.props;

const year = new Date().getFullYear();
const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
    { label: "I’m New", href: "/new-to-church" },
    { label: "Messages", href: "/messages" },
    { label: "Ministries", href: "/ministries" },
    { label: "Events", href: "/events" },
    { label: "Contact", href: "/contact" },
];

const ministryLinks = [
    { label: "Women", href: "/ministries/women" },
    { label: "Men", href: "/ministries/men" },
    { label: "Youth & Teenagers", href: "/ministries/youths-teenagers" },
    { label: "Children", href: "/ministries/children" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#090b10" />
        <link rel="shortcut icon" href={Logo.src} type="image/png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body class={`cs-body ${isHome ? "cs-body--home" : "cs-body--inner"}`}>
        <Analytics />
        <div class="cs-progress" aria-hidden="true"></div>
        <a class="cs-skip" href="#main-content">Skip to content</a>

        <header class={`cs-header ${isHome ? "cs-header--overlay" : "cs-header--solid"}`} data-site-header>
            <nav class="cs-shell cs-nav" aria-label="Main navigation">
                <a class="cs-brand" href="/" aria-label="RCCG Cornerstone Assembly home">
                    <span class="cs-brand__mark">
                        <Image src={Logo} alt="" widths={[72, 112]} />
                    </span>
                    <span class="cs-brand__text">
                        <strong>Cornerstone</strong>
                        <small>RCCG · Saskatoon</small>
                    </span>
                </a>

                <ul class="cs-nav__links">
                    {navLinks.map((link) => {
                        const isCurrent = currentPath === link.href || currentPath.startsWith(`${link.href}/`);
                        return (
                            <li>
                                <a href={link.href} aria-current={isCurrent ? "page" : undefined}>
                                    {link.label}
                                </a>
                            </li>
                        );
                    })}
                </ul>

                <div class="cs-nav__right">
                    <button
                        type="button"
                        class="cs-motion-btn"
                        aria-pressed="false"
                        title="Pause or play animations"
                        data-motion-toggle
                        hidden
                    >
                        <span class="cs-motion-btn__dot" aria-hidden="true"></span>
                        <span data-motion-label>Motion on</span>
                    </button>

                    <a
                        class="cs-nav__give"
                        href="/give"
                        aria-current={currentPath === "/give" ? "page" : undefined}
                        data-magnetic
                    >
                        <span>Give</span>
                        <ArrowIcon />
                    </a>

                    <button
                        class="cs-burger"
                        type="button"
                        aria-label="Open menu"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-controls="mobile-nav"
                        data-nav-open
                        hidden
                    >
                        <span></span><span></span>
                    </button>
                </div>
            </nav>

            <noscript>
                <nav class="cs-shell cs-noscript-nav" aria-label="Navigation">
                    {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                </nav>
            </noscript>
        </header>

        <dialog class="cs-drawer" id="mobile-nav" aria-labelledby="mobile-nav-heading">
            <div class="cs-drawer__wrap">
                <div class="cs-drawer__top">
                    <h2 id="mobile-nav-heading">RCCG Cornerstone Assembly</h2>
                    <button type="button" class="cs-drawer__close" aria-label="Close menu" data-nav-close>×</button>
                </div>

                <nav aria-label="Mobile navigation">
                    <ul>
                        <li><a href="/"><span>Home</span><small>01</small></a></li>
                        {navLinks.map((link, idx) => (
                            <li>
                                <a href={link.href}>
                                    <span>{link.label}</span>
                                    <small>{String(idx + 2).padStart(2, "0")}</small>
                                </a>
                            </li>
                        ))}
                        <li><a href="/give"><span>Give</span><small>07</small></a></li>
                    </ul>
                </nav>

                <div class="cs-drawer__foot">
                    <div>
                        <span class="cs-micro-tag cs-micro-tag--amber">Sundays at 9:00 AM</span>
                        <p>70–3904 Millar Avenue · Saskatoon</p>
                    </div>
                    <a class="cs-btn cs-btn--amber" href="/new-to-church">
                        <span>Plan Your Visit</span>
                        <span class="cs-btn__arrow"><ArrowIcon /></span>
                    </a>
                </div>
            </div>
        </dialog>

        <dialog class="cs-sermon-modal" id="sermon-modal" aria-labelledby="sermon-modal-title">
            <div class="cs-sermon-modal__box">
                <div class="cs-sermon-modal__top">
                    <div>
                        <p class="cs-sermon-modal__meta" data-modal-meta></p>
                        <h2 id="sermon-modal-title" data-modal-title>Sunday Message</h2>
                    </div>
                    <button type="button" class="cs-drawer__close" aria-label="Close video player" data-modal-close>×</button>
                </div>
                <div class="cs-sermon-modal__frame">
                    <iframe
                        data-modal-iframe
                        title="Cornerstone Assembly Sunday Message"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    ></iframe>
                </div>
                <div class="cs-sermon-modal__foot">
                    <a class="cs-btn cs-btn--amber" href="/messages" data-modal-link>
                        <span>Read Full Transcript &amp; Notes</span>
                        <span class="cs-btn__arrow"><ArrowIcon /></span>
                    </a>
                </div>
            </div>
        </dialog>

        <main class="cs-main" id="main-content" tabindex="-1">
            <slot />
        </main>

        <footer class="cs-footer">
            <section class="cs-finale" aria-labelledby="finale-heading">
                <div class="cs-finale__rings" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>
                <div class="cs-shell cs-finale__inner" data-animate>
                    <span class="cs-live-pill">
                        <span class="cs-live-pill__dot" aria-hidden="true"></span>
                        <span>This Sunday · 9:00 AM · Saskatoon</span>
                    </span>
                    <h2 id="finale-heading">
                        Your seat is already <em>waiting.</em>
                    </h2>
                    <p>
                        Bring your questions, your hopes, your family, and your whole self. We would love to welcome you home at Cornerstone.
                    </p>
                    <div class="cs-finale__actions">
                        <a class="cs-btn cs-btn--amber" href="/new-to-church" data-magnetic>
                            <span>Plan Your First Sunday</span>
                            <span class="cs-btn__arrow"><ArrowIcon /></span>
                        </a>
                        <a class="cs-btn cs-btn--glass" href="/contact" data-magnetic>
                            <span>Request Prayer</span>
                            <span class="cs-btn__arrow"><ArrowIcon /></span>
                        </a>
                        <a class="cs-btn cs-btn--glass" href="/give" data-magnetic>
                            <span>Give Online</span>
                            <span class="cs-btn__arrow"><ArrowIcon /></span>
                        </a>
                    </div>
                </div>
            </section>

            <div class="cs-shell cs-footer__cols">
                <div class="cs-footer__brand">
                    <a class="cs-brand" href="/">
                        <span class="cs-brand__mark">
                            <Image src={Logo} alt="" widths={[72, 112]} />
                        </span>
                        <span class="cs-brand__text">
                            <strong>Cornerstone</strong>
                            <small>RCCG · Saskatoon</small>
                        </span>
                    </a>
                    <p class="cs-footer__mission">
                        A parish of The Redeemed Christian Church of God in Saskatoon — raising people of purpose, power, and praise.
                    </p>
                    <address class="cs-footer__addr">
                        70–3904 Millar Avenue<br />Saskatoon, SK S7P 0B1
                    </address>
                </div>

                <div>
                    <p class="cs-footer__label">Gatherings</p>
                    <p class="cs-footer__info">Sunday Worship · 9:00 AM</p>
                    <p class="cs-footer__info">Wednesday Word · 7:00 PM</p>
                    <p class="cs-footer__info">Power Night · Last Friday, 10:00 PM</p>
                    <a href="/events">Full calendar <ArrowIcon /></a>
                </div>

                <div>
                    <p class="cs-footer__label">Ministries</p>
                    {ministryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
                    <a href="/departments">Serve on a team <ArrowIcon /></a>
                </div>

                <div>
                    <p class="cs-footer__label">Connect</p>
                    <a href="/messages">Sunday messages <ArrowIcon /></a>
                    <a href={latestNewsletterHref}>Latest newsletter <ArrowIcon /></a>
                    <a href="/contact">Contact &amp; prayer <ArrowIcon /></a>
                    <a href="https://www.instagram.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">Instagram <ArrowIcon /></a>
                    <a href="https://www.facebook.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">Facebook <ArrowIcon /></a>
                </div>
            </div>

            <div class="cs-shell cs-footer__bottom">
                <p>© {year} RCCG Cornerstone Assembly · Saskatoon, SK</p>
                <p>People of purpose, power &amp; praise.</p>
            </div>
        </footer>

        <script>
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
            const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
            const motionBtn = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
            const motionLabel = motionBtn?.querySelector<HTMLElement>("[data-motion-label]");
            let motionPaused = false;
            const isPaused = () => motionPaused || reducedMotion.matches;

            const syncMotion = () => {
                const disabled = isPaused();
                document.body.classList.toggle("motion-paused", disabled);
                if (motionBtn) {
                    motionBtn.hidden = reducedMotion.matches;
                    motionBtn.setAttribute("aria-pressed", String(motionPaused));
                }
                if (motionLabel) {
                    motionLabel.textContent = motionPaused ? "Motion off" : "Motion on";
                }
                if (disabled) {
                    document.getAnimations().forEach((a) => a.cancel());
                    document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => el.style.removeProperty("--py"));
                }
            };

            motionBtn?.addEventListener("click", () => {
                motionPaused = !motionPaused;
                syncMotion();
            });
            reducedMotion.addEventListener("change", syncMotion);
            syncMotion();

            // 1. Hero Canvas Golden Bokeh Light-Field
            const canvas = document.querySelector<HTMLCanvasElement>("[data-light-canvas]");
            if (canvas) {
                const ctx = canvas.getContext("2d");
                let w = 0;
                let h = 0;
                let inView = true;

                const resize = () => {
                    const rect = canvas.getBoundingClientRect();
                    const dpr = Math.min(window.devicePixelRatio || 1, 2);
                    w = rect.width;
                    h = rect.height;
                    canvas.width = Math.max(1, Math.floor(w * dpr));
                    canvas.height = Math.max(1, Math.floor(h * dpr));
                    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
                };

                const orbs = Array.from({ length: 28 }, (_, i) => ({
                    x: Math.random(),
                    y: Math.random(),
                    r: 1.5 + (i % 5) * 1.4,
                    vy: 0.00018 + (i % 4) * 0.00009,
                    vx: ((i % 3) - 1) * 0.00007,
                    hue: i % 4 === 0 ? "59, 130, 246" : "255, 184, 77",
                    alpha: 0.22 + (i % 5) * 0.1,
                }));

                if ("IntersectionObserver" in window) {
                    new IntersectionObserver((entries) => {
                        inView = entries[0]?.isIntersecting ?? true;
                    }).observe(canvas);
                }

                resize();
                window.addEventListener("resize", resize, { passive: true });

                const tick = () => {
                    if (ctx && inView && !isPaused()) {
                        ctx.clearRect(0, 0, w, h);
                        for (const o of orbs) {
                            o.y -= o.vy;
                            o.x += o.vx;
                            if (o.y < -0.05) {
                                o.y = 1.05;
                                o.x = Math.random();
                            }
                            if (o.x < -0.05) o.x = 1.05;
                            if (o.x > 1.05) o.x = -0.05;
                            const px = o.x * w;
                            const py = o.y * h;
                            const grad = ctx.createRadialGradient(px, py, 0, px, py, o.r * 4.5);
                            grad.addColorStop(0, `rgba(${o.hue}, ${o.alpha})`);
                            grad.addColorStop(1, `rgba(${o.hue}, 0)`);
                            ctx.fillStyle = grad;
                            ctx.beginPath();
                            ctx.arc(px, py, o.r * 4.5, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    }
                    requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
            }

            // 2. Hero Kinetic Vertical Word Cycler
            const cycler = document.querySelector<HTMLElement>("[data-word-cycler]");
            if (cycler) {
                const items = [...cycler.querySelectorAll<HTMLElement>(".cs-word-slot__item")];
                let current = 0;
                if (items.length > 1) {
                    window.setInterval(() => {
                        if (isPaused()) return;
                        const prev = items[current];
                        current = (current + 1) % items.length;
                        const next = items[current];
                        prev.classList.remove("is-active");
                        prev.classList.add("is-leaving");
                        next.classList.remove("is-leaving");
                        next.classList.add("is-active");
                        window.setTimeout(() => prev.classList.remove("is-leaving"), 650);
                    }, 2800);
                }
            }

            // 3. Live Second-by-Second Countdown to Sunday 9:00 AM (Saskatoon / America/Regina CST = UTC-6 year-round)
            const clockRoot = document.querySelector<HTMLElement>("[data-live-clock]");
            if (clockRoot) {
                const daysEl = clockRoot.querySelector<HTMLElement>("[data-clock-days]");
                const hoursEl = clockRoot.querySelector<HTMLElement>("[data-clock-hours]");
                const minsEl = clockRoot.querySelector<HTMLElement>("[data-clock-mins]");
                const secsEl = clockRoot.querySelector<HTMLElement>("[data-clock-secs]");

                const updateClock = () => {
                    const nowUtc = Date.now();
                    // Saskatchewan observes CST (UTC-6) year-round
                    const cstMs = nowUtc - 6 * 3600 * 1000;
                    const cst = new Date(cstMs);
                    const day = cst.getUTCDay();
                    let daysToSun = (7 - day) % 7;
                    if (day === 0 && (cst.getUTCHours() > 9 || (cst.getUTCHours() === 9 && cst.getUTCMinutes() > 0))) {
                        daysToSun = 7;
                    }
                    const targetCst = Date.UTC(
                        cst.getUTCFullYear(),
                        cst.getUTCMonth(),
                        cst.getUTCDate() + daysToSun,
                        9,
                        0,
                        0,
                    );
                    const diff = Math.max(0, Math.floor((targetCst - cstMs) / 1000));
                    const d = Math.floor(diff / 86400);
                    const h = Math.floor((diff % 86400) / 3600);
                    const m = Math.floor((diff % 3600) / 60);
                    const s = diff % 60;
                    if (daysEl) daysEl.textContent = String(d).padStart(2, "0");
                    if (hoursEl) hoursEl.textContent = String(h).padStart(2, "0");
                    if (minsEl) minsEl.textContent = String(m).padStart(2, "0");
                    if (secsEl) secsEl.textContent = String(s).padStart(2, "0");
                };
                updateClock();
                window.setInterval(updateClock, 1000);
            }

            // 4. Scroll Progress + Header Morph + Parallax + Scroll-Scrubbed Manifesto Words
            const header = document.querySelector<HTMLElement>("[data-site-header]");
            const parallaxEls = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
            const manifestoBox = document.querySelector<HTMLElement>("[data-scroll-words]");
            const scrubWords = manifestoBox ? [...manifestoBox.querySelectorAll<HTMLElement>(".cs-scrub-word")] : [];
            let rafId = 0;

            const onScrollFrame = () => {
                rafId = 0;
                const y = window.scrollY;
                const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
                document.documentElement.style.setProperty("--scroll", String(Math.min(1, y / max)));
                header?.classList.toggle("is-scrolled", y > 40);

                const vh = window.innerHeight;
                if (!isPaused()) {
                    for (const el of parallaxEls) {
                        const speed = Number(el.dataset.parallax ?? 0);
                        const rect = el.getBoundingClientRect();
                        if (rect.bottom < -120 || rect.top > vh + 120) continue;
                        const pct = (rect.top + rect.height * 0.5 - vh * 0.5) / vh;
                        const px = Math.max(-50, Math.min(50, pct * speed * 145));
                        el.style.setProperty("--py", `${px.toFixed(1)}px`);
                    }
                }

                if (manifestoBox && scrubWords.length > 0) {
                    const rect = manifestoBox.getBoundingClientRect();
                    const progress = isPaused()
                        ? 1
                        : Math.max(0.22, Math.min(1, (vh * 0.9 - rect.top) / (vh * 0.6)));
                    const litCount = Math.ceil(progress * scrubWords.length);
                    scrubWords.forEach((word, i) => {
                        if (i < litCount) word.classList.add("is-lit");
                    });
                }
            };

            const scheduleScroll = () => {
                if (!rafId) rafId = requestAnimationFrame(onScrollFrame);
            };
            window.addEventListener("scroll", scheduleScroll, { passive: true });
            window.addEventListener("resize", scheduleScroll, { passive: true });
            onScrollFrame();

            // 5. Choreographed WAAPI Scroll Entrances + Stat Counters + SVG Signature Draw
            if ("IntersectionObserver" in window) {
                const animObserver = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (!entry.isIntersecting) continue;
                            const el = entry.target as HTMLElement;
                            if (!isPaused() && typeof el.animate === "function") {
                                const delay = Number(el.dataset.delay ?? 0);
                                el.animate(
                                    [
                                        { opacity: 0.2, transform: "translate3d(0, 32px, 0) scale(0.98)" },
                                        { opacity: 1, transform: "translate3d(0, 0, 0) scale(1)" },
                                    ],
                                    { duration: 820, delay, easing: "cubic-bezier(0.16, 1, 0.3, 1)", fill: "backwards" },
                                );
                            }
                            animObserver.unobserve(el);
                        }
                    },
                    { threshold: 0.06 },
                );
                document.querySelectorAll<HTMLElement>("[data-animate]").forEach((el) => animObserver.observe(el));

                const countObserver = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (!entry.isIntersecting) continue;
                            const el = entry.target as HTMLElement;
                            const target = Number(el.dataset.countTo ?? 0);
                            if (!isPaused() && target > 0) {
                                const start = performance.now();
                                const step = (now: number) => {
                                    const t = Math.min(1, (now - start) / 900);
                                    const eased = 1 - Math.pow(1 - t, 3);
                                    el.textContent = String(Math.max(1, Math.round(eased * target)));
                                    if (t < 1) requestAnimationFrame(step);
                                };
                                requestAnimationFrame(step);
                            }
                            countObserver.unobserve(el);
                        }
                    },
                    { threshold: 0.3 },
                );
                document.querySelectorAll<HTMLElement>("[data-count-to]").forEach((el) => countObserver.observe(el));

                const swooshObserver = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (!entry.isIntersecting) continue;
                            const path = entry.target.querySelector<SVGPathElement>("path");
                            if (path && !isPaused() && typeof path.animate === "function") {
                                const len = path.getTotalLength();
                                path.style.strokeDasharray = `${len}`;
                                path.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], {
                                    duration: 1400,
                                    easing: "cubic-bezier(0.16, 1, 0.3, 1)",
                                    fill: "backwards",
                                });
                            }
                            swooshObserver.unobserve(entry.target);
                        }
                    },
                    { threshold: 0.25 },
                );
                document.querySelectorAll<SVGElement>("[data-swoosh]").forEach((svg) => swooshObserver.observe(svg));
            }

            // 6. Interactive First Visit Quick-Tabs
            const visitTabsRoot = document.querySelector<HTMLElement>("[data-visit-tabs]");
            if (visitTabsRoot) {
                const btns = [...visitTabsRoot.querySelectorAll<HTMLButtonElement>("[data-visit-tab]")];
                const panels = [...visitTabsRoot.querySelectorAll<HTMLElement>("[data-visit-panel]")];
                btns.forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const id = btn.dataset.visitTab;
                        btns.forEach((b) => {
                            const active = b === btn;
                            b.classList.toggle("is-active", active);
                            b.setAttribute("aria-selected", String(active));
                        });
                        panels.forEach((p) => {
                            const show = p.dataset.visitPanel === id;
                            p.hidden = !show;
                            p.classList.toggle("is-active", show);
                        });
                    });
                });
            }

            // 7. Interactive Sermon Series Filter
            const seriesFilter = document.querySelector<HTMLElement>("[data-series-filter]");
            const sermonGrid = document.querySelector<HTMLElement>("[data-sermon-grid]");
            if (seriesFilter && sermonGrid) {
                const btns = [...seriesFilter.querySelectorAll<HTMLButtonElement>("[data-series-btn]")];
                const cards = [...sermonGrid.querySelectorAll<HTMLElement>(".cs-sermon-card")];
                btns.forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const seriesName = btn.dataset.seriesBtn ?? "All";
                        btns.forEach((b) => {
                            const active = b === btn;
                            b.classList.toggle("is-active", active);
                            b.setAttribute("aria-selected", String(active));
                        });
                        cards.forEach((card) => {
                            const match = seriesName === "All" || card.dataset.series === seriesName;
                            card.hidden = !match;
                        });
                    });
                });
            }

            // 8. Expanding Ministry Flex-Accordion
            const accordion = document.querySelector<HTMLElement>("[data-ministry-accordion]");
            if (accordion) {
                const panels = [...accordion.querySelectorAll<HTMLElement>("[data-acc-panel]")];
                const activate = (target: HTMLElement) => {
                    panels.forEach((p) => p.classList.toggle("is-expanded", p === target));
                };
                panels.forEach((panel) => {
                    panel.addEventListener("mouseenter", () => activate(panel));
                    panel.addEventListener("focus", () => activate(panel));
                    panel.addEventListener("click", () => activate(panel));
                });
            }

            // 9. Interactive Event Category Filter
            const eventFilter = document.querySelector<HTMLElement>("[data-event-filter]");
            const eventList = document.querySelector<HTMLElement>("[data-event-list]");
            if (eventFilter && eventList) {
                const btns = [...eventFilter.querySelectorAll<HTMLButtonElement>("[data-event-cat]")];
                const rows = [...eventList.querySelectorAll<HTMLElement>(".cs-timeline-row")];
                btns.forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const cat = btn.dataset.eventCat ?? "All";
                        btns.forEach((b) => {
                            const active = b === btn;
                            b.classList.toggle("is-active", active);
                            b.setAttribute("aria-selected", String(active));
                        });
                        rows.forEach((row) => {
                            row.hidden = !(cat === "All" || row.dataset.cat === cat);
                        });
                    });
                });
            }

            // 10. In-Page Sermon Cinema Lightbox Modal
            const sermonModal = document.querySelector<HTMLDialogElement>("#sermon-modal");
            const modalIframe = sermonModal?.querySelector<HTMLIFrameElement>("[data-modal-iframe]");
            const modalTitle = sermonModal?.querySelector<HTMLElement>("[data-modal-title]");
            const modalMeta = sermonModal?.querySelector<HTMLElement>("[data-modal-meta]");
            const modalLink = sermonModal?.querySelector<HTMLAnchorElement>("[data-modal-link]");

            if (sermonModal && modalIframe) {
                document.querySelectorAll<HTMLButtonElement>("[data-open-sermon]").forEach((btn) => {
                    btn.addEventListener("click", () => {
                        const yt = btn.dataset.youtubeId;
                        if (!yt) return;
                        if (modalTitle) modalTitle.textContent = btn.dataset.sermonTitle ?? "Sunday Message";
                        if (modalMeta) modalMeta.textContent = btn.dataset.sermonMeta ?? "";
                        if (modalLink && btn.dataset.sermonHref) modalLink.href = btn.dataset.sermonHref;
                        modalIframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(yt)}?autoplay=1&rel=0`;
                        sermonModal.showModal();
                    });
                });
                const closeModal = () => {
                    modalIframe.src = "";
                    sermonModal.close();
                };
                sermonModal.querySelector("[data-modal-close]")?.addEventListener("click", closeModal);
                sermonModal.addEventListener("close", () => {
                    modalIframe.src = "";
                });
                sermonModal.addEventListener("click", (e) => {
                    if (e.target === sermonModal) closeModal();
                });
            }

            // 11. Magnetic Buttons, 3D Tilt & Cursor Spotlights
            if (finePointer.matches) {
                document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
                    el.addEventListener("mousemove", (e) => {
                        if (isPaused()) return;
                        const r = el.getBoundingClientRect();
                        const dx = ((e.clientX - (r.left + r.width / 2)) / (r.width / 2)) * 6;
                        const dy = ((e.clientY - (r.top + r.height / 2)) / (r.height / 2)) * 5;
                        el.style.setProperty("--mx-mag", `${dx.toFixed(1)}px`);
                        el.style.setProperty("--my-mag", `${dy.toFixed(1)}px`);
                    });
                    el.addEventListener("mouseleave", () => {
                        el.style.setProperty("--mx-mag", "0px");
                        el.style.setProperty("--my-mag", "0px");
                    });
                });

                document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
                    el.addEventListener("mousemove", (e) => {
                        if (isPaused()) return;
                        const r = el.getBoundingClientRect();
                        const px = (e.clientX - r.left) / r.width;
                        const py = (e.clientY - r.top) / r.height;
                        el.style.setProperty("--rx", `${((0.5 - py) * 6).toFixed(2)}deg`);
                        el.style.setProperty("--ry", `${((px - 0.5) * 7).toFixed(2)}deg`);
                    });
                    el.addEventListener("mouseleave", () => {
                        el.style.setProperty("--rx", "0deg");
                        el.style.setProperty("--ry", "0deg");
                    });
                });

                document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((el) => {
                    el.addEventListener("mousemove", (e) => {
                        if (isPaused()) return;
                        const r = el.getBoundingClientRect();
                        el.style.setProperty("--sx", `${(e.clientX - r.left).toFixed(1)}px`);
                        el.style.setProperty("--sy", `${(e.clientY - r.top).toFixed(1)}px`);
                    });
                });
            }

            // 12. Accessible Mobile Drawer
            const drawer = document.querySelector<HTMLDialogElement>("#mobile-nav");
            const openBtn = document.querySelector<HTMLButtonElement>("[data-nav-open]");
            if (drawer && openBtn) {
                openBtn.hidden = false;
                openBtn.addEventListener("click", () => {
                    drawer.showModal();
                    openBtn.setAttribute("aria-expanded", "true");
                    document.body.classList.add("nav-open");
                });
                drawer.querySelector("[data-nav-close]")?.addEventListener("click", () => drawer.close());
                drawer.addEventListener("click", (e) => {
                    if (e.target === drawer) drawer.close();
                });
                drawer.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => drawer.close()));
                drawer.addEventListener("close", () => {
                    openBtn.setAttribute("aria-expanded", "false");
                    document.body.classList.remove("nav-open");
                    openBtn.focus();
                });
                window.matchMedia("(min-width: 66rem)").addEventListener("change", (ev) => {
                    if (ev.matches && drawer.open) drawer.close();
                });
            }
        </script>
    </body>
</html>

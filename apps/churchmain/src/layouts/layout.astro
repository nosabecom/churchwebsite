---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { SiteNav, DesignMotion } from "@churchwebsite/ui";
import Logo from "../assets/logo.png";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "RCCG Cornerstone Assembly | A place to belong",
  description = "Building people of purpose, power, and praise. Join RCCG Cornerstone Assembly in Saskatoon every Sunday at 9:00 AM.",
} = Astro.props;
const links = [
  { label: "Our church", href: "/#our-church" },
  { label: "Community", href: "/ministries" },
  { label: "Messages", href: "/messages" },
  { label: "What’s on", href: "/events" },
];
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} /><meta
      name="description"
      content={description}
    />
    <title>{title}</title><link rel="icon" href={Logo.src} type="image/png" />
  </head>
  <body class:list={["cornerstone-site", { "interior-page": !isHome }]}>
    <a class="skip-link" href="#main-content">Skip to content</a><Analytics />
    <SiteNav
      name="cornerstone."
      subtitle="RCCG Assembly · Saskatoon"
      links={links}
      action={{ label: "Plan your visit", href: "/new-to-church" }}
    />
    <main id="main-content"><slot /></main>
    <footer class="c-footer">
      <div class="c-footer-invite">
        <p class="eyebrow">Your next chapter starts here.</p><a href="/new-to-church"
          >SEE YOU<br /><span>ON SUNDAY.</span><b aria-hidden="true"
            ><svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></b
          ></a>
      </div>
      <div class="c-footer-grid">
        <div>
          <a class="footer-brand" href="/">cornerstone.</a><p>
            People of purpose.<br />A life of faith. A place to belong.
          </p><p class="footer-affiliation">The Redeemed Christian Church of God</p>
        </div>
        <div>
          <h2>Come as you are</h2><address>
            70-3904 Millar Avenue<br />Saskatoon, SK S7P 0B1
          </address><a
            href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1"
            target="_blank"
            rel="noreferrer"
            >Get directions <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a>
        </div>
        <div>
          <h2>Life together</h2><a href="/ministries">Ministries</a><a href="/departments"
            >Join a team</a
          ><a href="/newsletters">Newsletters</a><a href="/contact">Contact & prayer</a>
        </div>
        <div>
          <h2>Stay connected</h2><a
            href="https://www.instagram.com/rccg.cornerstonesk/"
            target="_blank"
            rel="noreferrer"
            >Instagram <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a
          ><a href="https://www.facebook.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer"
            >Facebook <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a
          ><a href="mailto:connect@rccgcornerstoneassembly.com"
            >Email us <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
            ></a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} RCCG Cornerstone Assembly</span><span
          >Rooted in Christ. Growing in Saskatoon.</span
        ><a href="#main-content">Back to top ↑</a>
      </div>
    </footer>
    <DesignMotion />
  </body>
</html>

---
import "../styles/global.css";
import { Image } from "astro:assets";
import Analytics from "@vercel/analytics/astro";
import { getLatestNewsletter, getNewsletterHref } from "../data/newsletters";
import Logo from "../assets/logo.png";
import ArrowIcon from "../components/arrow-icon.astro";

interface Props { title?: string; description?: string; }

const {
    title = "RCCG Cornerstone Assembly | Saskatoon",
    description = "A church family for the whole of life. Join RCCG Cornerstone Assembly in Saskatoon on Sundays at 9:00 AM.",
} = Astro.props;
const year = new Date().getFullYear();
const latestNewsletterHref = getNewsletterHref(await getLatestNewsletter());
const currentPath = Astro.url.pathname;
const navLinks = [
    { label: "New here", href: "/new-to-church" },
    { label: "Events", href: "/events" },
    { label: "Ministries", href: "/ministries" },
    { label: "Messages", href: "/messages" },
    { label: "Contact", href: "/contact" },
];
const ministryLinks = [
    { label: "Women", href: "/ministries/women" },
    { label: "Men", href: "/ministries/men" },
    { label: "Youth & teenagers", href: "/ministries/youths-teenagers" },
    { label: "Children", href: "/ministries/children" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#f4f3ed" />
        <link rel="shortcut icon" href={Logo.src} type="image/png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body class="site-body">
        <Analytics />
        <a class="skip-link" href="#main-content">Skip to content</a>
        <header class="site-header">
            <nav class="page-shell site-nav" aria-label="Main navigation">
                <div class="site-nav__island">
                    <a class="site-brand" href="/" aria-label="RCCG Cornerstone Assembly home">
                        <span class="site-brand__mark"><Image src={Logo} alt="" widths={[80, 120]} /></span>
                        <span class="site-brand__type"><strong>Cornerstone</strong><small>RCCG · Saskatoon</small></span>
                    </a>
                    <ul class="site-nav__links">
                        {navLinks.map((link) => <li><a href={link.href} aria-current={currentPath.replace(/\/$/, "") === link.href ? "page" : undefined}>{link.label}</a></li>)}
                    </ul>
                    <button class="menu-button" type="button" aria-label="Open menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="mobile-nav" data-nav-open hidden>
                        <span></span><span></span>
                    </button>
                </div>
                <a class="site-nav__give" href="/give" aria-current={currentPath.replace(/\/$/, "") === "/give" ? "page" : undefined}>Give <span><ArrowIcon /></span></a>
            </nav>
            <noscript><nav class="page-shell no-script-nav" aria-label="More navigation">{navLinks.map(link => <a href={link.href}>{link.label}</a>)}</nav></noscript>
        </header>

        <dialog class="mobile-nav" id="mobile-nav" aria-labelledby="mobile-nav-heading">
            <div class="mobile-nav__top"><h2 id="mobile-nav-heading">Explore Cornerstone</h2><button type="button" class="mobile-nav__close" aria-label="Close menu" data-nav-close>×</button></div>
            <nav aria-label="Mobile navigation">
                <ul>
                    <li><a href="/">Home <span>01</span></a></li>
                    {navLinks.map((link, index) => (
                        <li><a href={link.href}>{link.label} <span>{String(index + 2).padStart(2, "0")}</span></a></li>
                    ))}
                    <li><a href="/give">Give <span>07</span></a></li>
                </ul>
            </nav>
            <div class="mobile-nav__footer"><p>Sunday · 9:00 AM</p><a class="text-link" href="/new-to-church">Plan your visit <span><ArrowIcon /></span></a></div>
        </dialog>

        <main class="site-main" id="main-content" tabindex="-1"><slot /></main>

        <footer class="site-footer">
            <div class="page-shell">
                <div class="site-footer__lead"><p>Come as you are.<br /><span>Bring your whole life.</span></p><a class="button button--yellow" href="/new-to-church">We’ll save you a seat <span><ArrowIcon /></span></a></div>
                <div class="site-footer__grid">
                    <div>
                        <p class="detail-label">Meet with us</p>
                        <p>Sunday · 9:00 AM</p><p>Wednesday · 7:00 PM</p><p>Power Night · Last Friday, 10:00 PM</p>
                        <a href="/events">Church calendar <ArrowIcon /></a>
                    </div>
                    <div>
                        <p class="detail-label">Find us</p>
                        <address>70–3904 Millar Avenue<br />Saskatoon, SK S7P 0B1</address>
                        <a href="https://www.google.com/maps/search/?api=1&query=70-3904+Millar+Avenue+Saskatoon+SK+S7P+0B1" target="_blank" rel="noreferrer">Get directions <ArrowIcon /></a>
                        <a href="/contact">Contact & prayer <ArrowIcon /></a>
                    </div>
                    <div>
                        <p class="detail-label">Find your people</p>
                        {ministryLinks.map(link => <a href={link.href}>{link.label}</a>)}
                        <a href="/departments">Serve with us <ArrowIcon /></a>
                    </div>
                    <div>
                        <p class="detail-label">Stay connected</p>
                        <a href={latestNewsletterHref}>Latest newsletter <ArrowIcon /></a>
                        <a href="/messages">Messages <ArrowIcon /></a>
                        <a href="https://www.instagram.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">Instagram <ArrowIcon /></a>
                        <a href="https://www.facebook.com/rccg.cornerstonesk/" target="_blank" rel="noreferrer">Facebook <ArrowIcon /></a>
                        <a href="/give">Give <ArrowIcon /></a>
                    </div>
                </div>
                <p class="site-footer__wordmark" aria-hidden="true">Cornerstone<span>.</span></p>
                <div class="site-footer__base"><p>© {year} RCCG Cornerstone Assembly</p><p>People of purpose, power & praise.</p></div>
            </div>
        </footer>

        <script>
            const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
            const motionButton = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
            let motionPaused = false;
            const syncMotion = () => {
                document.body.classList.toggle("motion-paused", motionPaused || motionPreference.matches);
                if (motionButton) motionButton.hidden = motionPreference.matches;
                if (motionPaused || motionPreference.matches) document.getAnimations().forEach(animation => animation.cancel());
            };
            if (motionButton) {
                motionButton.addEventListener("click", () => {
                    motionPaused = !motionPaused;
                    motionButton.setAttribute("aria-pressed", String(motionPaused));
                    motionButton.textContent = motionPaused ? "Play animation" : "Pause animation";
                    syncMotion();
                });
                motionPreference.addEventListener("change", syncMotion);
                syncMotion();
                const entranceObserver = new IntersectionObserver(entries => {
                    entries.forEach(entry => {
                        if (!entry.isIntersecting) return;
                        if (!motionPaused && !motionPreference.matches) {
                            entry.target.animate([
                                { transform: "translateY(12px)", opacity: .75 },
                                { transform: "translateY(0)", opacity: 1 },
                            ], { duration: 850, easing: "cubic-bezier(.2,.7,.2,1)" });
                        }
                        entranceObserver.unobserve(entry.target);
                    });
                }, { threshold: .12 });
                document.querySelectorAll(".welcome-copy, .pastors-composition, .section-header, .event-card, .community-photos, .ministries-copy, .stay-connected__inner").forEach(element => entranceObserver.observe(element));
            }
            const drawer = document.querySelector<HTMLDialogElement>("#mobile-nav");
            const openButton = document.querySelector<HTMLButtonElement>("[data-nav-open]");
            if (drawer && openButton) {
                openButton.hidden = false;
                openButton.addEventListener("click", () => {
                    drawer.showModal();
                    openButton.setAttribute("aria-expanded", "true");
                    document.body.classList.add("nav-open");
                });
                drawer.querySelector("[data-nav-close]")?.addEventListener("click", () => drawer.close());
                drawer.addEventListener("keydown", (event) => {
                    if (event.key !== "Tab") return;
                    const focusable = drawer.querySelectorAll<HTMLElement>("a[href], button:not([disabled])");
                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];
                    if (event.shiftKey && document.activeElement === first) {
                        event.preventDefault();
                        last?.focus();
                    } else if (!event.shiftKey && document.activeElement === last) {
                        event.preventDefault();
                        first?.focus();
                    }
                });
                drawer.addEventListener("click", (event) => {
                    if (event.target === drawer) {
                        const rect = drawer.getBoundingClientRect();
                        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) drawer.close();
                    }
                });
                drawer.querySelectorAll("a").forEach(link => link.addEventListener("click", () => drawer.close()));
                drawer.addEventListener("close", () => {
                    openButton.setAttribute("aria-expanded", "false");
                    document.body.classList.remove("nav-open");
                    openButton.focus();
                });
                window.matchMedia("(min-width: 70rem)").addEventListener("change", (event) => {
                    if (event.matches && drawer.open) drawer.close();
                });
            }
        </script>
    </body>
</html>

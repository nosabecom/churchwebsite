---
interface Props {
  name: string;
  subtitle: string;
  links: { label: string; href: string }[];
  action: { label: string; href: string };
}
const { name, subtitle, links, action } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) =>
  href !== "/" && !href.includes("#") && (path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${name} — home`}>
    <span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span><strong>{name}</strong><small>{subtitle}</small></span>
  </a>
  <nav class="desktop-links" aria-label="Main navigation">
    {
      links.map((link) => (
        <a href={link.href} aria-current={active(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <a class="nav-action" href={action.href}
    >{action.label}<span aria-hidden="true"
      ><svg
        class="arrow-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
      ></span
    ></a
  >
  <button
    class="menu-open"
    type="button"
    aria-label="Open menu"
    aria-controls="site-menu"
    aria-expanded="false">Menu <span aria-hidden="true">☰</span></button
  >
</header>
<dialog id="site-menu" class="site-menu" aria-label="Site navigation">
  <div class="menu-top">
    <span>{name}</span><button type="button" class="menu-close" aria-label="Close menu"
      >Close ×</button>
  </div>
  <nav aria-label="Mobile navigation">
    <a href="/"
      >Home <span
        ><svg
          class="arrow-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
        ></span
      ></a
    >
    {
      links.map((link) => (
        <a href={link.href} aria-current={active(link.href) ? "page" : undefined}>
          {link.label}
          <span>
            <svg
              class="arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M5 19 19 5M5 5h14v14" />
            </svg>
          </span>
        </a>
      ))
    }
    <a href={action.href}
      >{action.label}<span
        ><svg
          class="arrow-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"></path></svg
        ></span
      ></a
    >
  </nav>
  <p>{subtitle}</p>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>("#site-menu");
  const trigger = document.querySelector<HTMLButtonElement>(".menu-open");
  if (menu && trigger) {
    const close = () => menu.close();
    trigger.addEventListener("click", () => {
      menu.showModal();
      trigger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    });
    menu.querySelector(".menu-close")?.addEventListener("click", close);
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    menu.addEventListener("click", (event) => {
      if (event.target === menu) close();
    });
    menu.addEventListener("close", () => {
      trigger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      trigger.focus();
    });
    matchMedia("(min-width: 1000px)").addEventListener("change", (event) => {
      if (event.matches && menu.open) close();
    });
  }
</script>
<style>
  .site-header {
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 var(--gutter, 5vw);
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    position: relative;
    z-index: 20;
    font-family: var(--font-sans);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }
  .brand strong {
    display: block;
    font-size: 26px;
    letter-spacing: -1.2px;
    line-height: 1.1;
    font-weight: 700;
  }
  .brand small {
    display: block;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 7px;
  }
  .brand-symbol {
    display: grid;
    grid-template-columns: repeat(2, 15px);
    gap: 3px;
    transform: rotate(-5deg);
  }
  .brand-symbol i {
    width: 15px;
    height: 15px;
    background: var(--accent);
  }
  .brand-symbol i:nth-child(2) {
    border-radius: 0 15px 0 0;
  }
  .brand-symbol i:nth-child(3) {
    opacity: 0.45;
  }
  .desktop-links {
    display: flex;
    gap: 28px;
    font-size: 12px;
    font-weight: 500;
  }
  .desktop-links a {
    padding: 12px 0;
    text-decoration: none;
    position: relative;
  }
  .desktop-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 5px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s;
  }
  .desktop-links a:hover::after,
  .desktop-links a[aria-current]::after {
    transform: scaleX(1);
  }
  .nav-action {
    display: flex;
    align-items: center;
    gap: 34px;
    background: var(--ink);
    color: var(--paper);
    padding: 16px 21px;
    font-size: 12px;
    text-decoration: none;
  }
  .nav-action span {
    font-size: 21px;
    line-height: 1;
  }
  .nav-action:hover {
    background: var(--accent);
    color: var(--accent-text, var(--paper));
  }
  .menu-open {
    display: none;
    font-size: 13px;
    gap: 12px;
    align-items: center;
    cursor: pointer;
    padding: 12px 0;
  }
  .site-menu {
    border: 0;
    background: var(--paper);
    color: var(--ink);
    padding: 30px;
    width: min(520px, 100%);
    max-width: 100%;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    font-family: var(--font-sans);
  }
  .site-menu::backdrop {
    background: #14101899;
    backdrop-filter: blur(5px);
  }
  .menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 18px;
  }
  .menu-close {
    cursor: pointer;
    padding: 12px;
  }
  .site-menu nav {
    display: grid;
    margin: 35px 0;
  }
  .site-menu nav a {
    font-size: clamp(24px, 6vw, 36px);
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    text-decoration: none;
  }
  .site-menu p {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  @media (max-width: 1100px) {
    .desktop-links {
      gap: 18px;
    }
    .brand strong {
      font-size: 22px;
    }
  }
  @media (max-width: 999px) {
    .site-header {
      height: 84px;
    }
    .desktop-links,
    .nav-action {
      display: none;
    }
    .menu-open {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>

# Copy this file to .env.development at the repository root for local development.
# All local development commands read that one root file. Never commit the copied file.

# Shared Sanity project and development dataset.
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=development
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=development

# Needed only when the development dataset is private. This is server-only: never
# rename it with PUBLIC_ or SANITY_STUDIO_, because those prefixes expose values.
SANITY_API_READ_TOKEN=

# Church Main integrations.
# In Breeze, open the form's Share Form menu and copy its Form Address or iframe src URL.
PUBLIC_NEW_TO_CHURCH_FORM_URL=https://YOUR_SUBDOMAIN.breezechms.com/form/YOUR_FORM_SLUG

# Breeze event discovery. Both values are server-only and must never use a PUBLIC_ or
# SANITY_STUDIO_ prefix. The discovery command makes allowlisted GET requests only.
BREEZE_ACCOUNT_SUBDOMAIN=your-subdomain
BREEZE_API_KEY=

# Blueprint CLI connection. The configure helpers provide RCCG development defaults,
# but keeping these here also lets direct Blueprint commands evaluate the manifest.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=development
SANITY_BLUEPRINT_STACK_ID=

# Development Vercel hook URLs. This file's .env.development copy is ignored by Git.
# The configure helpers read these values and synchronize them to the hosted Function.
CHURCH_MAIN_VERCEL_DEPLOY_HOOK_URL=
WOMAN_EXCEL_VERCEL_DEPLOY_HOOK_URL=
